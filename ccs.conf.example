# ccs-bash config: /etc/ccs/ccs.conf, or a path given to ccs-back.sh. Bash sources it.
# Keep it root:ccs 640. Set each key once: a later line wins, even an empty one.

# monero-wallet-rpc running a view-only wallet, bound to localhost.
# User and password must not contain double quotes or backslashes.
RPC_URL=http://127.0.0.1:18082/json_rpc
# The wallet's main address. A run stops if the wallet has a different one, so a swapped
# wallet is caught. ccs-bash refuses to run if it can write this file.
WALLET_ADDRESS=4...
RPC_USER=ccs
RPC_PASSWORD=change-me

# API endpoint of the proposals repository, GitLab or Forgejo/Gitea (public, no token):
#   GitLab:  https://<host>/api/v4/projects/<id>
#   Forgejo: https://<host>/api/v1/repos/<owner>/<repo>   (git.disroot.org, codeberg.org...)
REPOSITORY_URL=https://repo.getmonero.org/api/v4/projects/54

# Checkout of the proposals repository (pulled by the compose's pull stage).
PROPOSALS_DIR=/var/lib/ccs/proposals

# Where the address mapping (proposals.csv) is kept. Back this up.
STATE_DIR=/var/lib/ccs/state

# Where proposals.json, completed-proposals.json and projects.json are written.
OUTPUT_DIR=/var/lib/ccs/out

# Confirmations before a donation is counted. 0 also counts txes in the pool.
MIN_CONFIRMATIONS=10

# Stop a run that takes longer than this many seconds, and free its lock. For a forge or
# wallet that never answers. Optional, default 900.
#RUN_SECONDS=900

# Ideas: look at most at this many open MRs each run, the most recently updated.
# Anyone can open MRs. Optional, default 100.
#IDEAS_MAX=100

# Only use MRs to this branch, for the ideas and the merged-MR links. Optional.
# Needed when other branches of the repository take other MRs, as on a test instance.
#TARGET_BRANCH=master

# Mirror mode: run beside another CCS on the same wallet (ccs.getmonero.org's) to compare them.
# Each proposal's address comes from that site's /projects, matched by title and author.
# The mirror never hands out a subaddress of its own. A proposal whose address belongs to an
# earlier wallet shows that site's raised amount and contributions. Optional.
#MIRROR_URL=https://ccs.getmonero.org/projects/
