#!/usr/bin/env bash
# ccs-push DATA STATE SSH_ARG...: send site-data.json (DATA) to the web server's gate.
# See docs/two-machines.md. It runs `ssh SSH_ARG... receive < site-data.json`.
# The last SSH_ARG is the push account (ccs-data@<web server>).
# The gate (ccs-check receive) checks the data and builds the site from it. It exits 0, or 1 if
# it refused or held something back. It prints "took <sha256>" when the file it got is now live.
#
# STATE/accepted holds the sum of the last file the gate said it took. Exit 0 alone is not
# enough: a gate that answers 0 without taking the file fails the push, so the run shows it.
# An unchanged file is not sent again; the push then sends nothing, which still works as the
# heartbeat. Once a day the file is sent anyway (STATE/full), to repair anything the gate lost.
#
# Exits with ssh's status (255 if it couldn't connect). Needs bash, sha256sum and ssh.
set -euo pipefail
export LC_ALL=C
data=${1:?DATA} state=${2:?STATE}
shift 2
(($#)) || { echo "ccs-push: no ssh destination" >&2; exit 2; }
mkdir -p "$state"
sum=$(sha256sum < "$data" | cut -d' ' -f1)
full=''
[[ $(find "$state/full" -mmin -1440 2> /dev/null) ]] || full=1
send=/dev/null
if [[ $full || $sum != "$(cat "$state/accepted" 2> /dev/null)" ]]; then
    send=$data
    echo "ccs-push: sending site-data.json${full:+ (once a day)}" >&2
fi
rc=0
out=$(ssh "$@" receive < "$send") || rc=$?
if ((rc == 0)) && [[ $send == "$data" ]] && ! grep -qx "took $sum" <<<"$out"; then
    echo "ccs-push: the web server answered 0 but didn't say it took this site-data.json: sent again next run" >&2
    rc=1
fi
if ((rc == 0)); then
    printf '%s\n' "$sum" > "$state/accepted"
    [[ ! $full ]] || touch "$state/full"
fi
exit "$rc"
