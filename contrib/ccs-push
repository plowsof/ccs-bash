#!/usr/bin/env bash
# ccs-push SITE PUSHED STATE SSH_ARG...: the site to the web server's gate (docs/two-machines.md),
# only the files that changed, as a tar on ssh's stdin: `ssh SSH_ARG... receive < tar`, the last
# SSH_ARG the push account (ccs-data@<web server>). The gate reads the tar with Go (ccs-check
# receive: plain files and folders only), checks each file and answers on stdout which it held
# back ("held<TAB>file<TAB>why"); it exits 0, 7 (some held back, the rest live) or 1 (refused).
#   - STATE/accepted: the sums of what the gate took ("<sha256>  ./<path>", sha256sum's), written
#     after each push that went through, the files it held back left out: they go again next
#     time. A file whose sum is in it isn't sent. None, or STATE/full older than a day: every file
#     (a day at most to mend whatever the gate has that this doesn't know).
#   - PUSHED: ccs-watch's copy of what was pushed (its compare), made SITE's after a push that
#     went through (7 too), under the caller's lock on ccs-watch.
#   - a name with a backslash or a control character isn't sent (the gate refuses a push with
#     one), and is said.
# Exits as the push did (ssh's: 255 when it couldn't connect). Needs bash, find, sha256sum, sort,
# awk, tar (busybox's or GNU), cp, mkdir, rm, and ssh.
set -euo pipefail
export LC_ALL=C
site=${1:?SITE} pushed=${2:?PUSHED} state=${3:?STATE}
shift 3
(($#)) || { echo "ccs-push: no ssh destination" >&2; exit 2; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$state" "$pushed"

# the site's files and their sums, sorted by name: no name with \ or a control character (GNU
# sha256sum would escape it; the gate refuses it)
(cd "$site" && find . -type f -name '*[\\[:cntrl:]]*' -print) | while IFS= read -r f; do
    echo "ccs-push: not sent (a backslash or control character in its name): ${f:2:80}" >&2
done
(cd "$site" && find . -type f ! -name '*[\\[:cntrl:]]*' -print0 | xargs -0 -r sha256sum) | sort -k 2 > "$tmp/now"

# what to send: every file once a day (or with no record of what the gate took), else the
# files whose sums the gate hasn't taken
full=''
if [[ ! -s $state/accepted || -z $(find "$state/full" -mmin -1440 2> /dev/null) ]]; then full=1; : > "$tmp/accepted"; else cp "$state/accepted" "$tmp/accepted"; fi
awk 'FILENAME == ARGV[1] { took[$0] = 1; next } !($0 in took) { print substr($0, 67) }' "$tmp/accepted" "$tmp/now" > "$tmp/send"

# the tar: the files only (the gate makes their folders), names as "./path"; none (nothing
# changed: the push is still the heartbeat), an empty tar
if [[ -s $tmp/send ]]; then
    (cd "$site" && tar -c -f - -T "$tmp/send") > "$tmp/push.tar"
else
    head -c 1024 /dev/zero > "$tmp/push.tar"
fi
echo "ccs-push: sending $(wc -l < "$tmp/send") of $(wc -l < "$tmp/now") files${full:+ (all of them: once a day)}" >&2

rc=0
ssh "$@" receive < "$tmp/push.tar" > "$tmp/answer" || rc=$?
grep -E '^held	' "$tmp/answer" | cut -f2- | sed 's/	/: /; s/^/ccs-push: held back by the web server: /' >&2 || true
if ((rc == 0 || rc == 7)); then
    # what the gate took: every sum now, but the files it held back
    awk -F '\t' 'FILENAME == ARGV[1] { if ($1 == "held") held["./" $2] = 1; next } !(substr($0, 67) in held)' "$tmp/answer" "$tmp/now" > "$state/accepted.new"
    mv -f "$state/accepted.new" "$state/accepted"
    [[ ! $full ]] || touch "$state/full"
    # ccs-watch's copy: the files sent copied in, the ones SITE no longer has taken out
    while IFS= read -r f; do
        mkdir -p "$pushed/$(dirname "$f")" && cp -p "$site/$f" "$pushed/$f"
    done < "$tmp/send"
    (cd "$pushed" && find . -type f -print) | awk 'FILENAME == ARGV[1] { has[substr($0, 67)] = 1; next } !($0 in has)' "$tmp/now" - | while IFS= read -r f; do
        rm -f -- "$pushed/$f"
    done
    find "$pushed" -mindepth 1 -type d -empty -delete 2> /dev/null || true
fi
exit "$rc"
