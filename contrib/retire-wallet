#!/usr/bin/env bash
# retire-wallet NAME CONFIG [RPC_URL]: record a wallet the CCS no longer uses, so its donations
# keep counting (docs/handover.md, "Retiring a wallet"). Run as ccs, the state's owner, with the
# update loop paused:
#   runuser -u ccs -- /opt/ccs-bash/contrib/retire-wallet ccs2 /etc/ccs/ccs.conf
# The wallet is the one CONFIG's RPC_URL reaches (the live one, when it is the one being retired),
# or RPC_URL: an old wallet's view-only copy, synced (RETIRE_RPC_USER, RETIRE_RPC_PASSWORD for its
# login, if it has one). It asks that wallet which of the state's addresses are its own, then:
#   - writes STATE_DIR/retired/NAME.csv: every deposit to those subaddresses, by proposal file, no
#     addresses (lib/wallet.sh, retired_totals, reads it each run);
#   - clears those proposals' index and address in proposals.csv (the old file kept beside it), so
#     the next wallet gives a funding-required one a new subaddress, and none is handed out twice;
#   - retiring the live wallet: moves deposits.csv (its cache) aside.
# Nothing else changes: a wallet, its config and its signed list are switched by hand, after.
set -euo pipefail
export LC_ALL=C
CCS_LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=lib/common.sh
source "$CCS_LIB/common.sh"
# shellcheck source=lib/wallet.sh
source "$CCS_LIB/wallet.sh"
# shellcheck source=lib/proposals.sh
source "$CCS_LIB/proposals.sh"

retire_main() {
local name=${1:?NAME (a-z, 0-9, -)} config=${2:?CONFIG} url=${3:-}
local live_url out main height live n dup indexes deposits total
[[ $name =~ ^[a-z0-9-]+$ ]] || die "NAME: a-z, 0-9 and - only"
load_config "$config"
live_url=$RPC_URL
# (RPC_USER and RPC_PASSWORD are what lib/wallet.sh's rpc uses)
# shellcheck disable=SC2034
if [[ -n $url ]]; then RPC_URL=$url RPC_USER=${RETIRE_RPC_USER:-} RPC_PASSWORD=${RETIRE_RPC_PASSWORD:-}; fi
out=$STATE_DIR/retired/$name.csv
[[ ! -e $out ]] || die "$out exists: a wallet is retired once (another name for another wallet)"
exec 9> "$STATE_DIR/lock"
flock -n 9 || die "a run is going: pause the update loop first (systemctl stop ccs-bash)"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
load_state

main=$(rpc get_address '{"account_index": 0}' | jq -r .address) || die "the wallet doesn't answer at $RPC_URL"
height=$(rpc get_height | jq -r .height) || die "the wallet doesn't answer at $RPC_URL"
[[ $main =~ ^[0-9A-Za-z]{95}$ && $height =~ ^[0-9]+$ ]] || die "unexpected answer from the wallet: '$main' '$height'"
live=''; [[ $main == "$WALLET_ADDRESS" && $RPC_URL == "$live_url" ]] && live=1
log "wallet ${main:0:6}…${main: -4} at height $height${live:+ (the live wallet)}"

# which state rows are this wallet's: it says so for an address of its own, at which index. Only
# the wallet's own answer counts as "not ours" (as retire-from-ccs-back): a timeout would otherwise
# leave a proposal out of the record, silently, and the record can't be written twice
: > "$WORK/mine"
# (retired-subaddress-N rows too: the old wallet's; their deposits are no proposal's, so not written)
jq -r 'to_entries[] | select(.value.address) | [.key, .value.address] | @tsv' "$WORK/state.json" |
    while IFS=$'\t' read -r file addr; do
        if ! res=$(rpc get_address_index "$(jq -nc --arg a "$addr" '{address: $a}')" 2> "$WORK/err"); then
            [[ $(cat "$WORK/err") =~ "Address doesn't belong to the wallet"|"Invalid address" ]] \
                || die "could not ask the wallet about $file's address: $(head -c 300 "$WORK/err")"
            continue
        fi
        idx=$(jq -r 'select(.index.major == 0) | .index.minor' <<<"$res")
        [[ $idx =~ ^[0-9]+$ ]] && printf '%s\t%s\n' "$idx" "$file" >> "$WORK/mine"
    done
n=$(grep -c . "$WORK/mine" || true)
((n > 0)) || die "none of proposals.csv's addresses is this wallet's: the wrong wallet, or already retired"
dup=$(awk -F'\t' 'seen[$1]++ { print $1; exit }' "$WORK/mine")
[[ -z $dup ]] || die "subaddress $dup is two proposals' in proposals.csv: fix the state first"

# every deposit to those subaddresses (in: confirmed, with a height), checked field by field
indexes=$(cut -f1 "$WORK/mine" | jq -R -s -c 'split("\n") | map(select(. != "") | tonumber)')
# a quiet wallet only: nothing in the pool or under MIN_CONFIRMATIONS, so what is recorded is final
# (an offline copy can't be asked for the pool: it has none to wait for)
if ! rpc get_transfers "{\"in\": true, \"pool\": true, \"account_index\": 0, \"subaddr_indices\": $indexes}" > "$WORK/transfers" 2> /dev/null; then
    rpc get_transfers "{\"in\": true, \"account_index\": 0, \"subaddr_indices\": $indexes}" > "$WORK/transfers" \
        || die "could not read the wallet's transfers"
    log "the wallet doesn't answer for the pool (an offline copy): its deposits only"
fi
young=$(jq --argjson m "$MIN_CONFIRMATIONS" '[(.pool // [])[], ((.in // [])[] | select((.confirmations // 0) < $m))] | length' "$WORK/transfers")
[[ $young == 0 ]] || die "$young deposit(s) in the pool or under $MIN_CONFIRMATIONS confirmations: retire a wallet once it is quiet (its addresses off the site, nothing new arriving); try again later"
jq -r '
    (.in // []) | unique_by([.txid, .subaddr_index.minor]) | sort_by(.height, .txid) | .[] | select((.height // 0) > 0)
    | if .amount > 9007199254740992 then error("amount \(.amount) is too large for jq to read exactly") else . end
    | "\(.height) \(.txid) \(.subaddr_index.minor) \(.amount) \(.unlock_time // 0)"' "$WORK/transfers" > "$WORK/in" \
    || die "could not read the wallet's transfers"
{
    printf '# retired %s wallet %s height %s time %s\n' "$name" "$main" "$height" "$(date +%s)"
    awk -F'\t' 'NR == FNR { file[$1] = $2; next }
        $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9a-f]+$/ || length($2) != 64 || $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ { bad = 1; exit }
        ($3 in file) && file[$3] ~ /\.md$/ { print $1 "," $2 "," $3 "," $4 "," $5 "," file[$3] }
        END { exit bad }' "$WORK/mine" FS=' ' "$WORK/in" || die "unexpected transfer from the wallet"
} > "$WORK/retired"
# read back as a run reads it (lib/wallet.sh retired_totals): a name or number it would refuse
# would stop every run after this one
mkdir "$WORK/check" && cp "$WORK/retired" "$WORK/check/$name.csv"
( RETIRED_DIR=$WORK/check retired_totals > /dev/null ) 2> "$WORK/check.err" \
    || die "a line a run couldn't read back, nothing written: $(sed 's/ (restore it.*//' "$WORK/check.err")"
deposits=$(($(wc -l < "$WORK/retired") - 1))
total=$(awk -F, 'NR > 1 { print $4 }' "$WORK/retired" | { s=0; while read -r a; do s=$((s + a)); done; echo "$s"; })

# the state without this wallet's subaddresses (the old one beside it), then the retired file
cp -p "$STATE_DIR/proposals.csv" "$STATE_DIR/proposals.csv.before-retire-$name"
cut -f2 "$WORK/mine" | jq -R -s 'split("\n") | map(select(. != ""))' > "$WORK/files.json"
jq --slurpfile f "$WORK/files.json" 'with_entries(if (.key | IN($f[0][])) then .value |= del(.subaddr_index, .address) else . end)' \
    "$WORK/state.json" > "$WORK/state.new" && mv "$WORK/state.new" "$WORK/state.json"
mkdir -p "$STATE_DIR/retired"
atomic_write "$out" cat "$WORK/retired"
save_state
if [[ $live && -f $STATE_DIR/deposits.csv ]]; then mv "$STATE_DIR/deposits.csv" "$STATE_DIR/deposits.csv.retired-$name"; fi
echo "retired $name: $n proposals' subaddresses, $deposits deposits, $(xmr4 "$total") XMR, in $out"
echo "  proposals.csv no longer has their index and address (before: proposals.csv.before-retire-$name)"
if [[ $live ]]; then
    echo "  this was the live wallet: deposits.csv moved aside. Next (docs/handover.md, \"Retiring a wallet\"):"
    echo "  the new wallet in wallet-rpc.conf, WALLET_ADDRESS in $config, its signed list, then one run"
fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    retire_main "$@"
fi
