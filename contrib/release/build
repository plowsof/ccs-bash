#!/usr/bin/env bash
# build: make releases' outputs, as the release workflow does, for attesting (contrib/release/attest).
# In place of Feather Wallet's contrib/guix/guix-build: each repository builds itself with its own
# pinned StageX container/build.sh, so this only clones the tag and records what came out.
#
#   contrib/release/build                     by default: the newest release of all three (the
#                                             newest set), unless you have attested it (below)
#   contrib/release/build ccs-bash v0.2.8 ccs-front-bash v0.1.11 ccs-front-hugo v0.1.9
#                                             or the releases you name (any of the three)
#   contrib/release/build ccs-bash            or the newest release of one
#
# The newest is the highest vX.Y.Z tag in its repository. Writes OUTDIR/<name>/SHA256SUMS.part
# (OUTDIR default ./output), <name> being the release, like ccs-bash-v0.2.8; attest signs the three
# together, as one set.
# A version of the CCS is the three together, attested in one folder per set in ccs-sigs (as
# feather-sigs has one per version): after a release of any one, all three are built and signed
# again. By default nothing is built if your ccs-sigs checkout (CCS_SIGS_REPO, default
# external/ccs-sigs) already has your attestation of the newest set; you are SIGNER's name, as
# attest has it (after the =, else gh's login, else the key). Releases you name are always built.
# Needs git, Docker with buildx, gpg, curl and jq. Every step is shown as it happens.
export LC_ALL=C
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
outdir=$(readlink -f "${OUTDIR:-output}")
base=${CCS_REPOS:-https://github.com/plowsof}

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
# newest NAME: its highest release tag
newest() {
    GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs "$base/$1" 'v*' 2> /dev/null | sed 's|.*refs/tags/||' \
        | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1
}
# signer: your name in ccs-sigs, as attest works it out (empty: unknown, nothing is skipped)
signer() {
    local key name=''
    [[ ${SIGNER:-} ]] && IFS='=' read -r key name <<<"$SIGNER"
    [[ $name ]] || name=$(command -v gh > /dev/null && gh api user --jq .login 2> /dev/null || true)
    printf '%s\n' "${name:-${key:-}}"
}
if [[ $# == 0 ]]; then
    repos=(ccs-bash ccs-front-bash ccs-front-hugo) tags=()
    for r in "${repos[@]}"; do
        t=$(newest "$r") && [[ $t ]] || { echo "ERR: no release tag found for $r" >&2; exit 1; }
        tags+=("$t")
    done
    echo "The newest release of each: ccs-bash ${tags[0]}, ccs-front-bash ${tags[1]}, ccs-front-hugo ${tags[2]}"
    set="ccs-bash-${tags[0]}+ccs-front-bash-${tags[1]}+ccs-front-hugo-${tags[2]}"
    me=$(signer)
    if [[ $me && -f ${CCS_SIGS_REPO:-external/ccs-sigs}/$set/$me/all.SHA256SUMS ]]; then
        echo "Nothing new to build: you ($me) have attested $set (name releases to build them anyway)"
        exit 0
    fi
    for i in 0 1 2; do "$0" "${repos[i]}" "${tags[i]}"; done
    exit 0
fi
(($# <= 2 || $# % 2 == 0)) || { echo "ERR: name each release with its tag: NAME TAG NAME TAG ..." >&2; exit 2; }
if (($# > 2)); then   # NAME TAG NAME TAG ...: each, in turn
    while (($#)); do "$0" "$1" "$2"; shift 2; done
    exit 0
fi
if [[ $# == 1 && $1 != -* ]]; then
    t=$(newest "$1") && [[ $t ]] || { echo "ERR: no release tag found for '$1'" >&2; exit 1; }
    exec "$0" "$1" "$t"
fi
[[ $# -ge 2 ]] || usage
what=$1

# (an older tag's build.sh doesn't check this itself: Docker's containerd image store gives
# images another ID than the one attested, see container/build.sh)
if docker info --format '{{json .DriverStatus}}' 2> /dev/null | grep -q 'io\.containerd\.snapshotter'; then
    echo 'ERR: Docker keeps images in its containerd store, where an image ID is not the attested one:' \
        'add "features": {"containerd-snapshotter": false} to /etc/docker/daemon.json and restart Docker' >&2
    exit 1
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
start=$(date +%s)
# step TEXT: what is happening now, and how long since the start
step() { printf '\n==> [%s] %s\n' "$(date -u -d "@$(($(date +%s) - start))" +%M:%S)" "$*"; }

# published [LABEL]: the value the release notes publish for this release (empty if unreadable,
# "several" if they name more than one: a release made by hand keeps its text, and CI's notes come
# after it, so a value written in by hand mustn't be taken for the built one); LABEL: the image's
# ("Image ID", or ccs-bash's gate image: "Gate image ID")
published() {
    local body vals label=${1:-Image ID}
    body=$(curl -fsS --max-time 20 "https://api.github.com/repos/plowsof/$what/releases/tags/$tag" 2> /dev/null \
        | jq -r '.body // empty' 2> /dev/null) || return 0
    if [[ $what == ccs-front-hugo ]]; then
        vals=$(grep -oE '[0-9a-f]{64}' <<<"$body" | sort -u || true)
    else
        vals=$(grep -oE "$label"': `sha256:[0-9a-f]{64}' <<<"$body" | grep -oE '[0-9a-f]{64}' | sort -u || true)
    fi
    if [[ $vals == *$'\n'* ]]; then echo several; else printf '%s\n' "$vals"; fi
}

case $what in
    ccs-bash | ccs-front-bash | ccs-front-hugo)
        tag=$2
        [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "ERR: a release tag, like v0.2.6: '$tag'" >&2; exit 1; }
        name=$what-$tag
        echo "Thank you for attesting $what $tag: you are checking, on your own machine, that this"
        echo "release is what its source says, so that nobody has to take it on trust."
        echo
        echo "This clones the tag and builds it with the repository's own pinned StageX build, the same"
        echo "way as the release, showing its output as it goes. On a machine with nothing cached, the"
        echo "first of ccs-bash and ccs-front-bash takes about 3 minutes and 2.3 GB of Docker's disk (the"
        echo "pinned StageX images and a BuildKit builder), the other about a minute and 0.2 GB, and"
        echo "ccs-front-hugo under half a minute and 0.2 GB; later builds reuse it all. Nothing is"
        echo "installed outside Docker, and the build steps get no network."
        step "Fetching $what at $tag"
        git -c advice.detachedHead=false clone -q --branch "$tag" --depth 1 "$base/$what" "$tmp/src"
        commit=$(git -C "$tmp/src" rev-parse HEAD)
        echo "commit $commit"
        step "Building $what $tag (the build's own output: signature checks, downloads, build steps)"
        if [[ $what == ccs-front-hugo ]]; then
            "$tmp/src/container/build.sh" "$tmp/out"
            result=$(sha256sum < "$tmp/out/ccs-front-hugo.zip" | cut -d' ' -f1)
            line="$result  $name.zip"                             # the release's asset, as named there
        else
            NO_CACHE=1 "$tmp/src/container/build.sh" "$name-attest"
            id=$(docker image inspect "$name-attest" --format '{{.Id}}')
            docker image rm "$name-attest" > /dev/null
            result=${id#sha256:}
            line="$result  $name-$commit.image-id"                # the image ID; the commit it came from
        fi
        # ccs-bash's other image, the gate's (contrib/docker/web), from the same tag: attested on
        # a line of its own in the same file, ccs-gate-<tag>-<commit>.image-id
        gate=''
        if [[ $what == ccs-bash && -f $tmp/src/container/gate.Dockerfile ]]; then
            step "Building ccs-bash $tag's gate image (container/gate.Dockerfile)"
            NO_CACHE=1 "$tmp/src/container/build.sh" "$name-gate-attest" gate.Dockerfile
            gate=$(docker image inspect "$name-gate-attest" --format '{{.Id}}')
            docker image rm "$name-gate-attest" > /dev/null
            gate=${gate#sha256:}
            line+=$'\n'"$gate  ccs-gate-$tag-$commit.image-id"
        fi
        step "Comparing with the release notes"
        for kind in image gate; do
            [[ $kind == image ]] && { got=$result pub=$(published); }
            [[ $kind == gate ]] && { [[ $gate ]] || continue; got=$gate pub=$(published "Gate image ID"); echo "The gate image:"; }
            if [[ -z $pub ]]; then
                echo "Couldn't read the release notes: compare it yourself with https://github.com/plowsof/$what/releases/tag/$tag"
            elif [[ $pub == several ]]; then
                echo "!! The release notes name more than one: compare it yourself with https://github.com/plowsof/$what/releases/tag/$tag"
            elif [[ $pub == "$got" ]]; then
                echo "The same as the release notes publish."
            else
                echo "!! DIFFERENT from the release notes: they publish $pub."
                echo "!! Please attest what you got all the same (that is the point), and say so in your pull request."
            fi
        done
        ;;
    *) usage ;;
esac

mkdir -p "$outdir/$name"
printf '%s\n' "$line" > "$outdir/$name/SHA256SUMS.part"
step "Done: $name"
echo "$line"
echo
echo "Saved in $outdir/$name/SHA256SUMS.part. Build any others you want to attest, then sign them all:"
echo "    env SIGNER=<fingerprint>=<github username> $here/attest"
