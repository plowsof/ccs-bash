#!/usr/bin/env bash
# attest: sign what contrib/release/build made, into a ccs-sigs checkout, for a pull request there.
# Adapted from Feather Wallet's contrib/guix/guix-attest (tobtoht), itself from Bitcoin Core's
# (MIT, see contrib/release/README.md): the same SIGNER, NO_SIGN and layout, so an attester who
# knows feather-sigs knows this.
export LC_ALL=C
set -e -o pipefail

check_tools() {
    for cmd in "$@"; do
        if ! command -v "$cmd" > /dev/null 2>&1; then
            echo "ERR: This script requires that '$cmd' is installed and available in your \$PATH"
            exit 1
        fi
    done
}

###################
## Sanity Checks ##
###################

check_tools cat env basename mkdir diff sort

if [ -z "$NO_SIGN" ]; then
    # make it possible to override the gpg binary
    GPG=${GPG:-gpg}

    # $GPG can contain extra arguments passed to the binary
    # so let's check only the existence of arg[0]
    # shellcheck disable=SC2206
    GPG_ARRAY=($GPG)
    check_tools "${GPG_ARRAY[0]}"
fi

cmd_usage() {
cat <<EOF
Synopsis:

    env SIGNER=GPG_KEY_NAME[=SIGNER_NAME] \\
        [ CCS_SIGS_REPO=<path/to/ccs-sigs> ] \\
        [ OUTDIR=<what contrib/release/build wrote, default ./output> ] \\
        [ NO_SIGN=1 ] [ NO_COMMIT=1 ]
      ./contrib/release/attest

SIGNER_NAME is your GitHub username (default: gh's login, if gh is signed in). Then it adds
your public key the first time, and commits in ccs-sigs on a branch of its own, titled
"Add <signer> <set>"; pushing and the pull request are yours (it says how).

Example overriding signing name:

    env SIGNER=0xDC8BCF0C5083F2030782803E4E8A912D40ED052C=plowsof \\
        CCS_SIGS_REPO=../ccs-sigs \\
      ./contrib/release/attest

Example w/o signing, just creating SHA256SUMS:

    env SIGNER=plowsof NO_SIGN=1 ./contrib/release/attest

EOF
}

if [ "$1" = -h ] || [ "$1" = --help ]; then cmd_usage; exit 0; fi

if [ -z "${SIGNER}" ]; then
    printf "Enter your GitHub username: "
    read -r signer

    if [ -z "$signer" ]; then
        echo "ERR: signer name can't be empty"
        exit 1
    fi

    echo ""
    echo "[HINT] To find your GPG fingerprint use:"
    echo "gpg --list-secret-keys --keyid-format=long"
    echo "It should look like: E87BD921CDD885C9D78A38C5E45B10DD027D2472"
    echo ""

    printf "Enter fingerprint of your GPG key: "
    read -r fingerprint

    export SIGNER="${fingerprint}=${signer}"
    wizard=1
fi

if [ -n "$wizard" ]; then
    echo ""
    echo "Next time, invoke this command as:"
    echo "env SIGNER=${SIGNER} ./contrib/release/attest"
    echo ""
fi

################
# The key specified in SIGNER should be usable
################

IFS='=' read -r gpg_key_name signer_name <<< "$SIGNER"
if [ -z "${signer_name}" ] && command -v gh > /dev/null 2>&1; then
    signer_name=$(gh api user --jq .login 2> /dev/null || true)
fi
if [ -z "${signer_name}" ]; then
    signer_name="$gpg_key_name"
fi

if [ -z "$NO_SIGN" ] && ! ${GPG} --dry-run --list-secret-keys "${gpg_key_name}" >/dev/null 2>&1; then
    echo "ERR: GPG can't seem to find any key named '${gpg_key_name}'"
    exit 1
fi

CCS_SIGS_REPO=${CCS_SIGS_REPO:-external/ccs-sigs}
if [ ! -d "$CCS_SIGS_REPO/builder-keys" ]; then
    echo "ERR: '$CCS_SIGS_REPO' isn't a ccs-sigs checkout (git clone https://github.com/plowsof/ccs-sigs)"
    exit 1
fi
CCS_SIGS_REPO=$(cd "$CCS_SIGS_REPO" && pwd)

################
# We should be able to find at least one output
################

LOGDIR_BASE=${OUTDIR:-output}
echo "Looking for build output SHA256SUMS fragments in ${LOGDIR_BASE}"

shopt -s nullglob
sha256sum_fragments=( "$LOGDIR_BASE"/*/SHA256SUMS.part )
shopt -u nullglob

if (( ${#sha256sum_fragments[@]} )); then
    echo "Found build output SHA256SUMS fragments:"
    for logdir in "${sha256sum_fragments[@]}"; do
        echo "    '$logdir'"
    done
    echo
else
    echo "ERR: Could not find any build output SHA256SUMS fragments in ${LOGDIR_BASE} (run contrib/release/build first)"
    exit 1
fi

##############
##  Attest  ##
##############

shasum_already_exists() {
cat <<EOF
--

ERR: An ${1} file already exists for '${2}' and attests differently.

     See the diff above for more context.

Hint: You may wish to remove the existing attestations and their signatures by
      invoking:

          rm '${PWD}/${1}'{,.asc}

      Then try running this script again.

EOF
}

# As Feather's one all.SHA256SUMS per version: everything built in this run goes into one file,
# signed once. The three repositories are versioned apart, so the folder is named after the set:
# <release>+<release>+.../<signer>/all.SHA256SUMS (verify checks a release in any set it is in).
names=()
for fragment in "${sha256sum_fragments[@]}"; do names+=( "$(basename "$(dirname "$fragment")")" ); done
name=$(printf '%s\n' "${names[@]}" | sort -u | paste -sd+)
fragment_paths=()
for fragment in "${sha256sum_fragments[@]}"; do fragment_paths+=( "$(readlink -f "$fragment")" ); done
echo "Attesting to build outputs for: '${name}'"
outsigdir="$CCS_SIGS_REPO/$name/$signer_name"
mkdir -p "$outsigdir"
(
    cd "$outsigdir"

    temp_file="$(mktemp)"
    trap 'rm -rf -- "$temp_file"' EXIT

    cat "${fragment_paths[@]}" | sort -u | sort -k2 > "$temp_file"
    if [ -e all.SHA256SUMS ]; then
        # The SHA256SUMS already exists, make sure it's exactly what we
        # expect, error out if not
        if diff -u all.SHA256SUMS "$temp_file"; then
            echo "A SHA256SUMS file already exists for '${name}' and is up-to-date."
        else
            shasum_already_exists all.SHA256SUMS "$name"
            exit 1
        fi
    else
        mv "$temp_file" all.SHA256SUMS
    fi

    echo "What you attest ($outsigdir/all.SHA256SUMS):"
    sed 's/^/    /' all.SHA256SUMS

    if [ -z "$NO_SIGN" ]; then
        echo "Signing SHA256SUMS to produce SHA256SUMS.asc"
        for i in *.SHA256SUMS; do
            if [ ! -e "$i".asc ]; then
                ${GPG} --detach-sign \
                       --digest-algo sha256 \
                       --local-user "$gpg_key_name" \
                       --armor \
                       --output "$i".asc "$i"
            else
                echo "Signature already there"
            fi
        done
    else
        echo "Not signing SHA256SUMS as \$NO_SIGN is not empty"
    fi
    echo ""
)

if [ -n "$NO_SIGN" ]; then
    echo "Not signed, so not committed."
    exit 0
fi

# Your first attestation: your public key goes in the same pull request
if [ ! -e "$CCS_SIGS_REPO/builder-keys/$signer_name.asc" ]; then
    ${GPG} --export --armor "$gpg_key_name" > "$CCS_SIGS_REPO/builder-keys/$signer_name.asc"
    echo "Added your public key: builder-keys/$signer_name.asc"
fi

title="Add $signer_name $name"   # as feather-sigs' ("Add <signer> <version>")
if [ -n "$NO_COMMIT" ]; then
    echo "Not committed (NO_COMMIT): commit in $CCS_SIGS_REPO yourself, titled \"$title\"."
    exit 0
fi

cd "$CCS_SIGS_REPO"
# master or testnet: the one this checkout started from (the newer, if it has both)
contains() { git rev-parse -q --verify "$1" > /dev/null && git merge-base --is-ancestor "$1" HEAD; }
base=master
if contains origin/testnet; then
    if ! contains origin/master || git merge-base --is-ancestor origin/master origin/testnet; then base=testnet; fi
fi
# a branch of its own, unless you are already on one
branch=$(git symbolic-ref -q --short HEAD || true)
if [ -z "$branch" ] || [ "$branch" = master ] || [ "$branch" = testnet ]; then
    branch="$signer_name-$name"
    git checkout -q -b "$branch"
fi
git add -- "$name/$signer_name" "builder-keys/$signer_name.asc"
if git diff --cached --quiet; then
    echo "Nothing new to commit: already committed?"
else
    git commit -q -m "$title"
    echo "Committed \"$title\" on the branch $branch, in $CCS_SIGS_REPO."
fi
echo ""
echo "Now push it and open a pull request against $base, from your fork of ccs-sigs"
echo "(ccs-sigs' owner: push to origin instead):"
echo ""
echo "    git -C '$CCS_SIGS_REPO' push <your fork's remote> '$branch'"
echo "    gh pr create -R plowsof/ccs-sigs --base $base --head '$signer_name:$branch' --fill"
echo ""
echo "Thank you!"
