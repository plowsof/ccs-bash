#!/usr/bin/env bash
# verify: check every attestation in a ccs-sigs checkout: each signature against its signer's
# key in builder-keys/, and every signer's all.SHA256SUMS the same for a release.
# Adapted from Feather Wallet's contrib/guix/guix-verify (tobtoht), itself from Bitcoin Core's
# (MIT, see contrib/release/README.md). Unlike it, the keys come from builder-keys/ into a
# keyring of their own, not from yours, and each signature must be by the key of the signer whose
# folder it is in (builder-keys/<signer>.asc, one key): one key can't sign as several signers, and
# signers with the same key count once.
#
#   TRUSTED_KEYS=FILE   only signers whose key's fingerprint is in FILE (one a line, # comments)
#                       count; the others are shown, not counted. Keep FILE yourself, not in ccs-sigs.
#                       Needed: without it nothing counts, unless --any-key (anyone can add a key
#                       to ccs-sigs, so every key there counting is for seeing who agrees, not trust)
#   --min-signers N     a release needs N signers who agree: 2 by default, so that one stolen or
#                       careless key isn't enough; 1 relaxes it (a release only you have attested)
export LC_ALL=C
set -e -o pipefail

check_tools() {
    for cmd in "$@"; do
        if ! command -v "$cmd" > /dev/null 2>&1; then
            echo "ERR: This script requires that '$cmd' is installed and available in your \$PATH"
            exit 1
        fi
    done
}

check_tools cat diff gpg

cmd_usage() {
cat <<EOF
Synopsis:

    env [ CCS_SIGS_REPO=<path/to/ccs-sigs> ] [ SIGNER=<signer> ] [ TRUSTED_KEYS=<file> ] \
        ./contrib/release/verify [ --min-signers N ] [ --any-key ] [ NAME... ]

A release needs --min-signers signers who agree (default 2), each signature by the key of the
signer whose folder it is in, and only keys listed in TRUSTED_KEYS count. --any-key instead counts
every key in ccs-sigs, which anyone can send a key to: to see who agrees, not to trust a release.

NAME is a folder in ccs-sigs (a set of releases attested together, e.g.
ccs-bash-v0.2.7+ccs-front-bash-v0.1.9+ccs-front-hugo-v0.1.8), or one release (ccs-bash-v0.2.7):
then every set it is in counts, and its line must be the same for every signer. Default: every
folder.

Example overriding signer's manifest to use as base

    env CCS_SIGS_REPO=../ccs-sigs SIGNER=plowsof ./contrib/release/verify ccs-bash-v0.2.6

EOF
}

min_signers=2 any_key=''
while [[ ${1:-} == -* ]]; do
    case $1 in
        -h | --help) cmd_usage; exit 0 ;;
        --min-signers) min_signers=${2:-}; shift 2 || { cmd_usage; exit 1; } ;;
        --any-key) any_key=1; shift ;;
        *) echo "ERR: unknown option '$1'"; cmd_usage; exit 1 ;;
    esac
done
[[ $min_signers =~ ^[1-9][0-9]*$ ]] || { echo "ERR: --min-signers takes a number, 1 or more"; exit 1; }
if [[ -z ${TRUSTED_KEYS:-} && -z $any_key ]]; then
    echo "ERR: set TRUSTED_KEYS=<file> to the fingerprints of the attesters you trust, one a line;"
    echo "     or --any-key to count every key in ccs-sigs (anyone can add one: not for trusting a release)"
    exit 1
fi

CCS_SIGS_REPO=${CCS_SIGS_REPO:-external/ccs-sigs}
[ -d "$CCS_SIGS_REPO/builder-keys" ] || { echo "ERR: '$CCS_SIGS_REPO' isn't a ccs-sigs checkout"; exit 1; }

# only the keys in builder-keys/, in a keyring of their own
GNUPGHOME=$(mktemp -d)
export GNUPGHOME
trap 'gpgconf --kill all 2> /dev/null || true; rm -rf "$GNUPGHOME"' EXIT
shopt -s nullglob
keys=( "$CCS_SIGS_REPO"/builder-keys/*.asc )
(( ${#keys[@]} )) && gpg --quiet --batch --import "${keys[@]}" 2> /dev/null
if [[ -n ${TRUSTED_KEYS:-} ]]; then
    [[ -f $TRUSTED_KEYS ]] || { echo "ERR: no TRUSTED_KEYS file '$TRUSTED_KEYS'"; exit 1; }
    trusted=$(sed 's/#.*//; s/[[:space:]]//g' "$TRUSTED_KEYS" | tr 'a-f' 'A-F' | grep -E '^[0-9A-F]{40}$' || true)
fi

# key_of SIGNER: the fingerprint of the one primary key in builder-keys/SIGNER.asc
key_of() {
    local f="$CCS_SIGS_REPO/builder-keys/$1.asc" fprs
    [ -e "$f" ] || return 1
    fprs=$(gpg --batch --with-colons --import-options show-only --import "$f" 2> /dev/null \
        | awk -F: '$1 == "pub" { want = 1; next } want && $1 == "fpr" { print $10; want = 0 }')
    [[ $fprs =~ ^[0-9A-F]{40}$ ]] && echo "$fprs"
}
# signed MANIFEST: good signature (.asc) by the key of the signer whose folder it is in, not
# revoked (gpg still says VALIDSIG for a revoked key's signature); prints that key's fingerprint.
# An expired key's still counts: its attestations were made before it expired.
signed() {
    local signer key status by
    signer=$(basename "$(dirname "$1")")
    key=$(key_of "$signer") || return 1
    status=$(gpg --batch --status-fd 1 --verify "$1.asc" "$1" 2> /dev/null) || return 1
    grep -qE '^\[GNUPG:\] (REVKEYSIG|KEYREVOKED|BADSIG|ERRSIG|EXPSIG) ' <<<"$status" && return 1
    by=$(awk '$2 == "VALIDSIG" { print $NF }' <<<"$status")
    [[ $by == "$key" ]] && echo "$key"
}
# counts KEY: it counts, unless TRUSTED_KEYS is set and doesn't have it
counts() { [[ -z ${TRUSTED_KEYS:-} ]] || grep -qxF "$1" <<<"$trusted"; }

# a release's name, exactly (a name that is only the start of one, ccs-bash-v9.9 of
# ccs-bash-v9.9.9, is none), or a set of them joined by +
release_re='(ccs-bash|ccs-front-bash|ccs-front-hugo)-v[0-9]+\.[0-9]+\.[0-9]+'
for name in "$@"; do
    [[ $name =~ ^$release_re(\+$release_re)*$ ]] || { echo "ERR: '$name' is not a release (ccs-bash-v1.2.3, ...) or a set of them joined by +"; exit 1; }
done
# its line in a manifest, exactly: the hash, two spaces, the name, and the commit (an image) or .zip
line_re() { printf '^[0-9a-f]{64}  %s(-[0-9a-f]{12,40}\\.image-id|\\.zip)$' "${1//./\\.}"; }
named=$#
if (( $# )); then names=( "$@" ); else
    names=()
    for d in "$CCS_SIGS_REPO"/*/*/all.SHA256SUMS; do names+=( "$(basename "$(dirname "$(dirname "$d")")")" ); done
    (( ${#names[@]} )) && mapfile -t names < <(printf '%s\n' "${names[@]}" | sort -u)
fi

# release NAME: one release, in every set (folder) that has it: each signature checked, and its
# whole line (the hash, and the name with the commit it was built from) the same for every signer
# who counts, whichever set they attested. Only those who count are compared: one who doesn't
# can't change what is printed (a folder of theirs with a bad signature, or two lines for a
# release, still fails the check: look at it, it accepts nothing).
release() {
    local name=$1 set m line key base='' basefrom='' n=0 seen=0 commit counted=' '
    for set in "$CCS_SIGS_REPO"/*/; do
        set=$(basename "$set")
        [[ +$set+ == *"+$name+"* ]] || continue
        for m in "$CCS_SIGS_REPO/$set"/*/all.SHA256SUMS; do
            # a signer who doesn't count is passed over before anything is checked: their folder,
            # whatever is in it, can't stop the others agreeing
            seen=$((seen + 1))
            if ! key=$(key_of "$(basename "$(dirname "$m")")") || ! counts "$key"; then
                echo "Not counted: '$m' (its signer's key is not in TRUSTED_KEYS)"; continue
            fi
            if ! key=$(signed "$m"); then
                echo "ERR: '$m' is not signed by its signer's key (builder-keys/$(basename "$(dirname "$m")").asc), or that key is revoked"; failure=1; continue
            fi
            line=$(grep -E "$(line_re "$name")" "$m" || true)
            [ -n "$line" ] || { echo "ERR: '$m' has no line for $name"; failure=1; continue; }
            [[ $line != *$'\n'* ]] || { echo "ERR: '$m' has more than one line for $name"; failure=1; continue; }
            if [[ $counted == *" $key "* ]]; then echo "Not counted again: '$m' (key $key already counted)"; continue; fi
            if [ -z "$base" ]; then base=$line basefrom=$m
            elif [ "$line" != "$base" ]; then
                echo "ERR: $name differs: '$basefrom' has '$base', '$m' has '$line'"; failure=1; continue
            fi
            counted+="$key "
            n=$((n + 1))
            echo "Verified: $name in '$m'"
        done
    done
    (( seen )) && checked=1
    echo ""
    if (( n )); then
        echo "$name: ${base%% *} (${n} signer(s) agree)"
        # the commit it was built from, when the attestation names it (contrib/release/build)
        commit=${base##*  "$name"-}; commit=${commit%.image-id}
        if [[ $commit =~ ^[0-9a-f]{12,40}$ ]]; then
            echo "$name: from commit $commit (build from this commit, not the tag: a tag can move)"
        elif [[ $base == *.image-id ]]; then
            echo "ERR: $name: its line names no commit to build from"; failure=1
        fi
        if (( n < min_signers )); then echo "ERR: $name: $n signer(s) agree, $min_signers needed (--min-signers)"; failure=1; fi
    elif (( seen )); then
        echo "ERR: $name: attested $seen time(s), by no one in TRUSTED_KEYS"; failure=1
    elif (( named )); then
        echo "ERR: no attestation of $name"; failure=1
    else
        echo "WARN: no attestation of $name"
    fi
    echo ""
}

checked=0
for name in "${names[@]}"; do
    OUTSIGDIR_BASE="$CCS_SIGS_REPO/$name"
    if [[ $name != *+* ]]; then   # one release: in every set that has it
        echo "--------------------  $name"
        echo ""
        release "$name"
        continue
    fi
    all_all=( "$OUTSIGDIR_BASE"/*/all.SHA256SUMS )
    echo "--------------------  $name  (${#all_all[@]} signer(s))"
    echo ""
    if (( ${#all_all[@]} )); then
        # SIGNER's manifest first, as the base to compare against (if it counts)
        if [[ -n ${SIGNER:-} && -f $OUTSIGDIR_BASE/$SIGNER/all.SHA256SUMS ]]; then
            echo "Using $SIGNER's manifest as the base to compare against"
            all_all=( "$OUTSIGDIR_BASE/$SIGNER/all.SHA256SUMS" "${all_all[@]/"$OUTSIGDIR_BASE/$SIGNER/all.SHA256SUMS"}" )
        fi
        # as for one release: only signers who count are compared, each key once, TRUSTED_KEYS'
        # only; and the base must have one line for each release the folder's name lists and no
        # other (an old set's manifests copied under a new set's name don't)
        n=0 counted=' ' base=''
        for m in "${all_all[@]}"; do
            [ -n "$m" ] || continue
            if ! key=$(key_of "$(basename "$(dirname "$m")")") || ! counts "$key"; then
                echo "Not counted: '$m' (its signer's key is not in TRUSTED_KEYS)"; continue
            fi
            if ! key=$(signed "$m"); then
                echo "ERR: '$m' is not signed by its signer's key (builder-keys/$(basename "$(dirname "$m")").asc), or that key is revoked"; failure=1; continue
            fi
            if [[ $counted == *" $key "* ]]; then echo "Not counted again: '$m' (key $key already counted)"; continue; fi
            if [ -z "$base" ]; then
                ok=1 parts=0
                for part in ${name//+/ }; do
                    parts=$((parts + 1))
                    [[ $(grep -cE "$(line_re "$part")" "$m") == 1 ]] || { echo "ERR: '$m' has no line, or several, for $part"; ok=''; }
                done
                [[ $(grep -c . "$m") == "$parts" ]] || { echo "ERR: '$m' has other lines than the $parts release(s) in '$name'"; ok=''; }
                [ -n "$ok" ] || { failure=1; continue; }
                base=$m
            elif ! diff --report-identical "$base" "$m" 1>&2; then
                echo "ERR: The SHA256SUMS attestation in these two directories differ:"
                echo "    '$base'"
                echo "    '$m'"
                failure=1; continue
            fi
            counted+="$key "
            n=$((n + 1))
            echo "Verified: '$m'"
        done
        echo ""
        echo "$name: ${n} signer(s) agree"
        [ -z "$base" ] || sed 's/^/    /' "$base"
        if (( n < min_signers )); then echo "ERR: $name: $n signer(s) agree, $min_signers needed (--min-signers)"; failure=1; fi
        echo ""
        checked=1
    else
        if (( named )); then echo "ERR: No signature directories with all.SHA256SUMS found for '$name'"; failure=1
        else echo "WARN: No signature directories with all.SHA256SUMS found for '$name'"; fi
        echo ""
    fi
done

echo "===================="
echo ""
if [ "$checked" = 0 ]; then
    echo "ERR: Unable to perform any verifications as no signature directories"
    echo "     were found"
    echo ""
    exit 1
fi

if [ -n "$failure" ]; then
    exit 1
fi
