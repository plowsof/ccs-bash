# /opt/ccs-bash/contrib/docker/backend/.env (root 600), beside compose.yml: env.example, filled
# in for ccs.getmonero.org. ccs config:check checks it.
# the images, by ID: the attested ones of the release you run (contrib/release/verify, then
# container/build.sh or docker load: the same ID); the wallet's, as built here
CCS_BASH_IMAGE=sha256:<ccs-bash's attested image ID>
CCS_FRONT_IMAGE=sha256:<ccs-front-bash's attested image ID>
WALLET_IMAGE=sha256:<docker build -q contrib/docker/backend/wallet-rpc>
# the host's users, uid:gid (id -u ccs; id -g ccs; ...)
CCS_UID=<uid:gid of ccs>
GIT_UID=<uid:gid of ccs-git>
FRONT_UID=<uid:gid of ccs-front>
WALLET_UID=<uid:gid of ccs-wallet>
PUSH_UID=<uid:gid of ccs-push>
SEND_UID=<uid:gid of ccs-send>
WATCH_UID=<uid:gid of ccs-watch>
# the wallet's RPC port, as wallet-rpc.conf's rpc-bind-port (its healthcheck)
WALLET_PORT=18082
# the web server's push account and the backup machine's (ssh, port 22)
CCS_PUSH=ccs-data@<web server>
CCS_BACKUP=ccs-backup@<backup machine>
# a web server running its own compose (contrib/docker/web): its gate and backup sshd's ports
#CCS_PUSH_PORT=2223
#CCS_BACKUP_PORT=2224
# the site: what ccs-watch checks, and the feed's links (as the web server's alert.conf SITE_URL)
CCS_SITE_URL=https://ccs.getmonero.org
# with an onion service: its address, for every page's footer, as the web server's /etc/ccs-gate/onion
#CCS_ONION=<56 characters>.onion
# a monerod, Tor or bot on this machine: listening where containers reach it, host.docker.internal
# (docs/handover.md, 1); only one that can't leave its 127.0.0.1 needs the host's network:
#COMPOSE_FILE=compose.yml:compose.host.yml
