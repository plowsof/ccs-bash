#!/bin/bash
# ccs-receive: the web server's last check (docs/two-machines.md, "The gate"). The backend's push
# key runs only this (command= in authorized_keys). It receives the push as rrsync always did, but
# into a staging folder, one push at a time; then
#   - every page must be one of the design's own (the release zips unpacked in design/, installed
#     here by hand), each region filled with the design's parts and each {{slot}} with a value of
#     its kind (a number, escaped text that can't hold an address, a link to the proposals'
#     forge...), and a proposal's text exactly what markdown.awk (ccs-front-bash's, installed here)
#     makes of its file in the proposals repository (proposals.conf), fetched here: nothing else
#     can be on a page, whatever a browser would make of it;
#   - every Monero address in the pages and JSON must be one of the wallet's (the signed list and
#     its .pin, installed here by hand) or in the allowed file, and every data: image, pixel for
#     pixel, the QR code qrencode makes of such an address; the JSON read as JSON;
#   - every other file it changes must be the design's (design.sha256, from the release zip), a
#     proposal's image that the proposals repository has at that path (any QR code in it holding
#     only such addresses), projects.json, or the signed list's own files, the same as the ones
#     installed here.
# The push goes live, except a file that fails: that one keeps its last good copy (a new one stays
# out), IRC is told (alert.conf), and it exits 7 (the backend's rsync exits 7 too). A list that isn't the pinned one, or no design.sha256,
# design or markdown.awk, refuses the whole push. Needs bash, awk, grep, rsync (rrsync),
# coreutils, curl, zbarimg (zbar-tools), qrencode, git, python3 (as rrsync). Root-owned, 755.
set -euo pipefail
export LC_ALL=C
staging=/var/lib/ccs-staging live=/var/lib/ccs-data conf=/etc/ccs-gate state=/var/lib/ccs-gate

# The reason goes to the web server's journal (and /var/log/ccs-gate.log, if ccs-data may write
# it), and to the backend: that last one only if ssh relays it before the rsync client exits.
# alert KEY MESSAGE: also to IRC (/etc/ccs-gate/alert.conf: ALERT_URL, SITE_URL), at most once an
# hour per KEY: a taken-over backend retrying every two minutes mustn't flood the channel. Here
# is where a bad push is seen even when the backend is the one lying.
alert() {
    local url='' site='' k v stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    [[ -r $conf/alert.conf ]] || return 0
    while IFS='=' read -r k v; do
        case $k in ALERT_URL) url=$v ;; SITE_URL) site=$v ;; esac
    done < <(grep -E '^(ALERT_URL|SITE_URL)=' "$conf/alert.conf")
    [[ $url ]] || return 0
    if [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]]; then return 0; fi
    touch "$stamp" 2> /dev/null || true
    curl -fsS --max-time 10 --data-binary "[${blue}CCS-watch${off}] ${2//@SITE@/${site:-}}" -H 'Content-Type: text/plain' "$url" > /dev/null 2>&1 \
        || say "could not send the alert"
}

blue=$'\x0312' red=$'\x0304' off=$'\x03'   # IRC colours, as ccs-watch's

say() {
    logger -t ccs-gate -- "$*" 2> /dev/null || true
    printf '%s %s\n' "$(date -u '+%F %T')" "$*" 2> /dev/null >> /var/log/ccs-gate.log || true   # 2> first: it also hides a log it can't open
    printf 'ccs-gate: %s\n' "$*" >&2
}

# refuse WHY KEY [WHY_FOR_IRC]: the whole push stays out
refuse() {
    say "refused the push: $1"
    alert "$2" "the web server refuses every push: ${3:-$1}"
    exit 1
}

# The pages' and JSON's addresses, as written (pages() says what can be on a page at all), as
# "file<TAB>address" lines; "file<TAB>!reason" for what the gate can't accept; "file<TAB>?qr<TAB>
# base64" for each data: image, for zbarimg (below). An address is a run of 95 (standard) or 106
# (integrated) base58 characters, tags and attributes included (a monero: link, an alt text),
# entities read as a browser reads them (&#56; is 8). A character that isn't ASCII, or a control
# character, is read twice: dropped (a zero-width space mustn't split an address) and as a space
# (a no-break space mustn't join one to the word beside it). A page or JSON must start with <, [
# or {: no image format does, and a browser shows an <img> of any file whose bytes are an image's.
# No interval expressions ({95}): mawk 1.3.3 has none.
scan_awk='
function hexval(h,    i, v) { v = 0; h = tolower(h); for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1; return v }
# a character: printable ASCII as itself, a space as one, anything else \001 (see tokens)
function chr(n) {
    if (n > 32 && n < 127) return sprintf("%c", n)
    return (n == 9 || n == 10 || n == 12 || n == 13 || n == 32) ? " " : "\001"
}
function decode(s,    out, e, n) {
    out = ""
    while (match(s, /&#[0-9]+;?|&#[xX][0-9A-Fa-f]+;?|&[A-Za-z][A-Za-z0-9]*;/)) {
        e = substr(s, RSTART, RLENGTH); out = out substr(s, 1, RSTART - 1); s = substr(s, RSTART + RLENGTH)
        sub(/;$/, "", e)
        if (e ~ /^&#[xX]/) n = hexval(substr(e, 4))
        else if (e ~ /^&#/) n = substr(e, 3) + 0
        else { e = substr(e, 2); n = (e == "amp") ? 38 : (e == "lt") ? 60 : (e == "gt") ? 62 : (e == "quot") ? 34 : (e == "apos") ? 39 : -1 }
        out = out chr(n)
    }
    return out s
}
function run(f, s,    t) {
    while (match(s, /[0-9A-Za-z]+/)) {
        t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        if ((length(t) == 95 || length(t) == 106) && t !~ /[0OIl]/) print f "\t" t
    }
}
# both readings of \001: dropped, and a space
function tokens(f, s,    d) { d = s; gsub(/\001/, "", d); run(f, d); gsub(/\001/, " ", s); run(f, s) }
function check(f, d,    a, m) {
    if (d !~ /^[ \t\n\r]*[<[{]/) print f "\t!not text that starts as a page or JSON does (<, [ or {): a browser would show it as an image"
    gsub(/[\200-\377]|[\001-\010\013\016-\037\177]/, "\001", d)
    a = decode(d)
    # each data: image (the QR codes: pages() allows them nowhere else) to zbarimg; not text
    m = a
    while (match(m, /data:image\/png;base64,[A-Za-z0-9+\/]+=*/)) { print f "\t?qr\t" substr(m, RSTART + 22, RLENGTH - 22); m = substr(m, RSTART + RLENGTH) }
    gsub(/data:image\/png;base64,[A-Za-z0-9+\/]+=*/, " ", a)
    tokens(f, a)
}
FNR == 1 && NR > 1 { check(prev, doc); doc = "" }
{ doc = doc $0 "\n"; prev = FILENAME }
END { if (NR) check(prev, doc) }'

# qr FILE IMAGE: the addresses in every QR code in IMAGE as "FILE<TAB>address" lines (none if it
# has no QR code). zbarimg reads it, as ccs-data, with a time limit; inverted codes (light on dark)
# too, which it skips by default and phones read.
qr() {
    local out
    out=$(timeout 20 zbarimg -q --raw -Stest-inverted -- "$2" 2> /dev/null) || return 1
    grep -oE '[0-9A-Za-z]+' <<<"$out" | awk -v f="$1" '(length($0) == 95 || length($0) == 106) && !/[0OIl]/ { print f "\t" $0; n++ } END { exit !n }'
}

# pixels PNG: "<width> <height> <sha256 of its RGBA pixels>", as a browser shows it; nothing (and
# 1) for a PNG it can't read, or with any chunk qrencode doesn't write (an animated PNG's frames,
# a gamma or colour profile could show something else). Python's standard library only.
pixels_py='
import hashlib, struct, sys, zlib
d = sys.stdin.buffer.read(4 << 20)
assert d[:8] == b"\x89PNG\r\n\x1a\n"
i, idat, plte, trns, hdr = 8, b"", b"", None, None
while True:
    n, t = struct.unpack(">I4s", d[i:i + 8]); c = d[i + 8:i + 8 + n]; i += 12 + n
    assert len(c) == n and t in (b"IHDR", b"PLTE", b"tRNS", b"pHYs", b"IDAT", b"IEND")
    if t == b"IHDR": hdr = struct.unpack(">IIBBBBB", c)
    elif t == b"PLTE": plte = c
    elif t == b"tRNS": trns = c
    elif t == b"IDAT": idat += c
    elif t == b"IEND": break
w, h, depth, kind, _, _, interlace = hdr
assert 0 < w <= 4096 and 0 < h <= 4096 and interlace == 0 and (kind, depth) in ((0, 1), (0, 8), (3, 1), (3, 8), (2, 8), (6, 8))
ch = {0: 1, 3: 1, 2: 3, 6: 4}[kind]
stride = (w * ch * depth + 7) // 8; bpp = max(1, ch * depth // 8)
z = zlib.decompressobj(); raw = z.decompress(idat, h * (stride + 1) + 1)
assert len(raw) == h * (stride + 1)
out, prev = bytearray(), bytearray(stride)
for y in range(h):
    f, row = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
    for x in range(stride):
        a = row[x - bpp] if x >= bpp else 0; b = prev[x]; c = prev[x - bpp] if x >= bpp else 0
        if f == 1: row[x] = (row[x] + a) & 255
        elif f == 2: row[x] = (row[x] + b) & 255
        elif f == 3: row[x] = (row[x] + (a + b) // 2) & 255
        elif f == 4:
            p = a + b - c; pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
            row[x] = (row[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        else: assert f == 0
    prev = row
    for x in range(w):
        if depth == 1: v = (row[x >> 3] >> (7 - (x & 7))) & 1
        else: v = row[x * ch]
        if kind == 3:
            assert 3 * v + 3 <= len(plte)
            out += plte[3 * v:3 * v + 3] + bytes([trns[v] if trns and v < len(trns) else 255])
        elif kind == 0:
            g = v * 255 if depth == 1 else v
            out += bytes([g, g, g, 0 if trns and len(trns) == 2 and struct.unpack(">H", trns)[0] == v else 255])
        elif kind == 2:
            assert trns is None
            out += row[x * 3:x * 3 + 3] + b"\xff"
        else: out += row[x * 4:x * 4 + 4]
print(w, h, hashlib.sha256(out).hexdigest())
'
pixels() { timeout 20 python3 -I -c "$pixels_py" < "$1" 2> /dev/null; }

# qrdata FILE IMAGE: "FILE<TAB>address" if IMAGE is exactly the QR code of one address that
# qrencode makes (as ccs-front-bash does: qrencode -s 10 "monero:<address>"), pixel for pixel;
# else 1. zbarimg finding a good address isn't enough: the backend draws these, and one
# could hold a good QR code beside a piece of another.
qrdata() {
    local text ref got
    text=$(timeout 20 zbarimg -q --raw -- "$2" 2> /dev/null) || return 1
    [[ $text =~ ^monero:[1-9A-HJ-NP-Za-km-z]+$ && (${#text} == 102 || ${#text} == 113) ]] || return 1
    got=$(pixels "$2") && [[ $got ]] || return 1
    ref=$(qrencode -s 10 -o - -- "$text" | pixels /dev/stdin) && [[ $ref == "$got" ]] || return 1
    printf '%s\t%s\n' "$1" "${text#monero:}"
}

# json FILE...: each JSON file's strings as a reader of it gets them (\u escapes read, every key
# and value, a key twice both), their addresses as "file<TAB>address" lines, read as the pages'
# text is: a character that isn't ASCII dropped (it mustn't split an address), and again as a
# space (it mustn't join one to its neighbour); "file<TAB>!reason" if it isn't JSON.
json_py='
import json, re, sys
for f in sys.argv[1:]:
    seen = []
    def pairs(p):   # every pair as it is read, the same key twice too; what is left to walk: none
        for k, v in p: seen.append(k); walk(v)
        return {}
    def walk(v):
        if isinstance(v, str): seen.append(v)
        elif isinstance(v, list):
            for x in v: walk(x)
        elif isinstance(v, dict):
            for x in v.values(): walk(x)
    try:
        with open(f, "rb") as h: walk(json.loads(h.read(16 << 20).decode("utf-8"), object_pairs_hook=pairs))
    except Exception:
        print(f + "\t!not JSON (UTF-8) that reads"); continue
    out = set()
    for s in seen:
        s = re.sub(r"[\t\n\f\r]", " ", s); s = re.sub(r"[\x00-\x1f\x7f]", "", s)
        for t in (re.sub(r"[^\x00-\x7f]", "", s), re.sub(r"[^\x00-\x7f]", " ", s)):
            out.update(w for w in re.findall(r"[0-9A-Za-z]+", t) if len(w) in (95, 106) and not re.search(r"[0OIl]", w))
    for a in sorted(out): print(f + "\t" + a)
'

# pages SITE DESIGNS BODIES LIST VIEWKEY HOSTS < pages (NUL-separated, relative to SITE): each must
# be one of the design's own, every region filled with the design's parts and every {{slot}} with a
# value of its kind, as ccs-front-bash fills them; a proposal's text exactly what markdown.awk makes
# of its file. DESIGNS: unpacked release zips, ":"-separated (any one will do); BODIES: markdown.awk's
# lines, ":"-separated (one file per commit of the proposals, and markdown.awk); LIST: the signed list
# (its .pin beside it); VIEWKEY: its .viewkey or ""; HOSTS: where a link to a proposal may go.
# Prints "page<TAB>!reason". Python's standard library only.
pages_py='
import json, os, re, sys

site, designs, bodies, lst, viewkey, hosts = sys.argv[1:7]
B58 = "[1-9A-HJ-NP-Za-km-z]"
# escaped text (as ccs-bash and markdown.awk escape it): no markup, and no run of 90 base58
# characters, joined by characters that are not ASCII or not: it could be an address
TEXT = "(?:(?!(?:" + B58 + "[^\\x00-\\x7f]*){90})(?:[^<>\"\x27&\\x00-\\x1f\\x7f]|&(?:amp|lt|gt|quot|#39|apos);))*"
NAME = "(?:[^\"<>/&\\n]|&(?:amp|lt|gt|quot|#39|apos);)+"
NUM = "[0-9]+"
XMR = "[0-9]+(?:\\.[0-9]+)?"
DATE = "[A-Za-z0-9, ]*"
LINK = "https://(?:" + "|".join(re.escape(h) for h in hosts.split()) + ")/[^\\s\"\x27<>\\\\]*"

def read(p):
    with open(p, "rb") as f: return f.read().decode("utf-8")
def part(t): return t[:-1] if t.endswith("\n") else t      # as jq rtrimstr("\n")
def strip(t): return t.rstrip("\n")                         # $(cat FILE)
def prefix(depth): return "./" if depth == 0 else "../" * depth
def rel(t, depth):   # as relative_links in ccs-front-bash, a line at a time as sed
    return re.sub("((?:href|src)=\")/([^/\\n])", lambda m: m.group(1) + prefix(depth) + m.group(2), t)

# the main address and fingerprint of the signed list, as check_addresses shows them on Verify
main = next(l.split()[1] for l in read(lst).splitlines() if l.split()[:1] == ["0"])
fpr = next(l[4:].strip() for l in read(lst + ".pin").splitlines() if l.startswith("key "))
fpr = re.sub("^((.{4} ){5})", "\\1 ", re.sub(" $", "", re.sub("(.{4})", "\\1 ", fpr)))
net = " --testnet" if main[0] in "9A" else " --stagenet" if main[0] in "57" else ""

# the body of each proposal as markdown.awk renders it, from each commit: any of them will do
md = {}
for f in bodies.split(":"):
    if f and os.path.exists(f):
        for l in read(f).splitlines():
            if l: j = json.loads(l); md.setdefault(j["file"], set()).add(j["body"].replace("\x01", ""))

class Design:
    def __init__(self, d):
        self.d = d
        self.p = {f[:-5]: read(os.path.join(d, "parts", f)) for f in os.listdir(os.path.join(d, "parts")) if f.endswith(".html")}
    # the regex of a part: its literal text as it is, each {{slot}} by SLOTS (name: regex)
    def fill(self, text, slots):
        out, i = "", 0
        for m in re.finditer("\\{\\{([a-z_]+)\\}\\}", text):
            if m.group(1) not in slots: raise KeyError(m.group(1))
            out += re.escape(text[i:m.start()]) + "(?:" + slots[m.group(1)] + ")"; i = m.end()
        return out + re.escape(text[i:])
    def card(self, stage, depth, tagpage):
        c = part(self.p["card-" + stage])
        if tagpage: c = c.replace("=\"../", "=\"../../../")
        c = rel(c, depth)
        url = "#|" + re.escape(prefix(depth)) + "proposals/" + NAME + "\\.html|" + LINK
        seg = "(?:" + re.escape(part(self.p["segment-done"])) + "|" + re.escape(part(self.p["segment-todo"])) + ")*"
        label = self.fill(part(self.p["label"]), {"tag": TEXT, "color": "tag-[0-7]"})
        return self.fill(c, {"url": url, "name": TEXT, "author": TEXT, "date": DATE,
            "funding_note": "(?: · funding since " + DATE + ")?", "contributors": NUM, "amount": XMR, "raised": XMR,
            "percentage": NUM, "done": NUM, "milestones": NUM, "pending_note": "(?: · " + XMR + " XMR pending)?",
            "upvotes": NUM + "|–", "downvotes": NUM + "|–", "segments": seg, "tags": "(?:" + label + ")*"})
    def nav(self, depth):
        href = re.escape(prefix(depth)) + "explore/tag/[A-Za-z0-9%._~-]+/"
        f = self.fill(part(self.p["filter"]), {"tag": TEXT, "color": "tag-[0-7]", "href": href, "count": NUM, "active": "(?: active)?"})
        return "(?:" + self.fill(part(self.p["filters"]), {"filters": "(?:" + f + ")*"}) + ")?"
    def verify(self):
        f = strip(self.p["verify"])
        slots = {"address": re.escape(main), "fingerprint": re.escape(fpr), "network": re.escape(net),
                 "viewkey": "[0-9a-f]{64}", "wallet_source": "published by this site|<a href=\"https://[^\"<>\\s]+\">[A-Za-z0-9 .,:_&#;-]*</a>"}
        if viewkey:
            v = read(viewkey).splitlines()
            src = next((l.split(None, 1)[1].strip() for l in v if l.startswith("source ")), "")
            txt = next((l.split(None, 1)[1].strip() for l in v if l.startswith("source-text ")), "").replace("\x27", "&#39;")
            slots["viewkey"] = re.escape(v[0].replace(" ", ""))
            slots["wallet_source"] = re.escape("<a href=\"" + src.replace("&", "&amp;") + "\">" + (txt or "where they were published") + "</a>") if src else "published by this site"
        return self.fill(f, slots)
    # what region NAME may hold on a page DEPTH folders down
    def region(self, name, depth, tagpage, stage=None):
        kind, _, arg = name.partition(" ")
        if kind in ("count", "number"): return NUM
        if kind == "title": return TEXT
        if kind == "filters": return self.nav(depth)
        if kind == "verify": return self.verify()
        if kind == "list":
            c = self.card(arg, depth, tagpage)
            return "(?:" + c + "(?:\\n" + c + ")*|" + re.escape(part(self.p["empty"])) + ")?"
        if kind in ("donate", "funded"): return self.fill(part(self.p[kind]), self.slots(depth))
        if kind == "milestones":
            m = "(?:" + self.fill(part(self.p["milestone-done"]), {"name": TEXT, "funds": TEXT, "date": TEXT}) + "|" \
                + self.fill(part(self.p["milestone-todo"]), {"name": TEXT, "funds": TEXT}) + ")"
            return m + "(?:\\n" + m + ")*|" + re.escape(part(self.p["no-milestones"]))
        if kind == "payouts":
            m = self.fill(part(self.p["payout"]), {"amount": TEXT, "date": TEXT})
            return m + "(?:\\n" + m + ")*|" + re.escape(part(self.p["no-payouts"]))
        raise KeyError(name)
    def slots(self, depth, body=None):
        seg = "(?:" + re.escape(part(self.p["segment-done"])) + "|" + re.escape(part(self.p["segment-todo"])) + ")*"
        href = re.escape(prefix(depth)) + "explore/tag/[A-Za-z0-9%._~-]+/"
        s = {"name": TEXT, "author": TEXT, "date": DATE, "funding_note": "(?: · funding since " + DATE + ")?",
             "contributors": NUM, "amount": XMR, "raised": XMR, "percentage": NUM, "done": NUM, "milestones": NUM,
             "pending_note": "(?: · " + XMR + " XMR pending)?", "gitlab_url": "#|" + LINK, "segments": seg,
             "address": B58 + "{95}", "qr": "data:image/png;base64,[A-Za-z0-9+/]+=*",
             "verify_link": re.escape(strip(self.p["verify-link"])), "milestones_list": "", "payouts_list": "",
             "tag_links": "(?:" + self.fill(part(self.p["label-link"]), {"tag": TEXT, "color": "tag-[0-7]", "href": href}) + ")*"}
        if body: s["body"] = "(?P<body>.*?)"   # compared with the repository after (one regex for every page)
        return s
    # the regex of a page: its literal text, the regions as above, the slots (on a proposal page)
    def page(self, text, depth, tagpage, body=False):
        out, i = [], 0
        for m in re.finditer("<!-- ccs:([a-z]+(?: [a-z]+)?) -->", text):
            end = "<!-- /ccs:" + m.group(1) + " -->"
            j = text.index(end, m.end())
            out.append(self.fill(rel(text[i:m.start()], depth), self.slots(depth, body)) if body else re.escape(rel(text[i:m.start()], depth)))
            out.append(re.escape(m.group(0)) + "\\n*(?:" + self.region(m.group(1), depth, tagpage) + ")\\n*" + re.escape(end))
            i = j + len(end)
        rest = rel(text[i:], depth)
        out.append(self.fill(rest, self.slots(depth, body)) if body else re.escape(rest))
        return out

cache, diag = {}, [10]
def compiled(d, key, text, depth, tagpage, body=False):
    k = (d.d, key, depth, tagpage)
    if k not in cache:
        segs = d.page(text, depth, tagpage, body)
        cache[k] = (re.compile("".join(segs), re.S), segs)
    return cache[k]

def check(rp, got, d):
    depth, want = rp.count("/"), None
    if rp.startswith("proposals/"):
        name = rp[len("proposals/"):-len(".html")]
        if "/" in name: return "a page the design does not have"
        if name not in md: return "a proposal page with no proposal (" + name + ".md) in the proposals repository"
        # pages.jq prints the page, jq -r a newline after it, which the split keeps
        want = {rel(b, depth) for b in md[name]}
        tries = [compiled(d, "proposal-" + s, d.p["proposal-" + s] + "\n", depth, False, True) for s in ("fr", "wip", "cp")]
    elif re.match("explore/tag/[^/]+/index\\.html$", rp):
        tries = [compiled(d, "tag", read(os.path.join(d.d, "explore/tag/example/index.html")), depth, True)]
    elif not rp.startswith(("parts/", "explore/tag/")) and os.path.isfile(os.path.join(d.d, rp)):
        tries = [compiled(d, rp, read(os.path.join(d.d, rp)), depth, False)]
    else: return "a page the design does not have"
    best, why = 0, "not a page of the design as ccs-front-bash fills it"
    for rx, segs in tries:
        m = rx.fullmatch(got)
        if m and (m.groupdict().get("body") is None or m.group("body") in want): return None
        if m:   # the page of the design, but another text than the proposal has in the repository
            best, why = m.start("body"), "not the text of its proposal as the proposals repository has it"; continue
        if diag[0] <= 0: continue
        for k in range(len(segs), 0, -1):   # how far it is the design, for the reason (10 pages)
            m = re.match("".join(segs[:k]), got, re.S)
            if m: best = max(best, m.end()); break
    diag[0] -= 1
    return why + (" (it differs at character %d: %s)" % (best, json.dumps(got[best:best + 60])) if diag[0] >= 0 else "")

ds = [Design(d) for d in designs.split(":") if d]
for rp in sys.stdin.read().split("\0"):
    if not rp: continue
    try: got = read(os.path.join(site, rp))
    except Exception: print(os.path.join(site, rp) + "\t!a page that is not UTF-8"); continue
    why = None
    for d in ds:
        try: why = check(rp, got, d)
        except KeyError as e: why = "the design has no part or slot " + str(e)
        if why is None: break
    if why: print(os.path.join(site, rp) + "\t!" + why)
'

# scan FILE...: the addresses (and reasons) of the pages and JSON among FILEs; every data:
# image exactly the QR code of an address
scan() {
    local file tag payload png jsons=()
    png=$(mktemp)
    # a NUL byte: HTML drops it from the text, so it could split an address
    printf '%s\0' "$@" | grep -zE '\.(html|json)$' | xargs -0 -r grep -laP '\x00' -- | sed 's/$/\t!a NUL byte (a browser drops it from the text)/'
    # the JSON, as JSON (its \u escapes are an address's characters to whoever reads it)
    mapfile -d '' jsons < <(printf '%s\0' "$@" | grep -zE '\.json$')
    if ((${#jsons[@]})); then
        timeout 60 python3 -I -c "$json_py" "${jsons[@]}" || printf '%s\t!the JSON could not be read in time\n' "${jsons[@]}"
    fi
    printf '%s\0' "$@" | grep -zE '\.(html|json)$' | xargs -0 -r awk "$scan_awk" \
        | while IFS=$'\t' read -r file tag payload; do
            if [[ $tag != '?qr' ]]; then printf '%s\t%s\n' "$file" "$tag"; continue; fi
            if ! base64 -d <<<"$payload" > "$png" 2> /dev/null || ! qrdata "$file" "$png"; then
                printf '%s\t%s\n' "$file" "!an image that is not exactly qrencode's QR code of one address"
            fi
        done
    rm -f "$png"
}

# fetch: the proposals repository (/etc/ccs-gate/proposals.conf: PROPOSALS_GIT, its URL;
# PROPOSALS_BRANCH, default master), fetched each push, its last two commits (the backend's
# checkout may be one behind or ahead). Reviewed and merged: what a page says a proposal says, and
# the images it may show, come from here, not from the backend. Can't be fetched (disroot's Forgejo
# breaks off now and then): the last fetch is used, and said so. Sets hosts: where a link to a
# proposal may go (the repository's host, and proposals.conf's LINK_HOSTS: the old forge's, say).
git=$state/proposals.git hosts=''
fetch() {
    local url='' branch=master k v h
    [[ -r $conf/proposals.conf ]] || return 1
    while IFS='=' read -r k v; do
        case $k in PROPOSALS_GIT) url=$v ;; PROPOSALS_BRANCH) branch=$v ;; LINK_HOSTS) hosts=$v ;; esac
    done < <(grep -E '^(PROPOSALS_GIT|PROPOSALS_BRANCH|LINK_HOSTS)=' "$conf/proposals.conf")
    [[ $url ]] || return 1
    if [[ $url == https://* ]]; then h=${url#https://}; h=${h%%/*}; hosts="${h##*@} $hosts"; fi
    [[ -d $git ]] || git init -q --bare "$git" || return 1
    GIT_TERMINAL_PROMPT=0 timeout 60 git -C "$git" fetch -q --no-tags --depth=2 "$url" "+refs/heads/$branch:refs/heads/ccs" 2> /dev/null \
        || say "could not fetch the proposals repository (proposals.conf): checking against the last fetch"
    git -C "$git" rev-parse -q --verify refs/heads/ccs > /dev/null
}

# repo_images: "blob path" for each proposal image in the fetched repository, as git ls-tree has
# them: a backend that isn't the one it was can't add an image of its own (a QR code cut into
# pieces, shown side by side, that zbarimg reads in none of them)
repo_images() {
    git -C "$git" ls-tree -r refs/heads/ccs -- images/ | awk -F '\t' '{ split($1, m, " ") } m[2] == "blob" { print m[3] " " $2 }'
}

# bodies: one file of markdown.awk's lines (each proposal's text as HTML) per commit fetched and
# markdown.awk installed (markdown*.awk, from the ccs-front-bash release the backend runs; two
# while it switches), ":"-separated; kept by commit, so a push made again needs no rendering. The
# images it shows, as ccs-bash copies them: images/<proposal>/<file>, a plain file, 2 MB at most,
# a PNG, JPEG or GIF by its first bytes.
bodies() {
    local rev c awkf sum out d list='' a f m
    for rev in refs/heads/ccs refs/heads/ccs~1; do
        c=$(git -C "$git" rev-parse -q --verify "$rev^{commit}" 2> /dev/null) || continue
        for awkf in "$conf"/markdown*.awk; do
            [[ -f $awkf ]] || continue
            sum=$(sha256sum < "$awkf" | cut -c1-16)
            out=$state/bodies-$c-$sum.jsonl
            if [[ ! -s $out ]]; then
                d=$(mktemp -d)
                git -C "$git" archive "$c" | tar -x -C "$d" 2> /dev/null || true
                (cd "$d" && find images -mindepth 2 -maxdepth 2 -type f 2> /dev/null) | while IFS= read -r a; do
                    [[ $a =~ ^images/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\.(png|jpg|jpeg|gif)$ ]] || continue
                    f=$d/$a
                    (($(wc -c < "$f") <= 2097152)) || continue
                    m=$(head -c 8 "$f" | od -An -tx1 | tr -d ' \n')
                    [[ $m == 89504e470d0a1a0a || $m == ffd8ff* || $m == 4749463837* || $m == 4749463839* ]] || continue
                    printf '%s\t%s\n' "$a" "${a#images/}"
                done > "$d/.images"
                find "$d" -maxdepth 1 -type f -name '*.md' -print0 \
                    | xargs -0 -r timeout 120 awk -v images="$d/.images" -f "$awkf" > "$out.tmp" && mv "$out.tmp" "$out"
                rm -rf "$d" "$out.tmp"
            fi
            [[ -s $out ]] && touch "$out" && list+=${list:+:}$out
        done
    done
    # the commits fetched before (not used for an hour): their files go
    find "$state" -maxdepth 1 -name 'bodies-*.jsonl' -mmin +60 -delete 2> /dev/null || true
    printf '%s' "$list"
}

# pages: every page in staging as pages_py checks it ("page<TAB>!reason")
pages() {
    local designs='' d b vk=''
    for d in "$conf"/design/*/; do [[ -d $d/parts ]] && designs+=${designs:+:}${d%/}; done
    b=$(bodies)
    [[ -f $list.viewkey ]] && vk=$list.viewkey
    (cd "$staging" && find . -type f -name '*.html' -printf '%P\0') \
        | timeout 300 python3 -I -c "$pages_py" "$staging" "$designs" "$b" "$list" "$vk" "$hosts" \
        || printf '%s\t%s\n' "$staging/index.html" "!the pages could not be checked in time"
}

# changes: every file the push brings that isn't already live, byte for byte, as "file<TAB>!reason"
# for any that isn't allowed, and "file<TAB>address" for the addresses in a proposal image's QR codes
changes() {
    local f rel sum repo=''
    [[ $fetched ]] && repo=$(repo_images)
    while IFS= read -r -d '' f; do
        rel=${f#"$staging"/}
        cmp -s "$f" "$live/$rel" 2> /dev/null && continue
        case $rel in
            *.html | projects.json) ;;   # the pages and the /projects JSON: checked, all of them
            subaddresses.txt | subaddresses.txt.asc | subaddresses.txt.key.asc)
                cmp -s "$f" "$conf/$rel" || printf '%s\t%s\n' "$f" "!not the $rel installed in $conf" ;;
            images/*/*)
                if [[ ! $rel =~ ^images/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\.(png|jpg|jpeg|gif)$ ]]; then
                    printf '%s\t%s\n' "$f" "!not a proposal image (images/<proposal>/<file>.png|jpg|jpeg|gif)"
                elif [[ ! $fetched ]]; then
                    printf '%s\t%s\n' "$f" "!a new image, and the proposals repository could not be read to check it"
                elif ! grep -qxF "$(git hash-object --no-filters -- "$f") $rel" <<<"$repo"; then
                    printf '%s\t%s\n' "$f" "!not the proposals repository's $rel"
                else
                    qr "$f" "$f" || true
                fi ;;
            *)
                sum=$(sha256sum < "$f" | cut -d' ' -f1)
                grep -qxF "$sum $rel" "$design" || printf '%s\t%s\n' "$f" "!not the design's (design.sha256)" ;;
        esac
    done < <(find "$staging" -type f -print0)
}

# ccs-receive --heartbeat, from a timer every 5 minutes as ccs-data (the backend's key can't pass
# arguments: its command= is fixed). Each push that arrives is the backend's heartbeat, every
# 2 minutes. None for HEARTBEAT_MINUTES (alert.conf, default 15) is an alert: the backend is off, its
# cron stopped, its key or network broken, which nothing on the backend can report itself. Not
# without a first push (nothing known yet), not while this machine has been up less than that (no
# push could arrive while it was down), and only on the second late check in a row, so pushes
# resuming after this machine's own network outage come first. Then once an hour at most, and a
# line when pushes arrive again.
heartbeat() {
    local d=$state minutes age up
    minutes=$(sed -n 's/^HEARTBEAT_MINUTES=\([1-9][0-9]*\)$/\1/p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    minutes=${minutes:-15}
    [[ -f $d/last-push ]] || return 0
    age=$((($(date +%s) - $(stat -c %Y "$d/last-push")) / 60))
    if ((age < minutes)); then
        rm -f "$d/heartbeat-late"
        if [[ -f $d/heartbeat-alerted ]]; then
            rm -f "$d/heartbeat-alerted"
            say "pushes from the backend arrive again"
            alert heartbeat-ok "pushes from the backend arrive again @ @SITE@"
        fi
        return 0
    fi
    up=$(($(cut -d. -f1 /proc/uptime) / 60))
    ((up >= minutes)) || return 0
    [[ -f $d/heartbeat-late ]] || { touch "$d/heartbeat-late"; return 0; }
    say "no push from the backend for $age minutes"
    alert heartbeat "no push from the backend for $age minutes: is it running? (its cron, its push key, its network) @ @SITE@"
    touch "$d/heartbeat-alerted"
}

if [[ ${1:-} == --heartbeat ]]; then heartbeat; exit 0; fi

# One push at a time: two at once would share the staging folder, and one could change it after
# the other's checks, before its copy into the live site.
exec 8> "$state/lock"
flock -w 600 8 || { say "refused the push: another one is still going after 10 minutes"; exit 1; }

# Staging starts as the live site each time: the push account can't delete, so whatever a
# refused push left in it would otherwise stay there and refuse every push after it.
rsync -a --delete "$live/" "$staging/"
rrsync -wo -no-del -munge "$staging"
touch "$state/last-push" 2> /dev/null || true   # the backend's heartbeat (--heartbeat)

# the list and its pin, as ccs-front-bash has them (tools/sign-subaddresses.sh: "sha256 <hex>")
list=$conf/subaddresses.txt
[[ -f $list && $(sha256sum < "$list" | cut -d' ' -f1) == "$(sed -n 's/^sha256 *//p' "$list.pin" 2> /dev/null)" ]] \
    || refuse "$list is not the list $list.pin names" list "its signed list isn't the one its .pin names"
command -v qrencode > /dev/null || refuse "it has no qrencode to check the QR codes with (apt install qrencode)" qrencode
command -v python3 > /dev/null || refuse "it has no python3 to check the pages with" python3
command -v git > /dev/null || refuse "it has no git to read the proposals repository with (apt install git)" git
command -v zbarimg > /dev/null || refuse "it has no zbarimg to read the QR codes with (apt install zbar-tools)" zbarimg
# the design's files, "sha256  path" as sha256sum writes them (./ and binary-mode * dropped);
# several releases' may be in it
[[ -s $conf/design.sha256 ]] || refuse "it has no $conf/design.sha256 (the design release's files)" design
# the design's pages and parts (its release zip, unpacked in design/<release>/), and the
# markdown.awk that fills a proposal's text (ccs-front-bash's): several releases' while switching
compgen -G "$conf/design/*/parts/proposal-fr.html" > /dev/null || refuse "it has no $conf/design/<release>/ (the design's release zip, unpacked)" designs
[[ -r $conf/proposals.conf ]] || refuse "it has no $conf/proposals.conf (the proposals repository, for their text and images)" proposals
compgen -G "$conf/markdown*.awk" > /dev/null || refuse "it has no $conf/markdown.awk (ccs-front-bash's lib/markdown.awk)" markdown
design=$(mktemp)
trap 'rm -f "$design"' EXIT
sed -nE 's#^([0-9a-f]{64}) [ *](\./)?(.+)$#\1 \3#p' "$conf/design.sha256" > "$design"
# the checks below list files one a line, tab-separated: a name with a newline or tab can't be held back
if find "$staging" -name '*[[:cntrl:]]*' | grep -q .; then refuse "a file name with a control character in it" names; fi
fetched=''
fetch && fetched=1

# the list's addresses, then the allowed file's (first word of each line; # comments)
mapfile -d '' files < <(find "$staging" -type f \( -name '*.html' -o -name '*.json' \) -print0)
bad=$( { scan "${files[@]}"; pages; changes; } | awk -F '\t' 'NR == FNR { if ($1 !~ /^#/ && NF) ok[$1] = 1; next } !($2 in ok)' \
    <(cut -d' ' -f2 "$list"; awk '{ print $1 }' "$conf/allowed" 2> /dev/null) - | sort -u)
# The rest of the push goes live; a file that fails keeps its last good copy (a new one stays
# out): one bad page doesn't stop the site updating, and nothing here rewrites a file. The push
# still fails, so the backend's log shows it.
if [[ $bad ]]; then
    # out of staging, so the copy below leaves the live one as it is. Not rsync exclude patterns:
    # a pattern without wildcards reads a backslash as itself, so an escaped name never matched
    nheld=0
    while IFS= read -r file; do
        [[ $file == "$staging"/* ]] || continue
        rm -f -- "$file"
        nheld=$((nheld + 1))
    done < <(cut -f1 <<<"$bad" | sort -u)
    say "held back $nheld file(s), with an address that isn't the wallet's nor allowed, or not allowed here; the rest goes live"
    while IFS=$'\t' read -r file addr; do say "  ${file#"$staging"/}: $addr"; done < <(head -n 10 <<<"$bad")
    n=0
    while IFS=$'\t' read -r file addr; do
        ((n++ < 3)) || break
        if [[ $addr == '!'* ]]; then
            alert "file-${file#"$staging"/}" "the web server held back a file: ${addr#!} (its last good copy stays) @ @SITE@/${file#"$staging"/}"
        else
            alert "addr-$addr" "the web server held back a page: donation address $red${addr:0:6}…${addr: -4}$off is not in the signed list (its last good copy stays) @ @SITE@/${file#"$staging"/}"
        fi
    done < <(awk -F '\t' '$1 ~ /\.html$/' <<<"$bad"; awk -F '\t' '$1 !~ /\.html$/' <<<"$bad")   # a page before the rest
fi
rsync -a --delay-updates "$staging/" "$live/"
# 7 (which rsync never uses, and passes on): it went live but for the files held back, so the
# backend's ccs-watch still checks the live pages; a refused push is 1
[[ ! $bad ]] || exit 7
