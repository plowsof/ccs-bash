#!/bin/bash
# ccs-receive: the web server's gate (docs/two-machines.md, "The gate"). The backend's push key runs
# only this (command= in authorized_keys). The push is site-data.json alone (contrib/ccs-push: a
# tar, read by Go, ccs-check receive): what only the backend knows, each proposal's subaddress
# index, dates and funds, and the ideas. The gate checks it (ccs-check data: every value of its
# kind, each index the signed list's and the one the live site has for its proposal), then builds
# the site itself (ccs-gate-build: ccs-bash's site.jq and the vendored ccs-front-bash) from it,
# the proposals repository fetched here (each proposal's text, front matter, images and merge
# request), the design (design/vX.Y.Z/, installed here by hand) and the signed list (its QR
# codes too, subaddresses.txt.qr/), and checks what it built (ccs-check gate):
#   - every Monero address in the pages and JSON one of the wallet's (the signed list and its
#     .pin, installed here by hand) or in the allowed file, none in the feed, and no data: image
#     nor NUL byte at all: the backstop for an address in a proposal's own text;
#   - every QR code, qr/<address>.png, exactly the list's file of that address (its sum in the
#     list's .qr.sha256, pinned in its .pin).
# The site goes live (ccs-check copy --delete: what the build no longer has goes too), but a file
# that fails: that one is taken off the site, and IRC is told (alert.conf). More than
# CCS_GATE_REMOVE (3) pages leaving the site at once (failed, or proposals gone from the
# repository: a branch emptied, a forge answering wrong, a backend hiding them): none of it goes
# live, and IRC is told: a person decides (troubleshooting.md: the file /var/lib/ccs-gate/allow-remove
# lets them go, for one build). A site-data.json that fails, a
# build that fails, or a list, QR codes' sums, design or repository missing: nothing goes live,
# the live site stays. The backend is told on stderr; exit 0, or 1. Needs bash, busybox's applets
# (container/gate-busybox-applets), curl, git, jq, ccs-gate-build and ccs-check (contrib/ccs-check:
# the checks in Go, one static binary: it also receives the push, and copies the site live).
# Root-owned, 755.
set -euo pipefail
# (no home of the account's: git, curl and bash read no config from there, whatever passwd says)
export LC_ALL=C HOME=/nonexistent GIT_CONFIG_NOSYSTEM=1
staging=/var/lib/ccs-staging live=/var/lib/ccs-data conf=/etc/ccs-gate state=/var/lib/ccs-gate

# The reason goes to the web server's journal (and /var/log/ccs-gate.log, if ccs-data may write
# it), and to the backend (stderr, its ssh channel).
# alert KEY MESSAGE: also to IRC (/etc/ccs-gate/alert.conf: ALERT_URL, SITE_URL), at most once an
# hour per KEY: a taken-over backend retrying every two minutes mustn't flood the channel. Here
# is where a bad push is seen even when the backend is the one lying. Sets sent=1 when it posts.
alert() {
    local url='' site='' k v stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    sent=''
    [[ -r $conf/alert.conf ]] || return 0
    while IFS='=' read -r k v; do
        case $k in ALERT_URL) url=$v ;; SITE_URL) site=$v ;; esac
    done < <(grep -E '^(ALERT_URL|SITE_URL)=' "$conf/alert.conf")
    [[ $url ]] || return 0
    if [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]]; then return 0; fi
    touch "$stamp" 2> /dev/null || true
    sent=1
    # no whole address in the channel, whatever a reason quotes (a file's name, a page's): a run of
    # 20 base58 characters or more shortened as the address alerts are (review 10's L-1), the
    # message 500 characters at most
    local msg
    msg=$(sed -E 's/([1-9A-HJ-NP-Za-km-z]{6})[1-9A-HJ-NP-Za-km-z]{10,}([1-9A-HJ-NP-Za-km-z]{4})/\1…\2/g' <<<"$2" | head -c 500)
    curl -fsS --max-time 10 --data-binary "[${blue}CCS-watch${off}] ${msg//@SITE@/${site:-}}" -H 'Content-Type: text/plain' "$url" > /dev/null 2>&1 \
        || say "could not send the alert"
}

blue=$'\x0312' red=$'\x0304' off=$'\x03'   # IRC colours, as ccs-watch's

say() {
    logger -t ccs-gate -- "$*" 2> /dev/null || true
    printf '%s %s\n' "$(date -u '+%F %T')" "$*" 2> /dev/null >> /var/log/ccs-gate.log || true   # 2> first: it also hides a log it can't open
    # stderr is the backend's ssh channel: if the backend hung up, writing to it kills the writer
    # (SIGPIPE), so a subshell writes it, and the gate goes on to alert
    (printf 'ccs-gate: %s\n' "$*" >&2) || true
}

# refuse WHY KEY [WHY_FOR_IRC]: nothing goes live (the live site stays as it is)
refuse() {
    say "refused the push: $1"
    alert "$2" "the web server refuses every push: ${3:-$1}"
    exit 1
}

# fetch: the proposals repository (/etc/ccs-gate/proposals.conf: PROPOSALS_GIT, its URL;
# PROPOSALS_BRANCH, default master), fetched each push, all of its history (about 3 MB: each
# proposal's merge request is read from it). Reviewed and merged: what a page says a proposal
# says, and the images it shows, come from here, not from the backend. Can't be fetched
# (disroot's Forgejo breaks off now and then): the last fetch is used, and said so. Sets hosts:
# where a link to a merge request may go: under the repository's own address (host and path: the
# forge's other users' pages are anyone's), and proposals.conf's LINK_HOSTS (the old forge's
# repository, host/path); and mrs, where each proposal's merge request is (MERGE_REQUESTS:
# https://host, the forge whose "See merge request <project>!N" its merge commits end with;
# none: no links), linked only for a project hosts names (MERGE_REQUESTS' host and that path).
git=$state/proposals.git hosts='' mrs=''
fetch() {
    local url='' branch=master k v h deepen=()
    [[ -r $conf/proposals.conf ]] || return 1
    while IFS='=' read -r k v; do
        case $k in PROPOSALS_GIT) url=$v ;; PROPOSALS_BRANCH) branch=$v ;; LINK_HOSTS) hosts=$v ;; MERGE_REQUESTS) mrs=$v ;; esac
    done < <(grep -E '^(PROPOSALS_GIT|PROPOSALS_BRANCH|LINK_HOSTS|MERGE_REQUESTS)=' "$conf/proposals.conf")
    [[ $url ]] || return 1
    [[ $mrs =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || mrs=''
    if [[ $url == https://* ]]; then
        h=${url#https://}; h=${h%/}; h=${h%.git}
        if [[ $h == */* ]]; then k=${h%%/*}; h=${k##*@}/${h#*/}; else h=${h##*@}; fi
        hosts="$h $hosts"
    fi
    [[ -d $git ]] || git init -q --bare "$git" || return 1
    # (fetched two commits deep before: all of it now)
    [[ $(git -C "$git" rev-parse --is-shallow-repository 2> /dev/null) != true ]] || deepen=(--unshallow)
    if GIT_TERMINAL_PROMPT=0 timeout 120 git -C "$git" fetch -q --no-tags "${deepen[@]}" "$url" "+refs/heads/$branch:refs/heads/ccs" 2> /dev/null; then
        forge_up
    else
        say "could not fetch the proposals repository (proposals.conf): building from the last fetch"
        forge_down
    fi
    git -C "$git" rev-parse -q --verify refs/heads/ccs > /dev/null
}

# forge_down: no good fetch ($state/fetch-ok, from forge_up: git rewrites FETCH_HEAD even when a
# fetch fails) for FORGE_HOURS (alert.conf, default 6) is an alert: a proposal merged or changed
# since can't go live. Once an hour while it lasts; forge_up says when it answers again. No
# fetch-ok yet: nothing known.
forge_down() {
    local hours t
    hours=$(sed -n 's/^FORGE_HOURS=\([1-9][0-9]*\)$/\1/p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    hours=${hours:-6}
    t=$(stat -c %Y "$state/fetch-ok" 2> /dev/null) || return 0
    (($(date +%s) - t >= hours * 3600)) || return 0
    touch "$state/forge-down" 2> /dev/null || true
    alert forge "the web server can't fetch the proposals repository since $(date -u -d "@$t" '+%F %H:%M UTC') (proposals.conf): a proposal merged or changed since can't go live @ @SITE@"
}
forge_up() {
    touch "$state/fetch-ok" 2> /dev/null || true
    [[ -f $state/forge-down ]] || return 0
    rm -f "$state/forge-down"
    say "the proposals repository can be fetched again"
    alert forge-ok "the web server fetches the proposals repository again @ @SITE@"
}

# ccs-receive --heartbeat, from a timer every 5 minutes as ccs-data (the backend's key can't pass
# arguments: its command= is fixed). Each push that arrives is the backend's heartbeat, every
# 2 minutes. None for HEARTBEAT_MINUTES (alert.conf, default 15) is an alert: the backend is off, its
# cron stopped, its key or network broken, which nothing on the backend can report itself. Not
# without a first push (nothing known yet), not while this machine has been up less than that (no
# push could arrive while it was down), and only on the second late check in a row, so pushes
# resuming after this machine's own network outage come first. Then once an hour at most, and a
# line when pushes arrive again.
heartbeat() {
    local d=$state minutes age up
    minutes=$(sed -n 's/^HEARTBEAT_MINUTES=\([1-9][0-9]*\)$/\1/p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    minutes=${minutes:-15}
    [[ -f $d/last-push ]] || return 0
    age=$((($(date +%s) - $(stat -c %Y "$d/last-push")) / 60))
    if ((age < minutes)); then
        rm -f "$d/heartbeat-late"
        if [[ -f $d/heartbeat-alerted ]]; then
            rm -f "$d/heartbeat-alerted"
            say "pushes from the backend arrive again"
            alert heartbeat-ok "pushes from the backend arrive again @ @SITE@"
        fi
        return 0
    fi
    up=$(($(cut -d. -f1 /proc/uptime) / 60))
    ((up >= minutes)) || return 0
    [[ -f $d/heartbeat-late ]] || { touch "$d/heartbeat-late"; return 0; }
    say "no push from the backend for $age minutes"
    alert heartbeat "no push from the backend for $age minutes: is it running? (its loop, its push key, its network) @ @SITE@"
    touch "$d/heartbeat-alerted"
}

if [[ ${1:-} == --heartbeat ]]; then heartbeat; exit 0; fi

# One push at a time: two at once would share the staging folder, and one could change it after
# the other's checks, before its copy into the live site.
exec 8> "$state/lock"
# (flock on the open file: the lock outlives flock, as long as fd 8 is open; busybox's has no -w)
if ! timeout 600 flock 8; then
    say "refused the push: another one is still going after 10 minutes"
    alert lock "a push has been checked for over 10 minutes: the pushes after it are refused (the heartbeat would only say none arrived); look at what the gate is doing"
    exit 1
fi

# (before the push is received: ccs-check receives it too)
if ! command -v ccs-check > /dev/null || ! ccs-check --check > /dev/null 2>&1; then
    refuse "it has no ccs-check (contrib/ccs-check: the release's, its sha256 attested) to check the push with" ccs-check
fi
# only the backend's push (contrib/ccs-push asks for "receive"), nothing else: a shell, scp,
# rsync or anything a stolen key asks for is refused before anything is read
if [[ ${SSH_ORIGINAL_COMMAND:-receive} != receive ]]; then
    say "refused: not a push (the key asked for something else)"
    exit 1
fi
# staging empty each time: the push in push/, the site built in site/
find "$staging" -mindepth 1 -delete
mkdir "$staging/push"
# the push: a tar of plain files and folders, read by Go (ccs-check receive, contrib/ccs-check/push):
# a link, a device, a path out of staging, a name twice, or past its limits (512 MB, 64 MB a file,
# 100,000 files) refuses all of it, and so does one not received in 5 minutes
if ! why=$(timeout 300 ccs-check receive "$staging/push" 2>&1); then
    why=${why#ccs-check receive: refused: }
    say "refused the push: ${why:-it was not received in time}"
    alert receive "the web server refused a push it could not take: ${why:-not received in time} @ @SITE@"
    exit 1
fi
touch "$state/last-push" 2> /dev/null || true   # the backend's heartbeat (--heartbeat)
# site-data.json alone (none: it didn't change, and the live site's is built from)
other=$(cd "$staging/push" && find . -type f ! -path ./site-data.json | head -n 3)
[[ ! $other ]] || refuse "it sent other files than site-data.json (${other//$'\n'/, })" push "a push with other files than site-data.json"
data=$staging/push/site-data.json
[[ -f $data ]] || data=$live/site-data.json

# the list and its pin, as ccs-front-bash has them (tools/sign-subaddresses.sh: "sha256 <hex>")
list=$conf/subaddresses.txt
[[ -f $list && $(sha256sum < "$list" | cut -d' ' -f1) == "$(sed -n 's/^sha256 *//p' "$list.pin" 2> /dev/null)" ]] \
    || refuse "$list is not the list $list.pin names" list "its signed list isn't the one its .pin names"
# and it has addresses (each line's second word): a pinned empty list would leave the gate
# nothing to hold an address against (review 11's I-1)
awk '$2 ~ /^[1-9A-HJ-NP-Za-km-z]+$/ && length($2) == 95 { n++ } END { exit !n }' "$list" \
    || refuse "$list has no addresses" list "its signed list has no addresses"
# its QR codes' sums (tools/make-qr.sh), the .pin's qr line: what a qr/<address>.png must be;
# the QR codes themselves, the list's files (installed beside it, subaddresses.txt.qr/)
[[ -f $list.qr.sha256 && $(sha256sum < "$list.qr.sha256" | cut -d' ' -f1) == "$(sed -n 's/^qr *//p' "$list.pin" 2> /dev/null)" ]] \
    || refuse "$list.qr.sha256 is not the QR codes' sums $list.pin names (its qr line)" qrsums "its signed list's QR codes' sums aren't the ones its .pin names"
[[ -d $list.qr ]] || refuse "it has no $list.qr/ (the signed list's QR codes)" qr
command -v git > /dev/null || refuse "it has no git to read the proposals repository with" git
command -v ccs-gate-build > /dev/null || refuse "it has no ccs-gate-build (in the gate's image) to build the site with" build-missing
# the design's newest release (design/vX.Y.Z/, its release zip unpacked: a v0.1.25-rc1/, or a
# build of no release left there, isn't one)
design=$(for d in "$conf"/design/v*/; do d=${d%/}; if [[ $d =~ /v[0-9]+\.[0-9]+\.[0-9]+$ && -f $d/parts/proposal-fr.html ]]; then echo "$d"; fi; done \
    | awk -F/v '{ split($NF, n, "."); k = (n[1] * 1000 + n[2]) * 1000 + n[3]; if (k >= m) { m = k; d = $0 } } END { print d }')
[[ $design ]] || refuse "it has no $conf/design/<release>/ (the design's release zip, unpacked: v0.1.29, say)" designs
fetch || refuse "it can't read the proposals repository ($conf/proposals.conf)" proposals
[[ -f $data ]] || { say "no site-data.json yet: nothing to build"; exit 0; }
onion=$(tr -d ' \n' 2> /dev/null < "$conf/onion") || onion=''
[[ $onion =~ ^[a-z2-7]{56}\.onion$ ]] || onion=
site=$(sed -n 's/^SITE_URL=//p' "$conf/alert.conf" 2> /dev/null | tail -n 1)

# Built again only when what it's built from changed (site-data.json, the list, its QR codes,
# allowed, the design, the repository's commit, this gate), and once a day whatever happens: the
# live site is the last build that went live, and the same inputs build the same site.
inputs=$( {
    cat -- "${BASH_SOURCE[0]}" "$data" "$list" "$list.pin" "$list.qr.sha256" "$conf/proposals.conf"
    cat -- "$conf/allowed" "$list.viewkey" "$conf/onion" 2> /dev/null || true
    grep '^SITE_URL=' "$conf/alert.conf" 2> /dev/null || true
    for d in "$design" "$list.qr" /usr/local/lib/ccs-gate; do (cd "$d" 2> /dev/null && find . -type f -print0 | sort -z | xargs -0 -r sha256sum); done
    git -C "$git" rev-parse -q --verify refs/heads/ccs 2> /dev/null || true
    cat -- "$(command -v ccs-check)"
} | sha256sum | cut -c1-64)
if [[ $inputs == "$(cat "$state/built-with" 2> /dev/null)" && $(find "$state/built-with" -mmin -1440 2> /dev/null) ]]; then
    exit 0
fi

# site-data.json: every value of its kind (ccs-check data), checked against the repository's
# proposals (its last two commits: the backend's checkout may be one behind or ahead) and the
# live site's addresses
props=$staging/proposals
for rev in refs/heads/ccs refs/heads/ccs~1; do
    git -C "$git" rev-parse -q --verify "$rev^{commit}" > /dev/null || continue
    git -C "$git" -c core.quotePath=false ls-tree --name-only "$rev" | grep '\.md$' || true
done | sort -u > "$props"
if ! why=$(timeout 60 ccs-check data "$data" "$list" "$props" "$hosts" "$live"); then
    say "site-data.json held back (${why:-not checked}): the live site stays as it is"
    alert data "the web server held back the backend's site-data.json: ${why:-not checked} (the live site stays as it is) @ @SITE@"
    exit 1
fi

# the site, built here (ccs-gate-build: lib/site-data.sh's site_from_data and the vendored
# ccs-front-bash)
if ! DATA=$data GIT=$git DESIGN=$design LIST=$list QR=$list.qr MRS=$mrs MR_REPOS=$hosts ONION=$onion SITE=${site%/} \
    timeout 600 ccs-gate-build "$staging/site" > "$staging/build.log" 2>&1; then
    say "could not build the site (ccs-gate-build): the live site stays as it is"
    while IFS= read -r l; do say "  $l"; done < <(grep -v 'skipping ' "$staging/build.log" | tail -n 3)
    alert build "the web server could not build the site from site-data.json (the live site stays as it is) @ @SITE@"
    exit 1
fi

# what it built, checked (ccs-check gate): every file that fails, "file<TAB>!reason" or
# "file<TAB>address" (one neither the list's nor allowed); it can't say: none of it goes live
if ! bad=$(timeout 900 ccs-check gate site="$staging/site" list="$list" allowed="$conf/allowed" 2> "$staging/gate.log"); then
    while IFS= read -r l; do say "  $l"; done < <(tail -n 5 "$staging/gate.log")
    refuse "its checks did not finish (ccs-check gate)" gate "its checks did not finish (ccs-check gate)"
fi
# a file that fails: out of the site, so the copy below takes its live copy off too
failed=$(cut -f1 <<<"$bad" | sed "s#^$staging/site/##" | sort -u)
while IFS= read -r f; do [[ ! $f ]] || rm -f -- "$staging/site/$f"; done <<<"$failed"
# the pages that would leave the site: those that failed, and the live proposal pages the build
# hasn't (their proposals gone from the repository, or hidden)
gone=$( {
    grep '\.html$' <<<"$failed" || true
    { find "$live/proposals" -name '*.html' -type f 2> /dev/null || true; } | while IFS= read -r f; do f=${f#"$live/"}; [[ -f $staging/site/$f ]] || echo "$f"; done
} | sort -u)
n=$(grep -c . <<<"$gone" || true)
# (meant: $state/allow-remove, for one build: used up when it goes live)
if ((n > ${CCS_GATE_REMOVE:-3})) && [[ ! -f $state/allow-remove ]]; then
    say "$n pages would leave the site at once (failed, or their proposals gone): more than ${CCS_GATE_REMOVE:-3}, so none of the new site goes live"
    while IFS= read -r f; do say "  $f"; done < <(head -n 10 <<<"$gone")
    alert remove-many "the web server would take $n pages off the site at once (failed its checks, or their proposals are gone from the repository): none of the new site goes live; is the branch right? @ @SITE@"
    exit 1
fi
if [[ $bad ]]; then
    say "took $(grep -c . <<<"$failed") file(s) off the site, with an address that isn't the wallet's nor allowed, or not allowed here; the rest goes live"
    while IFS=$'\t' read -r file why; do say "  ${file#"$staging/site/"}: $why"; done < <(head -n 10 <<<"$bad")
    # three alerts at most, one a file, of those not already sent this hour: a foreign address on
    # a page first, then elsewhere, then the rest's (decoys sent once can't hide what comes after)
    k=0
    declare -A told=()
    while IFS=$'\t' read -r file why; do
        ((k < 3)) || break
        file=${file#"$staging/site/"}
        [[ ! ${told[$file]:-} ]] || continue
        told[$file]=1
        if [[ $why == '!'* ]]; then
            alert "file-$file" "the web server took a file off the site: ${why#!} @ @SITE@/$file"
        else
            alert "addr-$why" "the web server took a page off the site: donation address $red${why:0:6}…${why: -4}$off is not in the signed list @ @SITE@/$file"
        fi
        [[ ! $sent ]] || k=$((k + 1))
    done < <(for x in '$2 !~ /^!/ && $1 ~ /\.html$/' '$2 !~ /^!/ && $1 !~ /\.html$/' '$2 ~ /^!/'; do awk -F '\t' "$x" <<<"$bad"; done)
fi
while IFS= read -r f; do
    if [[ $f == proposals/* && -f $live/$f ]] && ! grep -qFx -- "$f" <<<"$failed"; then
        say "took $f off the site: its proposal is no longer in the repository (or hidden)"
    fi
done <<<"$gone"

# the site live: each file that changed written beside its live copy and renamed over it (644,
# folders 755), and what the build no longer has removed
ccs-check copy --delete "$staging/site" "$live"
[[ ! -f $state/allow-remove ]] || { rm -f "$state/allow-remove"; say "allow-remove: $n pages left the site; the file is used up"; }
say "built the site from site-data.json (the design ${design##*/}, the proposals at $(git -C "$git" rev-parse --short refs/heads/ccs)): live"
printf '%s\n' "$inputs" > "$state/built-with"
