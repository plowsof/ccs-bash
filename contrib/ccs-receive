#!/bin/bash
# ccs-receive: the web server's last check (docs/two-machines.md, "The gate"). The backend's push
# key runs only this (command= in authorized_keys). It receives the push as rrsync always did, but
# into a staging folder, one push at a time; then, for each page and JSON file the push changed
# (and those held back last time; all of them when the list, design, markdown.awk, proposals
# commit or this script changed, and once a day),
#   - every page must be one of the design's own (the release zips unpacked in design/, installed
#     here by hand), each region filled with the design's parts and each {{slot}} with a value of
#     its kind (a number, escaped text that can't hold an address, a link into the proposals
#     repository...), a proposal's text, milestones and payouts exactly what markdown.awk
#     (ccs-front-bash's, installed here) makes of its file in the proposals repository
#     (proposals.conf), fetched here, and a donation box one address of the signed list, in its
#     text, link and QR code: nothing else can be on a page, whatever a browser would make of it.
#     A page it couldn't check (in time, or at all) is held back like one that failed;
#   - every Monero address in the pages and JSON must be one of the wallet's (the signed list and
#     its .pin, installed here by hand) or in the allowed file, and every data: image, pixel for
#     pixel, the QR code qrencode makes of such an address; the JSON read as JSON;
#   - every other file it changes must be the design's (design.sha256, from the release zip), a
#     proposal's image that the proposals repository has at that path (any QR code in it holding
#     only such addresses), projects.json, or the signed list's own files, the same as the ones
#     installed here; and a plain file where the site has one (no symlink, no folder for a page);
#   - feed.xml, the feed, exactly as ccs-front-bash writes it: its items plain text, each a link to
#     one of this site's proposal pages (SITE_URL, alert.conf), nothing else (feed_awk).
# The push goes live, except a file that fails: that one keeps its last good copy (a new one stays
# out), IRC is told (alert.conf), and it exits 7 (the backend's rsync exits 7 too). A list that
# isn't the pinned one, or no design.sha256, design or markdown.awk, refuses the whole push. Needs
# bash, awk, grep, rsync (rrsync), coreutils, curl, qrencode, git, python3 (as rrsync), and for
# reading QR codes libzbar, libpng, libturbojpeg and giflib (Debian: libzbar0 libpng16-16
# libturbojpeg0 libgif7). Root-owned, 755.
set -euo pipefail
# (no home of the account's: git, curl and bash read no config from there, whatever passwd says)
export LC_ALL=C HOME=/nonexistent GIT_CONFIG_NOSYSTEM=1
staging=/var/lib/ccs-staging live=/var/lib/ccs-data conf=/etc/ccs-gate state=/var/lib/ccs-gate

# The reason goes to the web server's journal (and /var/log/ccs-gate.log, if ccs-data may write
# it), and to the backend: that last one only if ssh relays it before the rsync client exits.
# alert KEY MESSAGE: also to IRC (/etc/ccs-gate/alert.conf: ALERT_URL, SITE_URL), at most once an
# hour per KEY: a taken-over backend retrying every two minutes mustn't flood the channel. Here
# is where a bad push is seen even when the backend is the one lying. Sets sent=1 when it posts.
alert() {
    local url='' site='' k v stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    sent=''
    [[ -r $conf/alert.conf ]] || return 0
    while IFS='=' read -r k v; do
        case $k in ALERT_URL) url=$v ;; SITE_URL) site=$v ;; esac
    done < <(grep -E '^(ALERT_URL|SITE_URL)=' "$conf/alert.conf")
    [[ $url ]] || return 0
    if [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]]; then return 0; fi
    touch "$stamp" 2> /dev/null || true
    sent=1
    curl -fsS --max-time 10 --data-binary "[${blue}CCS-watch${off}] ${2//@SITE@/${site:-}}" -H 'Content-Type: text/plain' "$url" > /dev/null 2>&1 \
        || say "could not send the alert"
}

blue=$'\x0312' red=$'\x0304' off=$'\x03'   # IRC colours, as ccs-watch's

say() {
    logger -t ccs-gate -- "$*" 2> /dev/null || true
    printf '%s %s\n' "$(date -u '+%F %T')" "$*" 2> /dev/null >> /var/log/ccs-gate.log || true   # 2> first: it also hides a log it can't open
    # stderr is the backend's ssh channel: if the backend hung up, writing to it kills the writer
    # (SIGPIPE), so a subshell writes it, and the gate goes on to alert
    (printf 'ccs-gate: %s\n' "$*" >&2) || true
}

# refuse WHY KEY [WHY_FOR_IRC]: the whole push stays out
refuse() {
    say "refused the push: $1"
    alert "$2" "the web server refuses every push: ${3:-$1}"
    exit 1
}

# The pages' and JSON's addresses, as written (pages() says what can be on a page at all), as
# "file<TAB>address" lines; "file<TAB>!reason" for what the gate can't accept; "file<TAB>?qr<TAB>
# base64" for each data: image, for qrscan_py (below). An address is a run of 95 (standard) or 106
# (integrated) base58 characters, tags and attributes included (a monero: link, an alt text),
# entities read as a browser reads them (&#56; is 8). A byte that isn't ASCII, or a control
# character, is read twice: dropped (a zero-width space mustn't split an address) and as a space
# (a no-break space mustn't join one to the word beside it). A page or JSON must start with <, [
# or {: no image format does, and a browser shows an <img> of any file whose bytes are an image's.
# Python, read as bytes, in one pass each: time linear in the file (awk's took minutes for 1 MB).
# check_py: what both read addresses with. An address written in groups, split by up to three
# characters that can't be in one (spaces, punctuation: "4A9b xZq3", "4A9b - xZq3", "4A9b/xZq3"),
# is read joined, and kept only where its checksum says it is one (prose joined that way is never
# one). Each file has a budget of checksums (CCS_GATE_KECCAK, 3000) and of time (CCS_GATE_SECS,
# 20 s): past either, it is held back alone ("too many..."), not every file with it (text made
# to look like an address everywhere, an idea's title, costs a checksum a place).
check_py='
import os, re, sys, time
GROUPS = re.compile(r"[1-9A-HJ-NP-Za-km-z]+(?:[^1-9A-HJ-NP-Za-km-z0OIl<>\x01]{1,3}[1-9A-HJ-NP-Za-km-z]+)+")
class TooMany(Exception): pass
BUDGET, SECS = int(os.environ.get("CCS_GATE_KECCAK", 3000)), float(os.environ.get("CCS_GATE_SECS", 20))
spent = {"n": 0, "t": 0.0}
def start(): spent["n"], spent["t"] = 0, time.monotonic()
M = (1 << 64) - 1
RC = [1, 0x8082, 0x800000000000808a, 0x8000000080008000, 0x808b, 0x80000001, 0x8000000080008081,
      0x8000000000008009, 0x8a, 0x88, 0x80008009, 0x8000000a, 0x8000808b, 0x800000000000008b,
      0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080, 0x800a,
      0x800000008000000a, 0x8000000080008081, 0x8000000000008080, 0x80000001, 0x8000000080008008]
ROT = [[0, 36, 3, 41, 18], [1, 44, 10, 45, 2], [62, 6, 43, 15, 61], [28, 55, 25, 21, 56], [27, 20, 39, 8, 14]]
def keccak(b):   # Keccak-256 as Monero has it (the original padding, not that of SHA3)
    b = bytearray(b) + b"\x01"
    while len(b) % 136: b += b"\x00"
    b[-1] |= 0x80
    s = [[0] * 5 for _ in range(5)]
    for o in range(0, len(b), 136):
        for i in range(17): s[i % 5][i // 5] ^= int.from_bytes(b[o + 8 * i:o + 8 * i + 8], "little")
        for r in RC:
            c = [s[x][0] ^ s[x][1] ^ s[x][2] ^ s[x][3] ^ s[x][4] for x in range(5)]
            d = [c[(x - 1) % 5] ^ (((c[(x + 1) % 5] << 1) | (c[(x + 1) % 5] >> 63)) & M) for x in range(5)]
            s = [[s[x][y] ^ d[x] for y in range(5)] for x in range(5)]
            t = [[0] * 5 for _ in range(5)]
            for x in range(5):
                for y in range(5):
                    v, n = s[x][y], ROT[x][y]
                    t[y][(2 * x + 3 * y) % 5] = ((v << n) | (v >> (64 - n))) & M if n else v
            s = [[t[x][y] ^ (~t[(x + 1) % 5][y] & t[(x + 2) % 5][y]) for y in range(5)] for x in range(5)]
            s[0][0] ^= r
    return b"".join(s[i % 5][i // 5].to_bytes(8, "little") for i in range(4))
B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
SIZE = {0: 0, 2: 1, 3: 2, 5: 3, 6: 4, 7: 5, 9: 6, 10: 7, 11: 8}
def b58(s):   # base58 as Monero has it: blocks of 11 characters, 8 bytes
    out = b""
    for i in range(0, len(s), 11):
        n, k = 0, SIZE.get(len(s[i:i + 11]))
        for ch in s[i:i + 11]: n = n * 58 + B58.index(ch)
        if k is None or n >> (8 * k): return None
        out += n.to_bytes(k, "big")
    return out
NETS = (18, 19, 24, 25, 36, 42, 53, 54, 63)
seen_valid = {}
def valid(s):   # an address its checksum says is one, of a network Monero has (its first byte)
    if s[0] not in "45789AB" or (b58(s[:11]) or b"\x00")[0] not in NETS: return False
    if s in seen_valid: return seen_valid[s]
    d = b58(s)
    if d is None or d[0] not in NETS: return False
    spent["n"] += 1
    if spent["n"] > BUDGET or time.monotonic() - spent["t"] > SECS: raise TooMany()
    seen_valid[s] = keccak(d[:-4])[:4] == d[-4:]
    return seen_valid[s]
def grouped(t):   # the addresses written in groups in t (TooMany past the budget)
    out = set()
    for g in GROUPS.findall(re.sub(r"\s+", " ", t)):
        j = re.sub(r"[^1-9A-HJ-NP-Za-km-z]", "", g)
        out.update(j[i:i + n] for n in (95, 106) for i in range(len(j) - n + 1) if valid(j[i:i + n]))
    return out
'
scan_py=$check_py'
MAX = int(os.environ.get("CCS_GATE_MAX", 8 << 20))
ENT = re.compile(r"&#[0-9]+;?|&#[xX][0-9A-Fa-f]+;?|&[A-Za-z][A-Za-z0-9]*;")
NAMED = {"amp": 38, "lt": 60, "gt": 62, "quot": 34, "apos": 39}
QR = re.compile(r"data:image/png;base64,[A-Za-z0-9+/]+=*")
TOK = re.compile(r"[0-9A-Za-z]+")
def char(n):   # printable ASCII as itself, a space as one, anything else \x01 (read both ways)
    if 32 < n < 127: return chr(n)
    return " " if n in (9, 10, 12, 13, 32) else "\x01"
def entity(m):
    e = m.group(0)
    e = e[:-1] if e.endswith(";") else e
    if e[:3] in ("&#x", "&#X"): return char(int(e[3:], 16))
    if e[:2] == "&#": return char(int(e[2:]))
    return char(NAMED.get(e[1:], -1))
for f in sys.argv[1:]:
    if os.path.getsize(f) > MAX:
        print(f + "\t!over %d MB: not read" % (MAX >> 20)); continue
    with open(f, "rb") as h: d = h.read().decode("latin-1")
    out = set()
    if not re.match(r"[ \t\n\r]*[<\[{]", d):
        out.add(f + "\t!not text that starts as a page or JSON does (<, [ or {): a browser would show it as an image")
    d = ENT.sub(entity, re.sub(r"[\x80-\xff\x00-\x08\x0b\x0e-\x1f\x7f]", "\x01", d))
    # each data: image (the QR codes: pages() allows them nowhere else) to qrscan_py; not text
    for m in QR.finditer(d): print(f + "\t?qr\t" + m.group(0)[22:])
    d = QR.sub(" ", d)
    start()
    try:
        for t in (d.replace("\x01", ""), d.replace("\x01", " ")):
            out.update(f + "\t" + w for w in TOK.findall(t) if len(w) in (95, 106) and not re.search("[0OIl]", w))
            out.update(f + "\t" + a for a in grouped(t))
    except TooMany:
        out.add(f + "\t!too many runs that could be addresses to check")
    for l in sorted(out): print(l)
'

# qrscan_py KIND IMAGE [inverted]: what libzbar reads in IMAGE, each code's text on a line; exit 1
# if there is none, or IMAGE isn't a KIND its decoder reads. KIND is the format its name says
# (never one picked by the bytes), decoded by that format's own library to 8-bit grey (png:
# libpng, jpeg: libturbojpeg, gif: giflib, every frame), its size checked before; then libzbar's
# scanner, and with "inverted", on nothing found, the image inverted (light on dark, which phones
# read). Python's ctypes: no compiled code of the gate's own.
# --check: the libraries load. (A test's: with CCS_GATE_SCANLOG, each image read is noted there:
# its kind and first bytes.)
qrscan_py='
import ctypes as C, os, resource, sys
# 1 GB at most, for the decoders too: the size of a GIF frame is only known once giflib has
# allocated and decoded it, and a small file can claim (and fill) one of 65535x65535
resource.setrlimit(resource.RLIMIT_AS, (1 << 30, 1 << 30))
L = lambda n: C.CDLL(n)
if sys.argv[1:] == ["--check"]:
    for n in ("libzbar.so.0", "libpng16.so.16", "libturbojpeg.so.0", "libgif.so.7"): L(n)
    sys.exit(0)
kind, path, inverted = sys.argv[1], sys.argv[2], sys.argv[3:] == ["inverted"]
MAXPX = 40000000
data = open(path, "rb").read(4 << 20)
if os.environ.get("CCS_GATE_SCANLOG"):
    with open(os.environ["CCS_GATE_SCANLOG"], "a") as f: f.write("".join(chr(b) if 32 < b < 127 else "%03o" % b for b in data[:4]) + " " + kind + "\n")
P = C.POINTER
def png():
    lib = L("libpng16.so.16")
    class Img(C.Structure):
        _fields_ = [("opaque", C.c_void_p), ("version", C.c_uint32), ("width", C.c_uint32), ("height", C.c_uint32), ("format", C.c_uint32),
                    ("flags", C.c_uint32), ("colormap_entries", C.c_uint32), ("warning_or_error", C.c_uint32), ("message", C.c_char * 64)]
    lib.png_image_begin_read_from_memory.argtypes = [P(Img), C.c_char_p, C.c_size_t]
    lib.png_image_finish_read.argtypes = [P(Img), C.c_void_p, C.c_void_p, C.c_int32, C.c_void_p]
    lib.png_image_free.argtypes = [P(Img)]
    im = Img(version=1)   # PNG_IMAGE_VERSION
    if not lib.png_image_begin_read_from_memory(C.byref(im), data, len(data)): return []
    w, h = im.width, im.height
    if not 0 < w * h <= MAXPX: lib.png_image_free(C.byref(im)); return []
    im.format = 0   # PNG_FORMAT_GRAY: any alpha laid on white, as a browser on a white page
    buf, white = C.create_string_buffer(w * h), (C.c_ubyte * 3)(255, 255, 255)
    if not lib.png_image_finish_read(C.byref(im), white, buf, w, None): return []
    return [(w, h, buf.raw)]
def jpeg():
    lib = L("libturbojpeg.so.0")
    lib.tjInitDecompress.restype = C.c_void_p
    lib.tjDecompressHeader3.argtypes = [C.c_void_p, C.c_char_p, C.c_ulong] + [P(C.c_int)] * 4
    lib.tjDecompress2.argtypes = [C.c_void_p, C.c_char_p, C.c_ulong, C.c_void_p, C.c_int, C.c_int, C.c_int, C.c_int, C.c_int]
    lib.tjDestroy.argtypes = [C.c_void_p]
    t = lib.tjInitDecompress(); w, h, ss, cs = C.c_int(), C.c_int(), C.c_int(), C.c_int()
    try:
        if lib.tjDecompressHeader3(t, data, len(data), C.byref(w), C.byref(h), C.byref(ss), C.byref(cs)) != 0: return []
        if not 0 < w.value * h.value <= MAXPX: return []
        buf = C.create_string_buffer(w.value * h.value)
        if lib.tjDecompress2(t, data, len(data), buf, w.value, 0, h.value, 6, 0) != 0: return []   # TJPF_GRAY
        return [(w.value, h.value, buf.raw)]
    finally: lib.tjDestroy(t)
def gif():
    lib = L("libgif.so.7")
    class Color(C.Structure): _fields_ = [("r", C.c_ubyte), ("g", C.c_ubyte), ("b", C.c_ubyte)]
    class Map(C.Structure): _fields_ = [("count", C.c_int), ("bits", C.c_int), ("sort", C.c_bool), ("colors", P(Color))]
    class Desc(C.Structure): _fields_ = [("left", C.c_int), ("top", C.c_int), ("width", C.c_int), ("height", C.c_int), ("interlace", C.c_bool), ("map", P(Map))]
    class Saved(C.Structure): _fields_ = [("desc", Desc), ("raster", P(C.c_ubyte)), ("next", C.c_int), ("ext", C.c_void_p)]
    class Gif(C.Structure):
        _fields_ = [("swidth", C.c_int), ("sheight", C.c_int), ("res", C.c_int), ("bg", C.c_int), ("aspect", C.c_ubyte), ("map", P(Map)),
                    ("count", C.c_int), ("image", Desc), ("saved", P(Saved)), ("next", C.c_int), ("ext", C.c_void_p), ("error", C.c_int),
                    ("user", C.c_void_p), ("private", C.c_void_p)]
    lib.DGifOpenFileName.argtypes = [C.c_char_p, P(C.c_int)]; lib.DGifOpenFileName.restype = P(Gif)
    lib.DGifSlurp.argtypes = [P(Gif)]; lib.DGifCloseFile.argtypes = [P(Gif), P(C.c_int)]
    err = C.c_int(); g = lib.DGifOpenFileName(os.fsencode(path), C.byref(err))
    if not g: return []
    try:
        if not 0 < g.contents.swidth * g.contents.sheight <= MAXPX or lib.DGifSlurp(g) != 1: return []
        out = []
        for i in range(min(g.contents.count, 100)):
            s = g.contents.saved[i]; w, h = s.desc.width, s.desc.height
            m = s.desc.map or g.contents.map
            if not (m and s.raster and 0 < w * h <= MAXPX): continue
            grey = bytes((c.r * 299 + c.g * 587 + c.b * 114) // 1000 for c in m.contents.colors[:m.contents.count])
            out.append((w, h, C.string_at(s.raster, w * h).translate(grey + b"\xff" * (256 - len(grey)))))
        return out
    finally: lib.DGifCloseFile(g, C.byref(err))
Z = L("libzbar.so.0")
Z.zbar_image_scanner_create.restype = Z.zbar_image_create.restype = C.c_void_p
Z.zbar_image_set_format.argtypes = [C.c_void_p, C.c_ulong]
Z.zbar_image_set_size.argtypes = [C.c_void_p, C.c_uint, C.c_uint]
Z.zbar_image_set_data.argtypes = [C.c_void_p, C.c_void_p, C.c_ulong, C.c_void_p]
Z.zbar_scan_image.argtypes = [C.c_void_p, C.c_void_p]
Z.zbar_image_first_symbol.argtypes = Z.zbar_symbol_next.argtypes = Z.zbar_symbol_get_data.argtypes = Z.zbar_symbol_get_data_length.argtypes = [C.c_void_p]
Z.zbar_image_first_symbol.restype = Z.zbar_symbol_next.restype = Z.zbar_symbol_get_data.restype = C.c_void_p
Z.zbar_image_destroy.argtypes = [C.c_void_p]
scanner = Z.zbar_image_scanner_create()
# QR codes only: every kind of code off (symbology 0, all of them), then QR (64) on, so none of
# the readers for the others (EAN, Code 128, DataBar, PDF417...) ever sees these bytes
Z.zbar_image_scanner_set_config.argtypes = [C.c_void_p, C.c_int, C.c_int, C.c_int]
if Z.zbar_image_scanner_set_config(scanner, 0, 0, 0) or Z.zbar_image_scanner_set_config(scanner, 64, 0, 1): sys.exit(1)
def scan(w, h, grey):
    img, buf = Z.zbar_image_create(), C.create_string_buffer(grey, len(grey))
    Z.zbar_image_set_format(img, 0x30303859)   # Y800: 8-bit grey
    Z.zbar_image_set_size(img, w, h); Z.zbar_image_set_data(img, buf, len(grey), None)
    Z.zbar_scan_image(scanner, img)
    out, s = [], Z.zbar_image_first_symbol(img)
    while s: out.append(C.string_at(Z.zbar_symbol_get_data(s), Z.zbar_symbol_get_data_length(s))); s = Z.zbar_symbol_next(s)
    Z.zbar_image_destroy(img)
    return out
found = []
for w, h, grey in {"png": png, "jpeg": jpeg, "gif": gif}[kind]():
    got = scan(w, h, grey)
    if not got and inverted: got = scan(w, h, grey.translate(bytes(range(255, -1, -1))))
    found += got
for t in found: sys.stdout.buffer.write(t + b"\n")
sys.exit(0 if found else 1)
'
qrscan() { CCS_GATE_SCANLOG=$([[ -e $state/scan.log ]] && echo "$state/scan.log") timeout 20 python3 -I -c "$qrscan_py" "$@"; }

# qr FILE IMAGE: the addresses in every QR code in IMAGE as "FILE<TAB>address" lines (none if it
# has no QR code). qrscan_py reads it, as ccs-data, with a time limit; inverted codes (light on
# dark) too. Read as the format its name says.
qr() {
    local out kind=${2##*.}
    case ${kind,,} in png) kind=png ;; jpg | jpeg) kind=jpeg ;; gif) kind=gif ;; *) return 1 ;; esac
    out=$(qrscan "$kind" "$2" inverted 2> /dev/null) || return 1
    grep -oE '[0-9A-Za-z]+' <<<"$out" | awk -v f="$1" '(length($0) == 95 || length($0) == 106) && !/[0OIl]/ { print f "\t" $0; n++ } END { exit !n }'
}

# pixels PNG: "<width> <height> <sha256 of its RGBA pixels>", as a browser shows it; nothing (and
# 1) for a PNG it can't read, or with any chunk qrencode doesn't write (an animated PNG's frames,
# a gamma or colour profile could show something else). Python's standard library only.
pixels_py='
import hashlib, struct, sys, zlib
d = sys.stdin.buffer.read(4 << 20)
assert d[:8] == b"\x89PNG\r\n\x1a\n"
i, idat, plte, trns, hdr = 8, b"", b"", None, None
while True:
    n, t = struct.unpack(">I4s", d[i:i + 8]); c = d[i + 8:i + 8 + n]; i += 12 + n
    assert len(c) == n and t in (b"IHDR", b"PLTE", b"tRNS", b"pHYs", b"IDAT", b"IEND")
    if t == b"IHDR": hdr = struct.unpack(">IIBBBBB", c)
    elif t == b"PLTE": plte = c
    elif t == b"tRNS": trns = c
    elif t == b"IDAT": idat += c
    elif t == b"IEND": break
w, h, depth, kind, _, _, interlace = hdr
assert 0 < w <= 4096 and 0 < h <= 4096 and interlace == 0 and (kind, depth) in ((0, 1), (0, 8), (3, 1), (3, 8), (2, 8), (6, 8))
ch = {0: 1, 3: 1, 2: 3, 6: 4}[kind]
stride = (w * ch * depth + 7) // 8; bpp = max(1, ch * depth // 8)
z = zlib.decompressobj(); raw = z.decompress(idat, h * (stride + 1) + 1)
assert len(raw) == h * (stride + 1)
out, prev = bytearray(), bytearray(stride)
for y in range(h):
    f, row = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
    for x in range(stride):
        a = row[x - bpp] if x >= bpp else 0; b = prev[x]; c = prev[x - bpp] if x >= bpp else 0
        if f == 1: row[x] = (row[x] + a) & 255
        elif f == 2: row[x] = (row[x] + b) & 255
        elif f == 3: row[x] = (row[x] + (a + b) // 2) & 255
        elif f == 4:
            p = a + b - c; pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
            row[x] = (row[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        else: assert f == 0
    prev = row
    for x in range(w):
        if depth == 1: v = (row[x >> 3] >> (7 - (x & 7))) & 1
        else: v = row[x * ch]
        if kind == 3:
            assert 3 * v + 3 <= len(plte)
            out += plte[3 * v:3 * v + 3] + bytes([trns[v] if trns and v < len(trns) else 255])
        elif kind == 0:
            g = v * 255 if depth == 1 else v
            out += bytes([g, g, g, 0 if trns and len(trns) == 2 and struct.unpack(">H", trns)[0] == v else 255])
        elif kind == 2:
            assert trns is None
            out += row[x * 3:x * 3 + 3] + b"\xff"
        else: out += row[x * 4:x * 4 + 4]
print(w, h, hashlib.sha256(out).hexdigest())
'
pixels() { timeout 20 python3 -I -c "$pixels_py" < "$1" 2> /dev/null; }

# qrdata FILE IMAGE: "FILE<TAB>address" if IMAGE is exactly the QR code of one address that
# qrencode makes (as ccs-front-bash does: qrencode -s 10 "monero:<address>"), pixel for pixel;
# else 1. qrscan_py finding a good address isn't enough: the backend draws these, and one
# could hold a good QR code beside a piece of another. The backend's bytes reach a decoder other
# than pixels_py's only once pixels_py has read them as a plain PNG, and then libpng's.
qrdata() {
    local text ref got
    got=$(pixels "$2") && [[ $got ]] || return 1
    text=$(qrscan png "$2" 2> /dev/null) || return 1
    [[ $text =~ ^monero:[1-9A-HJ-NP-Za-km-z]+$ && (${#text} == 102 || ${#text} == 113) ]] || return 1
    ref=$(qrencode -s 10 -o - -- "$text" | pixels /dev/stdin) && [[ $ref == "$got" ]] || return 1
    printf '%s\t%s\n' "$1" "${text#monero:}"
}

# json FILE...: each JSON file's strings as a reader of it gets them (\u escapes read, every key
# and value, a key twice both), their addresses as "file<TAB>address" lines, read as the pages'
# text is: a character that isn't ASCII dropped (it mustn't split an address), and again as a
# space (it mustn't join one to its neighbour); "file<TAB>!reason" if it isn't JSON.
json_py=$check_py'
import json
for f in sys.argv[1:]:
    seen = []
    def pairs(p):   # every pair as it is read, the same key twice too; what is left to walk: none
        for k, v in p: seen.append(k); walk(v)
        return {}
    def walk(v):
        if isinstance(v, str): seen.append(v)
        elif isinstance(v, list):
            for x in v: walk(x)
        elif isinstance(v, dict):
            for x in v.values(): walk(x)
    try:
        with open(f, "rb") as h: walk(json.loads(h.read(16 << 20).decode("utf-8"), object_pairs_hook=pairs))
    except Exception:
        print(f + "\t!not JSON (UTF-8) that reads"); continue
    out = set()
    start()
    try:
        for s in seen:
            s = re.sub(r"[\t\n\f\r]", " ", s); s = re.sub(r"[\x00-\x1f\x7f]", "", s)
            for t in (re.sub(r"[^\x00-\x7f]", "", s), re.sub(r"[^\x00-\x7f]", " ", s)):
                out.update(w for w in re.findall(r"[0-9A-Za-z]+", t) if len(w) in (95, 106) and not re.search(r"[0OIl]", w))
                out.update(grouped(t))
    except TooMany:
        out.add("!too many runs that could be addresses to check")
    for a in sorted(out): print(f + "\t" + a)
'

# pages SITE DESIGNS BODIES LIST VIEWKEY HOSTS ONION < pages (NUL-separated, relative to SITE): each must
# be one of the design's own, every region filled with the design's parts and every {{slot}} with a
# value of its kind, as ccs-front-bash fills them; a proposal's text, milestones and payouts exactly
# what markdown.awk makes of its file; a donation box one address of the signed list. DESIGNS:
# unpacked release zips, ":"-separated (any one will do); BODIES: markdown.awk's lines,
# ":"-separated (one file per commit of the proposals, and markdown.awk); LIST: the signed list (its
# .pin beside it); VIEWKEY: its .viewkey or ""; HOSTS: where a link to a proposal may go (a host, or
# a host and the path under it). Prints "page<TAB>=ok" for each page that passes (a page without
# one is held back: one it never got to, in time or at all, too), after "page<TAB>=box<TAB>address
# <TAB>QR code base64" for its donation box; else "page<TAB>!reason". Python's standard library only.
pages_py='
import json, os, re, sys

site, designs, bodies, lst, viewkey, hosts, onion = sys.argv[1:8]
MAX = int(os.environ.get("CCS_GATE_MAX", 8 << 20))   # a page larger is not read (nor checked)
B58 = "[1-9A-HJ-NP-Za-km-z]"
# escaped text (as ccs-bash and markdown.awk escape it): no markup, no bidi controls (they can
# show the halves of an address in another order than written), at most 1000 characters, and no
# run of 90 characters each base58 or not ASCII: an address padded or split by invisible
# characters, or drawn with look-alikes (a mathematical or fullwidth 9, a Cyrillic A). Any
# character that is not ASCII counts, not only letters: Unicode tables differ between Python and
# the jq that shortens idea titles by the same rule (gitlab.sh), and must agree with it. An
# address in groups ("4A9b xZq3", "4A9b - xZq3", "4A9b/xZq3"): scan_py, by its checksum
# (gitlab.sh shortens every such run that holds one, with the same separators, so the two agree)
RUN = "(?:" + B58 + "|[^\\x00-\\x7f])"
TEXT = "(?:(?!" + RUN + "{90})(?:[^<>\"\x27&\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]|&(?:amp|lt|gt|quot|#39|apos);)){0,1000}"
# a milestone or payout: anything escaped, compared afterwards with the repository
LOOSE = "[^<>\\n]{0,4000}"
NAME = "(?:[^\"<>/&\\n]|&(?:amp|lt|gt|quot|#39|apos);){1,300}"
NUM = "[0-9]{1,30}"
XMR = "[0-9]{1,30}(?:\\.[0-9]{1,30})?"
DATE = "(?:(?:January|February|March|April|May|June|July|August|September|October|November|December) [1-9][0-9]?, [0-9]{4})?"   # as site.jq writes them
# a link to a proposal: under one of HOSTS (the proposals repository, by its path), its merge
# request (GitLab, old or new form) or pull request (Forgejo), and nothing else: not an issue or a
# file anyone could write in "Comments and updates"
MR = "(?:/-/merge_requests/|/merge_requests/|/pulls/)[0-9]{1,10}"
LINK = ("https://(?:" + "|".join(re.escape(h.strip("/")) for h in hosts.split()) + ")" + MR) if hosts.split() else "(?!)"

def read(p):
    with open(p, "rb") as f: return f.read().decode("utf-8")
def part(t): return t[:-1] if t.endswith("\n") else t      # as jq rtrimstr("\n")
def strip(t): return t.rstrip("\n")                         # $(cat FILE)
def prefix(depth): return "./" if depth == 0 else "../" * depth
def rel(t, depth):   # as relative_links in ccs-front-bash, a line at a time as sed
    return re.sub("((?:href|src)=\")/([^/\\n])", lambda m: m.group(1) + prefix(depth) + m.group(2), t)
def esc(s):          # as jq @html (1.6 writes \x27 as &#39;, later ones as &apos;: same() reads both)
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\x27", "&#39;").replace("\"", "&quot;")
def same(a, b): return a.replace("&apos;", "&#39;") == b.replace("&apos;", "&#39;")
def put(t, v):       # as common.jq fill: every {{slot}}, in one pass
    return re.sub("\\{\\{([a-z_]+)\\}\\}", lambda m: v[m.group(1)], t)

# the signed list: its addresses (the only ones a donation box may show), its main address and
# fingerprint, as check_addresses shows them on Verify
rows = [l.split() for l in read(lst).splitlines()]
listed = {r[1] for r in rows if len(r) >= 2}
main = next(r[1] for r in rows if r[:1] == ["0"])
fpr = next(l[4:].strip() for l in read(lst + ".pin").splitlines() if l.startswith("key "))
fpr = re.sub("^((.{4} ){5})", "\\1 ", re.sub(" $", "", re.sub("(.{4})", "\\1 ", fpr)))
net = " --testnet" if main[0] in "9A" else " --stagenet" if main[0] in "57" else ""

# each proposal as markdown.awk renders it, from each commit (any of them will do): its text, and
# its milestones and payouts (as JSON)
md = {}
for f in bodies.split(":"):
    if f and os.path.exists(f):
        for l in read(f).splitlines():
            if l:
                j = json.loads(l)
                md.setdefault(j["file"], set()).add((j["body"].replace("\x01", ""), json.dumps(j.get("milestones", [])), json.dumps(j.get("payouts", []))))

class Design:
    def __init__(self, d):
        self.d = d
        self.p = {f[:-5]: read(os.path.join(d, "parts", f)) for f in os.listdir(os.path.join(d, "parts")) if f.endswith(".html")}
    # the regex of a part: its literal text as it is, each {{slot}} by SLOTS (name: regex); a slot
    # in SAME is one value however often the part has it (a group, then a backreference)
    def fill(self, text, slots, same=()):
        out, i, seen = "", 0, set()
        for m in re.finditer("\\{\\{([a-z_]+)\\}\\}", text):
            k = m.group(1)
            if k not in slots: raise KeyError(k)
            if k in same and k in seen: rx = "(?P=" + k + ")"
            elif k in same: rx = "(?P<" + k + ">" + slots[k] + ")"; seen.add(k)
            else: rx = "(?:" + slots[k] + ")"
            out += re.escape(text[i:m.start()]) + rx; i = m.end()
        return out + re.escape(text[i:])
    def card(self, stage, depth, tagpage):
        c = part(self.p["card-" + stage])
        if tagpage: c = c.replace("=\"../", "=\"../../../")
        c = rel(c, depth)
        url = "#|" + re.escape(prefix(depth)) + "proposals/" + NAME + "\\.html|" + LINK
        seg = "(?:" + re.escape(part(self.p["segment-done"])) + "|" + re.escape(part(self.p["segment-todo"])) + ")*"
        label = self.fill(part(self.p["label"]), {"tag": TEXT, "color": "tag-[0-7]"})
        return self.fill(c, {"url": url, "name": TEXT, "author": TEXT, "date": DATE,
            "funding_note": "(?: · funding since " + DATE + ")?", "funding_date": DATE, "contributors": NUM, "amount": XMR, "raised": XMR,
            "percentage": NUM, "done": NUM, "milestones": NUM, "pending_note": "(?: · \\+?" + XMR + " XMR pending)?",
            "upvotes": NUM + "|–", "downvotes": NUM + "|–", "segments": seg, "tags": "(?:" + label + ")*"})
    def nav(self, depth):
        href = re.escape(prefix(depth)) + "explore/tag/[A-Za-z0-9%._~-]+/"
        f = self.fill(part(self.p["filter"]), {"tag": TEXT, "color": "tag-[0-7]", "href": href, "count": NUM, "active": "(?: active)?"})
        return "(?:" + self.fill(part(self.p["filters"]), {"filters": "(?:" + f + ")*"}) + ")?"
    def verify(self):
        f = strip(self.p["verify"])
        # without the view key file, nothing for the slots that show it (ccs-front-bash needs it too)
        slots = {"address": re.escape(main), "fingerprint": re.escape(fpr), "network": re.escape(net),
                 "viewkey": "(?!)", "wallet_source": "(?!)"}
        if viewkey:
            v = read(viewkey).splitlines()
            src = next((l.split(None, 1)[1].strip() for l in v if l.startswith("source ")), "")
            txt = next((l.split(None, 1)[1].strip() for l in v if l.startswith("source-text ")), "").replace("\x27", "&#39;")
            slots["viewkey"] = re.escape(v[0].replace(" ", ""))
            slots["wallet_source"] = re.escape("<a href=\"" + src.replace("&", "&amp;") + "\">" + (txt or "where they were published") + "</a>") if src else "published by this site"
        return self.fill(f, slots)
    # the milestones and payouts of a proposal (JSON from markdown.awk) as pages.jq makes them
    def milestones(self, ms, depth):
        r = "\n".join(put(part(self.p["milestone-done" if x[2] != "" else "milestone-todo"]), {"name": esc(x[0]), "funds": esc(x[1]), "date": esc(x[2])}) for x in json.loads(ms))
        return rel(r or part(self.p["no-milestones"]), depth)
    def payouts(self, ps, depth):
        r = "\n".join(put(part(self.p["payout"]), {"date": esc(x[0]), "amount": esc(x[1])}) for x in json.loads(ps))
        return rel(r or part(self.p["no-payouts"]), depth)
    # what region NAME may hold on a page DEPTH folders down; on a proposal page (BODY) the
    # milestones and payouts are kept (groups), to compare with the repository after
    def region(self, name, depth, tagpage, body=False):
        kind, _, arg = name.partition(" ")
        if kind in ("count", "number"): return NUM
        if kind == "title": return TEXT
        if kind == "filters": return self.nav(depth)
        if kind == "verify": return self.verify()
        # the onion line of the footer: nothing, or the onion part of the design with the onion
        # address of this site (ONION, /etc/ccs-gate/onion), never another: a backend cannot send
        # visitors to an onion of its choosing
        if kind == "onion":
            if not onion or "onion" not in self.p: return ""
            return "(?:" + re.escape(put(part(self.p["onion"]), {"onion": onion})) + ")?"
        if kind == "list":
            c = self.card(arg, depth, tagpage)
            return "(?:" + c + "(?:\\n" + c + ")*|" + re.escape(part(self.p["empty"])) + ")?"
        # the donation box: one address, in its text, its monero: link and its QR code (checked after);
        # or, a Funding Required proposal at its goal, the donate-funded part of the design in its place
        # ("Funded", no address), only with its bar at 100. The backend writes the bar (the
        # amounts never were checked here): one that says 100 can take a box away, never change it
        if kind in ("donate", "funded"):
            r = self.fill(part(self.p[kind]), self.slots(depth), ("address", "qr"))
            if kind == "donate" and "donate-funded" in self.p:
                r = "(?:" + r + "|" + self.fill(part(self.p["donate-funded"]), dict(self.slots(depth), percentage="100")) + ")"
            return r
        t = LOOSE if body else TEXT
        if kind == "milestones":
            m = "(?:" + self.fill(part(self.p["milestone-done"]), {"name": t, "funds": t, "date": t}) + "|" \
                + self.fill(part(self.p["milestone-todo"]), {"name": t, "funds": t}) + ")"
            r = m + "(?:\\n" + m + ")*|" + re.escape(part(self.p["no-milestones"]))
        elif kind == "payouts":
            m = self.fill(part(self.p["payout"]), {"amount": t, "date": t})
            r = m + "(?:\\n" + m + ")*|" + re.escape(part(self.p["no-payouts"]))
        else: raise KeyError(name)
        return "(?P<" + kind + ">" + r + ")" if body else r
    def slots(self, depth, body=None):
        seg = "(?:" + re.escape(part(self.p["segment-done"])) + "|" + re.escape(part(self.p["segment-todo"])) + ")*"
        href = re.escape(prefix(depth)) + "explore/tag/[A-Za-z0-9%._~-]+/"
        s = {"name": TEXT, "author": TEXT, "date": DATE, "funding_note": "(?: · funding since " + DATE + ")?", "funding_date": DATE,
             "contributors": NUM, "amount": XMR, "raised": XMR, "percentage": NUM, "done": NUM, "milestones": NUM,
             "pending_note": "(?: · \\+?" + XMR + " XMR pending)?", "gitlab_url": "#|" + LINK, "segments": seg,
             "address": B58 + "{95}", "qr": "data:image/png;base64,[A-Za-z0-9+/]+=*",
             "verify_link": re.escape(strip(self.p["verify-link"])), "milestones_list": "", "payouts_list": "",
             "tag_links": "(?:" + self.fill(part(self.p["label-link"]), {"tag": TEXT, "color": "tag-[0-7]", "href": href}) + ")*"}
        if body: s["body"] = "(?P<body>.*?)"   # compared with the repository after (one regex for every page)
        return s
    # the regex of a page: its literal text, the regions as above, the slots (on a proposal page)
    def page(self, text, depth, tagpage, body=False):
        out, i = [], 0
        for m in re.finditer("<!-- ccs:([a-z]+(?: [a-z]+)?) -->", text):
            end = "<!-- /ccs:" + m.group(1) + " -->"
            j = text.index(end, m.end())
            out.append(self.fill(rel(text[i:m.start()], depth), self.slots(depth, body)) if body else re.escape(rel(text[i:m.start()], depth)))
            out.append(re.escape(m.group(0)) + "\\n*(?:" + self.region(m.group(1), depth, tagpage, body) + ")\\n*" + re.escape(end))
            i = j + len(end)
        rest = rel(text[i:], depth)
        out.append(self.fill(rest, self.slots(depth, body)) if body else re.escape(rest))
        return out

cache, diag = {}, [10]
def compiled(d, key, text, depth, tagpage, body=False):
    k = (d.d, key, depth, tagpage)
    if k not in cache:
        segs = d.page(text, depth, tagpage, body)
        cache[k] = (re.compile("".join(segs), re.S), segs)
    return cache[k]

# check: (None, donation box or None) if the page passes, else (reason, None)
def check(rp, got, d):
    depth, want = rp.count("/"), None
    if rp.startswith("proposals/"):
        name = rp[len("proposals/"):-len(".html")]
        if "/" in name: return "a page the design does not have", None
        if name not in md: return "a proposal page with no proposal (" + name + ".md) in the proposals repository", None
        want = md[name]
        # pages.jq prints the page, jq -r a newline after it, which the split keeps
        tries = [compiled(d, "proposal-" + s, d.p["proposal-" + s] + "\n", depth, False, True) for s in ("fr", "wip", "cp")]
    elif re.match("explore/tag/[^/]+/index\\.html$", rp):
        tries = [compiled(d, "tag", read(os.path.join(d.d, "explore/tag/example/index.html")), depth, True)]
    elif not rp.startswith(("parts/", "explore/tag/")) and os.path.isfile(os.path.join(d.d, rp)):
        tries = [compiled(d, rp, read(os.path.join(d.d, rp)), depth, False)]
    else: return "a page the design does not have", None
    best, why = 0, "not a page of the design as ccs-front-bash fills it"
    for rx, segs in tries:
        m = rx.fullmatch(got)
        if m and want is not None:
            g = m.groupdict()
            if not any(g["body"] == rel(b, depth) and (g.get("milestones") is None or same(g["milestones"], d.milestones(ms, depth)))
                       and (g.get("payouts") is None or same(g["payouts"], d.payouts(ps, depth))) for b, ms, ps in want):
                # the page of the design, but another text than the proposal has in the repository
                best, why = m.start("body"), "not the text, milestones or payouts of its proposal as the proposals repository has them"; continue
        if m:
            a = m.groupdict().get("address")
            if a is None: return None, None
            if a not in listed: return "a donation box with an address that is not in the signed list (" + a + ")", None
            return None, (a, m.group("qr").split(",", 1)[1])   # its base64
        if diag[0] <= 0: continue
        for k in range(len(segs), 0, -1):   # how far it is the design, for the reason (10 pages)
            m = re.match("".join(segs[:k]), got, re.S)
            if m: best = max(best, m.end()); break
    diag[0] -= 1
    return why + (" (it differs at character %d: %s)" % (best, json.dumps(got[best:best + 60])) if diag[0] >= 0 else ""), None

ds = [Design(d) for d in designs.split(":") if d]
for rp in sys.stdin.read().split("\0"):
    if not rp: continue
    p = os.path.join(site, rp)
    try:
        if os.path.getsize(p) > MAX: print(p + "\t!a page over %d MB" % (MAX >> 20)); continue
        got = read(p)
    except Exception: print(p + "\t!a page that is not UTF-8"); continue
    why = box = None
    for d in ds:
        try: why, box = check(rp, got, d)
        except KeyError as e: why = "the design has no part or slot " + str(e)
        except Exception as e: why = "a page that could not be checked (" + type(e).__name__ + ")"
        if why is None: break
    if why: print(p + "\t!" + why); continue
    if box: print(p + "\t=box\t" + box[0] + "\t" + box[1])
    print(p + "\t=ok")
'

# scan FILE...: the addresses (and reasons) of the pages, JSON and feed among FILEs; every data:
# image exactly the QR code of an address. The feed (feed.xml) has none, ever: an address found in
# it, spaced, split, drawn with look-alikes or even the wallet's own, holds it back
scan() {
    local file tag payload png out jsons=() texts=()
    (($#)) || return 0
    png=$(mktemp) out=$(mktemp)
    # a NUL byte: HTML drops it from the text, so it could split an address
    # (Python, not grep -P: a grep without PCRE, the image's, has none)
    printf '%s\0' "$@" | grep -zE '\.(html|json)$|/feed\.xml$' | xargs -0 -r python3 -I -c 'import sys
for f in sys.argv[1:]:
    with open(f, "rb") as h:
        if b"\0" in h.read(): print(f)' | sed 's/$/\t!a NUL byte (a browser drops it from the text)/'
    # the JSON, as JSON (its \u escapes are an address's characters to whoever reads it)
    mapfile -d '' jsons < <(printf '%s\0' "$@" | grep -zE '\.json$')
    if ((${#jsons[@]})); then
        timeout 60 python3 -I -c "$json_py" "${jsons[@]}" || printf '%s\t!the JSON could not be read in time\n' "${jsons[@]}"
    fi
    # the pages, JSON and feed as written; one that couldn't be read in time is held back (what it
    # has in it is unknown)
    mapfile -d '' texts < <(printf '%s\0' "$@" | grep -zE '\.(html|json)$|/feed\.xml$')
    if ((${#texts[@]})) && ! timeout 120 python3 -I -c "$scan_py" "${texts[@]}" > "$out" 2> /dev/null; then
        printf '%s\t!its addresses could not be read in time\n' "${texts[@]}" >> "$out"
    fi
    # each QR code: one image read once however often it is pushed (a page of 200 copies took a
    # minute), 4 a file at most (a proposal's page has one), and all of them within 5 minutes: past
    # that, a file is held back unchecked (the pushes after this one wait on its lock)
    local -A seen=() many=()
    local res end=$((SECONDS + 300))
    while IFS=$'\t' read -r file tag payload; do
        if [[ $file == "$staging/feed.xml" && $tag != '!'* ]]; then
            printf '%s\t%s\n' "$file" "!an address in the feed, which never has one (${tag:0:12}…)"; continue
        fi
        if [[ $tag != '?qr' ]]; then printf '%s\t%s\n' "$file" "$tag"; continue; fi
        many[$file]=$((${many[$file]:-0} + 1))
        if ((many[$file] > 4)); then
            ((many[$file] == 5)) && printf '%s\t%s\n' "$file" "!more than 4 QR codes in one file"
            continue
        fi
        if [[ ! -v seen[$payload] ]]; then
            if ((SECONDS >= end)); then
                res="!its QR codes could not be checked in time"
            elif base64 -d <<<"$payload" > "$png" 2> /dev/null && res=$(qrdata x "$png"); then
                res=${res#x$'\t'}
            else
                res="!an image that is not exactly qrencode's QR code of one address"
            fi
            seen[$payload]=$res
        fi
        printf '%s\t%s\n' "$file" "${seen[$payload]}"
    done < "$out"
    rm -f "$png" "$out"
}

# fetch: the proposals repository (/etc/ccs-gate/proposals.conf: PROPOSALS_GIT, its URL;
# PROPOSALS_BRANCH, default master), fetched each push, its last two commits (the backend's
# checkout may be one behind or ahead). Reviewed and merged: what a page says a proposal says, and
# the images it may show, come from here, not from the backend. Can't be fetched (disroot's Forgejo
# breaks off now and then): the last fetch is used, and said so. Sets hosts: where a link to a
# proposal may go: under the repository's own address (host and path: the forge's other users'
# pages are anyone's), and proposals.conf's LINK_HOSTS (the old forge's repository, host/path).
git=$state/proposals.git hosts=''
fetch() {
    local url='' branch=master k v h
    [[ -r $conf/proposals.conf ]] || return 1
    while IFS='=' read -r k v; do
        case $k in PROPOSALS_GIT) url=$v ;; PROPOSALS_BRANCH) branch=$v ;; LINK_HOSTS) hosts=$v ;; esac
    done < <(grep -E '^(PROPOSALS_GIT|PROPOSALS_BRANCH|LINK_HOSTS)=' "$conf/proposals.conf")
    [[ $url ]] || return 1
    if [[ $url == https://* ]]; then
        h=${url#https://}; h=${h%/}; h=${h%.git}
        if [[ $h == */* ]]; then k=${h%%/*}; h=${k##*@}/${h#*/}; else h=${h##*@}; fi
        hosts="$h $hosts"
    fi
    [[ -d $git ]] || git init -q --bare "$git" || return 1
    if GIT_TERMINAL_PROMPT=0 timeout 60 git -C "$git" fetch -q --no-tags --depth=2 "$url" "+refs/heads/$branch:refs/heads/ccs" 2> /dev/null; then
        fresh=1
        forge_up
    else
        say "could not fetch the proposals repository (proposals.conf): checking against the last fetch"
        forge_down
    fi
    git -C "$git" rev-parse -q --verify refs/heads/ccs > /dev/null
}

# forge_down: no good fetch ($state/fetch-ok, from forge_up: git rewrites FETCH_HEAD even when a
# fetch fails) for FORGE_HOURS (alert.conf, default 6) is an alert: a proposal merged or changed
# since can't go live. Once an hour while it lasts; forge_up says when it answers again. No
# fetch-ok yet: nothing known.
forge_down() {
    local hours t
    hours=$(sed -n 's/^FORGE_HOURS=\([1-9][0-9]*\)$/\1/p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    hours=${hours:-6}
    t=$(stat -c %Y "$state/fetch-ok" 2> /dev/null) || return 0
    (($(date +%s) - t >= hours * 3600)) || return 0
    touch "$state/forge-down" 2> /dev/null || true
    alert forge "the web server can't fetch the proposals repository since $(date -u -d "@$t" '+%F %H:%M UTC') (proposals.conf): a proposal merged or changed since can't go live @ @SITE@"
}
forge_up() {
    touch "$state/fetch-ok" 2> /dev/null || true
    [[ -f $state/forge-down ]] || return 0
    rm -f "$state/forge-down"
    say "the proposals repository can be fetched again"
    alert forge-ok "the web server fetches the proposals repository again @ @SITE@"
}

# repo_images: "blob path" for each proposal image in the fetched repository, as git ls-tree has
# them: a backend that isn't the one it was can't add an image of its own (a QR code cut into
# pieces, shown side by side, that a QR reader reads in none of them)
repo_images() {
    git -C "$git" ls-tree -r refs/heads/ccs -- images/ | awk -F '\t' '{ split($1, m, " ") } m[2] == "blob" { print m[3] " " $2 }'
}

# bodies: one file of markdown.awk's lines (each proposal's text as HTML) per commit fetched and
# markdown.awk installed (markdown*.awk, from the ccs-front-bash release the backend runs; two
# while it switches), ":"-separated; kept by commit, so a push made again needs no rendering. The
# images it shows, as ccs-bash copies them: images/<proposal>/<file>, a plain file, 2 MB at most,
# a PNG, JPEG or GIF by its first bytes.
bodies() {
    local rev c awkf sum out d list='' a f m
    for rev in refs/heads/ccs refs/heads/ccs~1; do
        c=$(git -C "$git" rev-parse -q --verify "$rev^{commit}" 2> /dev/null) || continue
        for awkf in "$conf"/markdown*.awk; do
            [[ -f $awkf ]] || continue
            sum=$(sha256sum < "$awkf" | cut -c1-16)
            out=$state/bodies-$c-$sum.jsonl
            if [[ ! -s $out ]]; then
                d=$(mktemp -d)
                # (all of it, or no text for this commit: a part unpacked would read as proposals
                # taken out, and their pages go, below)
                if ! { git -C "$git" archive "$c" | tar -x -C "$d"; } 2> /dev/null; then
                    say "could not unpack the proposals repository's commit $c: not checked against it"
                    rm -rf "$d"
                    continue
                fi
                (cd "$d" && find images -mindepth 2 -maxdepth 2 -type f 2> /dev/null) | while IFS= read -r a; do
                    [[ $a =~ ^images/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\.(png|jpg|jpeg|gif)$ ]] || continue
                    f=$d/$a
                    (($(wc -c < "$f") <= 2097152)) || continue
                    m=$(head -c 8 "$f" | od -An -tx1 | tr -d ' \n')
                    [[ $m == 89504e470d0a1a0a || $m == ffd8ff* || $m == 4749463837* || $m == 4749463839* ]] || continue
                    printf '%s\t%s\n' "$a" "${a#images/}"
                done > "$d/.images"
                find "$d" -maxdepth 1 -type f -name '*.md' -print0 \
                    | xargs -0 -r timeout 120 awk -v images="$d/.images" -f "$awkf" > "$out.tmp" && mv "$out.tmp" "$out"
                rm -rf "$d" "$out.tmp"
            fi
            [[ -s $out ]] && touch "$out" && list+=${list:+:}$out
        done
    done
    # the commits fetched before (not used for an hour): their files go
    find "$state" -maxdepth 1 -name 'bodies-*.jsonl' -mmin +60 -delete 2> /dev/null || true
    printf '%s' "$list"
}

# pages FILE...: the pages among FILEs (in staging) as pages_py checks them ("page<TAB>!reason").
# Only a page it passed goes live: one it didn't get to (out of time, or stopped) is held back
# too. A donation box's QR code must be, pixel for pixel, qrencode's of the address the box shows.
pages() {
    local designs='' d b vk='' out png file tag a q html=()
    local -A ok=() box=()
    for file in "$@"; do [[ $file == *.html ]] && html+=("${file#"$staging"/}"); done
    ((${#html[@]})) || return 0
    local end=$((SECONDS + 300))
    # (releases only, design/vX.Y.Z: a build of the design's of no release, left there, isn't one)
    for d in "$conf"/design/v*/; do [[ ${d%/} =~ /v[0-9]+\.[0-9]+\.[0-9]+$ && -d $d/parts ]] && designs+=${designs:+:}${d%/}; done
    b=$(bodies)
    [[ -f $list.viewkey ]] && vk=$list.viewkey
    # this site's onion address, for the footer's onion line (none: no line)
    local onion=''
    onion=$(tr -d ' \n' < "$conf/onion" 2> /dev/null) || onion=''
    [[ $onion =~ ^[a-z2-7]{56}\.onion$ ]] || onion=
    out=$(mktemp) png=$(mktemp)
    printf '%s\0' "${html[@]}" \
        | timeout 300 python3 -I -c "$pages_py" "$staging" "$designs" "$b" "$list" "$vk" "$hosts" "$onion" > "$out" 2> /dev/null || true
    while IFS=$'\t' read -r file tag a q; do
        case $tag in
            =ok) [[ ${ok[$file]:-} == no ]] || ok[$file]=1 ;;
            =box)
                # each box's QR code read once (one address's is on several pages), all within 5
                # minutes: past that, the page is held back unchecked
                if [[ ! -v box[$a$q] ]]; then
                    if ((SECONDS >= end)); then
                        box[$a$q]=late
                    elif base64 -d <<<"$q" > "$png" 2> /dev/null && [[ $(qrdata x "$png") == "x"$'\t'"$a" ]]; then
                        box[$a$q]=ok
                    else
                        box[$a$q]=no
                    fi
                fi
                case ${box[$a$q]} in
                    late) printf '%s\t%s\n' "$file" "!its donation box's QR code could not be checked in time"; ok[$file]=no ;;
                    no) printf '%s\t%s\n' "$file" "!a donation box whose QR code is not exactly qrencode's of its address"; ok[$file]=no ;;
                esac ;;
            *) printf '%s\t%s\n' "$file" "$tag"; ok[$file]=no ;;
        esac
    done < "$out"
    rm -f "$out" "$png"
    # (a page held back for a reason already says why; only one never checked gets this)
    for file in "${html[@]}"; do
        [[ ${ok[$staging/$file]:-} ]] || printf '%s\t%s\n' "$staging/$file" "!a page the gate could not check (in time)"
    done
}

# kinds: anything in the push that is neither a plain file nor a folder (a symlink: -munge makes
# it point nowhere, but it still replaces the live file of its name), a folder where the site has
# a file, or a file where it has a folder: each would take a live page away
kinds() {
    local f rel
    while IFS= read -r -d '' f; do
        rel=${f#"$staging"/}
        if [[ -L $f || ( ! -f $f && ! -d $f ) ]]; then printf '%s\t%s\n' "$f" "!not a plain file or folder"
        elif [[ -d $f && -e $live/$rel && ! -d $live/$rel ]]; then printf '%s\t%s\n' "$f" "!a folder where the site has a file"
        elif [[ -f $f && -d $live/$rel ]]; then printf '%s\t%s\n' "$f" "!a file where the site has a folder"
        fi
    done < <(find "$staging" -mindepth 1 -print0)
}

# feed_awk (-v site=SITE) < FEED: the feed (ccs-front-bash's feed.xml, RSS 2.0) line for line as it
# writes it; prints each linked page's name (decoded, one a line) once all of it passed, else the
# reason and exits 1. An
# item: "Funding required: " or "Fully funded: " and a title: escaped text, UTF-8, no markup even
# once a reader unescapes it (a reader may show a title as HTML: no &lt; or &gt;), no control or
# bidi characters, no run of 90 base58 or non-ASCII characters (an address, as pages_py); a link and
# guid to the same proposal page of SITE, its name percent-encoded as jq @uri does; a date. At most
# 100 items. Plain POSIX awk, bytes (LC_ALL=C): gawk, mawk and busybox read it alike.
feed_awk='
function fail(why) { print why; failed = 1; exit 1 }
# multibyte: each UTF-8 sequence as one \001; a byte left over 127 is not UTF-8
function chars(s) {
    gsub(/[\302-\337][\200-\277]|[\340-\357][\200-\277][\200-\277]|[\360-\364][\200-\277][\200-\277][\200-\277]/, "\001", s)
    return s
}
function title_ok(t,   u, w) {
    if (t == "" || t ~ /[\001-\037\177]/ || t ~ /\342\200[\252-\256]|\342\201[\246-\251]/) return 0
    u = t; gsub(/&(amp|quot|#39|apos);/, " ", u)
    if (u ~ /[<>"&]/) return 0
    w = chars(u)
    if (w ~ /[\200-\377]/ || length(w) > 1000) return 0
    while (match(w, /[1-9A-HJ-NP-Za-km-z\001]+/)) {
        if (RLENGTH >= 90) return 0
        w = substr(w, RSTART + RLENGTH)
    }
    return 1
}
# the file name a link names: %XX decoded (upper case, only where jq @uri encodes), else ""
function decode(e,   d, i, c, v) {
    if (e !~ /^[A-Za-z0-9._~%-]+$/ || length(e) > 1000) return ""
    d = ""
    for (i = 1; i <= length(e); i++) {
        c = substr(e, i, 1)
        if (c == "%") {
            if (substr(e, i + 1, 2) !~ /^[0-9A-F][0-9A-F]$/) return ""
            v = (index("0123456789ABCDEF", substr(e, i + 1, 1)) - 1) * 16 + index("0123456789ABCDEF", substr(e, i + 2, 1)) - 1
            c = sprintf("%c", v)
            if (v < 32 || v == 127 || v == 47 || c ~ /^[A-Za-z0-9._~-]$/) return ""
            i += 2
        }
        d = d c
    }
    if (d == "." || d == ".." || chars(d) ~ /[\200-\377]/) return ""
    return d
}
BEGIN {
    h[1] = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    h[2] = "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">"
    h[3] = "<channel>"
    h[4] = "<title>Monero Community Crowdfunding System</title>"
    h[5] = "<link>" site "/</link>"
    h[6] = "<description>Proposals put to Funding Required, and fully funded</description>"
    h[7] = "<atom:link href=\"" site "/feed.xml\" rel=\"self\" type=\"application/rss+xml\"/>"
    tag["Funding required"] = "funding-required"; tag["Fully funded"] = "funded"
    link = "<link>" site "/proposals/"; guid = "<guid isPermaLink=\"false\">" site "/proposals/"
    when = "^<pubDate>(Mon|Tue|Wed|Thu|Fri|Sat|Sun), [0-3][0-9] (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9][0-9][0-9][0-9] [0-2][0-9]:[0-5][0-9]:[0-6][0-9] \\+0000</pubDate>$"
    k = 0; n = 0; done = 0
}
done { fail("not the feed (lines after its last)") }
length($0) > 5000 { fail("not the feed (a line of over 5000 bytes)") }
NR <= 7 { if ($0 != h[NR]) fail("not the feed (its first lines)"); next }
k == 0 && $0 == "</channel>" { k = -1; next }
k == -1 { if ($0 != "</rss>") fail("not the feed (its last lines)"); done = 1; next }
k == 0 { if ($0 != "<item>") fail("item " (n + 1) " is not one the feed has"); n++; if (n > 100) fail("over 100 items"); k = 1; next }
k == 1 {
    if (!match($0, /^<title>(Funding required|Fully funded): /) || substr($0, length($0) - 7) != "</title>") fail("item " n " is not one the feed has")
    kind = substr($0, 8, RLENGTH - 9)
    if (!title_ok(substr($0, RLENGTH + 1, length($0) - RLENGTH - 8))) fail("item " n " is not one the feed has")
    k = 2; next
}
k == 2 {
    if (substr($0, 1, length(link)) != link || substr($0, length($0) - 11) != ".html</link>") fail("item " n " is not one the feed has")
    enc = substr($0, length(link) + 1, length($0) - length(link) - 12)
    name = decode(enc)
    if (name == "") fail("item " n ": a link to no proposal page of this site")
    k = 3; next
}
k == 3 { if ($0 != guid enc ".html#" tag[kind] "</guid>") fail("item " n ": its link, guid and kind differ"); k = 4; next }
k == 4 { if ($0 !~ when) fail("item " n " is not one the feed has"); k = 5; next }
k == 5 { if ($0 != "</item>") fail("item " n " is not one the feed has"); names[n] = name; k = 0; next }
END {
    if (failed) exit 1
    if (!done) { print "not the feed (its last lines)"; exit 1 }
    for (i = 1; i <= n; i++) print names[i]
}
'
# feed FILE: "FILE<TAB>!reason" unless it is the feed as feed_awk checks it, its links this site's
# (alert.conf's SITE_URL: without one, no feed passes) and each to a proposal page in the push or live
feed() {
    local site='' out name
    site=$(sed -n 's/^SITE_URL=//p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    site=${site%/}
    if [[ ! $site =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]]; then
        printf '%s\t%s\n' "$1" "!a feed, and no SITE_URL (https://host) in alert.conf for its links"; return
    fi
    if (($(wc -c < "$1") > 500000)) || [[ -n $(tail -c 1 "$1") ]]; then
        printf '%s\t%s\n' "$1" "!not the feed (over 500 kB, or no newline at its end)"; return
    fi
    if ! out=$(timeout 60 awk -v site="$site" "$feed_awk" < "$1" 2> /dev/null); then
        printf '%s\t!%s\n' "$1" "${out:-the feed could not be checked}"; return
    fi
    while IFS= read -r name; do
        [[ -z $name || -f $staging/proposals/$name.html || -f $live/proposals/$name.html ]] \
            || { printf '%s\t%s\n' "$1" "!a link to no proposal page of this site ($name)"; return; }
    done <<<"$out"
}

# changes: every file the push brings that isn't already live, byte for byte, as "file<TAB>!reason"
# for any that isn't allowed, and "file<TAB>address" for the addresses in a proposal image's QR codes
changes() {
    local f rel sum repo=''
    [[ $fetched ]] && repo=$(repo_images)
    while IFS= read -r -d '' f; do
        rel=${f#"$staging"/}
        cmp -s "$f" "$live/$rel" 2> /dev/null && continue
        case $rel in
            *.html | projects.json) ;;   # the pages and the /projects JSON: checked, all of them
            feed.xml) feed "$f" ;;
            subaddresses.txt | subaddresses.txt.asc | subaddresses.txt.key.asc)
                cmp -s "$f" "$conf/$rel" || printf '%s\t%s\n' "$f" "!not the $rel installed in $conf" ;;
            images/*/*)
                if [[ ! $rel =~ ^images/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\.(png|jpg|jpeg|gif)$ ]]; then
                    printf '%s\t%s\n' "$f" "!not a proposal image (images/<proposal>/<file>.png|jpg|jpeg|gif)"
                elif [[ ! $fetched ]]; then
                    printf '%s\t%s\n' "$f" "!a new image, and the proposals repository could not be read to check it"
                elif ! grep -qxF "$(git hash-object --no-filters -- "$f") $rel" <<<"$repo"; then
                    printf '%s\t%s\n' "$f" "!not the proposals repository's $rel"
                else
                    qr "$f" "$f" || true
                fi ;;
            *)
                sum=$(sha256sum < "$f" | cut -d' ' -f1)
                grep -qxF "$sum $rel" "$design" || printf '%s\t%s\n' "$f" "!not the design's (design.sha256)" ;;
        esac
    done < <(find "$staging" -type f -print0)
}

# ccs-receive --heartbeat, from a timer every 5 minutes as ccs-data (the backend's key can't pass
# arguments: its command= is fixed). Each push that arrives is the backend's heartbeat, every
# 2 minutes. None for HEARTBEAT_MINUTES (alert.conf, default 15) is an alert: the backend is off, its
# cron stopped, its key or network broken, which nothing on the backend can report itself. Not
# without a first push (nothing known yet), not while this machine has been up less than that (no
# push could arrive while it was down), and only on the second late check in a row, so pushes
# resuming after this machine's own network outage come first. Then once an hour at most, and a
# line when pushes arrive again.
heartbeat() {
    local d=$state minutes age up
    minutes=$(sed -n 's/^HEARTBEAT_MINUTES=\([1-9][0-9]*\)$/\1/p' "$conf/alert.conf" 2> /dev/null | tail -n 1)
    minutes=${minutes:-15}
    [[ -f $d/last-push ]] || return 0
    age=$((($(date +%s) - $(stat -c %Y "$d/last-push")) / 60))
    if ((age < minutes)); then
        rm -f "$d/heartbeat-late"
        if [[ -f $d/heartbeat-alerted ]]; then
            rm -f "$d/heartbeat-alerted"
            say "pushes from the backend arrive again"
            alert heartbeat-ok "pushes from the backend arrive again @ @SITE@"
        fi
        return 0
    fi
    up=$(($(cut -d. -f1 /proc/uptime) / 60))
    ((up >= minutes)) || return 0
    [[ -f $d/heartbeat-late ]] || { touch "$d/heartbeat-late"; return 0; }
    say "no push from the backend for $age minutes"
    alert heartbeat "no push from the backend for $age minutes: is it running? (its loop, its push key, its network) @ @SITE@"
    touch "$d/heartbeat-alerted"
}

if [[ ${1:-} == --heartbeat ]]; then heartbeat; exit 0; fi

# One push at a time: two at once would share the staging folder, and one could change it after
# the other's checks, before its copy into the live site.
exec 8> "$state/lock"
if ! flock -w 600 8; then
    say "refused the push: another one is still going after 10 minutes"
    alert lock "a push has been checked for over 10 minutes: the pushes after it are refused (the heartbeat would only say none arrived); look at what the gate is doing"
    exit 1
fi

# Staging starts as the live site each time: the push account can't delete, so whatever a
# refused push left in it would otherwise stay there and refuse every push after it.
rsync -a --delete "$live/" "$staging/"
rrsync -wo -no-del -munge "$staging"
touch "$state/last-push" 2> /dev/null || true   # the backend's heartbeat (--heartbeat)

# the list and its pin, as ccs-front-bash has them (tools/sign-subaddresses.sh: "sha256 <hex>")
list=$conf/subaddresses.txt
[[ -f $list && $(sha256sum < "$list" | cut -d' ' -f1) == "$(sed -n 's/^sha256 *//p' "$list.pin" 2> /dev/null)" ]] \
    || refuse "$list is not the list $list.pin names" list "its signed list isn't the one its .pin names"
command -v qrencode > /dev/null || refuse "it has no qrencode to check the QR codes with (apt install qrencode)" qrencode
command -v python3 > /dev/null || refuse "it has no python3 to check the pages with" python3
command -v git > /dev/null || refuse "it has no git to read the proposals repository with (apt install git)" git
python3 -I -c "$qrscan_py" --check > /dev/null 2>&1 \
    || refuse "it can't load libzbar, libpng, libturbojpeg and giflib to read the QR codes with (apt install libzbar0 libpng16-16 libturbojpeg0 libgif7)" zbar
# the design's files, "sha256  path" as sha256sum writes them (./ and binary-mode * dropped);
# several releases' may be in it
[[ -s $conf/design.sha256 ]] || refuse "it has no $conf/design.sha256 (the design release's files)" design
# the design's pages and parts (its release zip, unpacked in design/<release>/), and the
# markdown.awk that fills a proposal's text (ccs-front-bash's): several releases' while switching
compgen -G "$conf/design/v*/parts/proposal-fr.html" > /dev/null || refuse "it has no $conf/design/<release>/ (the design's release zip, unpacked: v0.1.25, say)" designs
[[ -r $conf/proposals.conf ]] || refuse "it has no $conf/proposals.conf (the proposals repository, for their text and images)" proposals
compgen -G "$conf/markdown*.awk" > /dev/null || refuse "it has no $conf/markdown.awk (ccs-front-bash's lib/markdown.awk)" markdown
design=$(mktemp)
trap 'rm -f "$design"' EXIT
sed -nE 's#^([0-9a-f]{64}) [ *](\./)?(.+)$#\1 \3#p' "$conf/design.sha256" > "$design"
# the checks below list files one a line, tab-separated: a name with a newline or tab can't be held back
if find "$staging" -name '*[[:cntrl:]]*' -print -quit | grep -q .; then refuse "a file name with a control character in it" names; fi
fetched='' fresh=''
fetch && fetched=1

# Which pages and JSON to check: the ones the push changed, and the ones held back last time
# (their last good copy is live, so the same file sent again must fail again). The live site
# holds only what passed, so a file the same as its live copy passed before, against the same
# list, allowed file, design, markdown.awk, proposals commit and gate: when any of those changes
# (a proposal taken out is a new commit), and once a day whatever happens, all are checked again.
mapfile -d '' all < <(find "$staging" -type f \( -name '*.html' -o -name '*.json' -o -path "$staging/feed.xml" \) -print0)
inputs=$( {
    cat -- "${BASH_SOURCE[0]}" "$list" "$list.pin" "$design" "$conf"/markdown*.awk "$conf/proposals.conf"
    cat -- "$conf/allowed" "$list.viewkey" "$conf/onion" 2> /dev/null || true
    grep '^SITE_URL=' "$conf/alert.conf" 2> /dev/null || true   # (the feed's links)
    (cd "$conf/design" && find . -type f -print0 | sort -z | xargs -0 -r sha256sum)
    git -C "$git" rev-parse -q --verify refs/heads/ccs 2> /dev/null || true
    qrencode -V 2>&1 || true
} | sha256sum | cut -c1-64)
full=''
[[ $inputs == "$(cat "$state/checked-with" 2> /dev/null)" && $(find "$state/checked-with" -mmin -1440 2> /dev/null) ]] || full=1
files=()
if [[ $full ]]; then
    files=("${all[@]}")
else
    declare -A again=()
    if [[ -f $state/held ]]; then while IFS= read -r f; do [[ $f ]] && again[$f]=1; done < "$state/held"; fi
    for f in "${all[@]}"; do
        rel=${f#"$staging"/}
        if [[ ${again[$rel]:-} ]] || ! cmp -s -- "$f" "$live/$rel"; then files+=("$f"); fi
    done
fi
say "checking ${#files[@]} of ${#all[@]} pages and JSON files${full:+ (all of them: the list, design, markdown.awk, proposals, gate or day changed)}"

# the list's addresses, then the allowed file's (first word of each line; # comments)
bad=$( { kinds; scan "${files[@]}"; pages "${files[@]}"; changes; } | awk -F '\t' 'NR == FNR { if ($1 !~ /^#/ && NF) ok[$1] = 1; next } !($2 in ok)' \
    <(cut -d' ' -f2 "$list"; awk '{ print $1 }' "$conf/allowed" 2> /dev/null) - | sort -u)
# A proposal taken out of the repository (troubleshooting.md, "Remove a proposal"): its page is
# still live, and the push account can't delete it, so every push after would hold it back and
# fail. It goes from the live site, with its images/<name>/, when the repository was fetched just
# now (not the last fetch), has its .md in neither commit, that is all that's wrong with it, and
# the push didn't send it (staging has the live copy): the backend no longer makes it either.
# Its absence is git's (neither commit's tree has the file), not only the texts': and at most
# CCS_GATE_REMOVE (3) a push. More at once (a branch emptied or rewritten, a forge answering
# wrong) stay held back, and IRC is told: a person decides.
if [[ $bad && $fresh ]]; then
    gone='' remove=()
    while IFS= read -r file; do
        rp=${file#"$staging"/} name=${file#"$staging"/proposals/}; name=${name%.html}
        [[ $rp == proposals/*.html && $name =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || continue
        awk -F '\t' -v f="$file" '$1 == f && $2 !~ /^!a proposal page with no proposal \(/ { x = 1 } END { exit x }' <<<"$bad" || continue
        cmp -s -- "$file" "$live/$rp" || continue
        git -C "$git" cat-file -e "refs/heads/ccs:$name.md" 2> /dev/null && continue
        git -C "$git" cat-file -e "refs/heads/ccs~1:$name.md" 2> /dev/null && continue
        remove+=("$file")
    done < <(awk -F '\t' '$2 ~ /^!a proposal page with no proposal \(/ { print $1 }' <<<"$bad" | sort -u)
    if ((${#remove[@]} > ${CCS_GATE_REMOVE:-3})); then
        say "${#remove[@]} proposal pages are in neither commit of the proposals repository: more than ${CCS_GATE_REMOVE:-3} at once, so none removed (held back; their last copies stay live)"
        alert remove-many "the web server would take ${#remove[@]} proposal pages off the site at once (their .md files are in neither commit of the proposals repository, proposals.conf): none taken, they stay as they were; is the branch right? @ @SITE@"
        remove=()
    fi
    for file in "${remove[@]}"; do
        rp=${file#"$staging"/} name=${file#"$staging"/proposals/}; name=${name%.html}
        # (one that can't be removed stays held back, as before)
        rm -rf -- "$file" "$live/${rp:?}" "$staging/images/${name:?}" "$live/images/${name:?}" 2> /dev/null || continue
        say "removed $rp (and images/$name/, if any) from the site: $name.md is no longer in the proposals repository"
        gone+=$file$'\n'
    done
    [[ ! $gone ]] || bad=$(awk -F '\t' 'NR == FNR { g[$0] = 1; next } !($1 in g)' <(printf '%s' "$gone") - <<<"$bad")
fi
# The rest of the push goes live; a file that fails keeps its last good copy (a new one stays
# out): one bad page doesn't stop the site updating, and nothing here rewrites a file. The push
# still fails, so the backend's log shows it.
if [[ $bad ]]; then
    # out of staging, so the copy below leaves the live one as it is. Not rsync exclude patterns:
    # a pattern without wildcards reads a backslash as itself, so an escaped name never matched
    nheld=0
    while IFS= read -r file; do
        [[ $file == "$staging"/* ]] || continue
        rm -rf -- "$file"   # a folder too (kinds)
        nheld=$((nheld + 1))
    done < <(cut -f1 <<<"$bad" | sort -u)
    say "held back $nheld file(s), with an address that isn't the wallet's nor allowed, or not allowed here; the rest goes live"
    while IFS=$'\t' read -r file addr; do say "  ${file#"$staging"/}: $addr"; done < <(head -n 10 <<<"$bad")
    # three alerts at most, one a file, of those not already sent this hour: a foreign address on
    # a page first, then elsewhere, then a page's other reason, then the rest's (decoys sent once
    # can't hide what comes after them)
    n=0
    declare -A told=()
    while IFS=$'\t' read -r file addr; do
        ((n < 3)) || break
        [[ ! ${told[$file]:-} ]] || continue
        told[$file]=1
        if [[ $addr == '!'* ]]; then
            alert "file-${file#"$staging"/}" "the web server held back a file: ${addr#!} (its last good copy stays) @ @SITE@/${file#"$staging"/}"
        else
            alert "addr-$addr" "the web server held back a page: donation address $red${addr:0:6}…${addr: -4}$off is not in the signed list (its last good copy stays) @ @SITE@/${file#"$staging"/}"
        fi
        [[ ! $sent ]] || n=$((n + 1))
    done < <(for k in '$2 !~ /^!/ && $1 ~ /\.html$/' '$2 !~ /^!/ && $1 !~ /\.html$/' '$2 ~ /^!/ && $1 ~ /\.html$/' '$2 ~ /^!/ && $1 !~ /\.html$/'; do
        awk -F '\t' "$k" <<<"$bad"
    done)
fi
# (modes fixed: a page pushed 600 would be a 403 for visitors, with no alert)
rsync -a --chmod=D755,F644 --delay-updates "$staging/" "$live/"
# what was held back, checked again next push; and, after checking all, what it was checked with
awk -F '\t' -v s="$staging/" 'index($1, s) == 1 { print substr($1, length(s) + 1) }' <<<"$bad" | sort -u > "$state/held.new" && mv "$state/held.new" "$state/held"
[[ ! $full ]] || printf '%s\n' "$inputs" > "$state/checked-with"
# 7 (which rsync never uses, and passes on): it went live but for the files held back, so the
# backend's ccs-watch still checks the live pages; a refused push is 1
[[ ! $bad ]] || exit 7
