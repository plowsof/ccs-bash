From 05308a53b0d49f26a796e5d9ad2f4adb7a370c82 Mon Sep 17 00:00:00 2001
From: plowsof <plowsof@protonmail.com>
Date: Thu, 22 Oct 2026 17:38:04 +0100
Subject: [PATCH] layouts: find a page's entry by local-url, not title

- titles with & < > " ' never matched (escaped in the JSON)
- a proposal with the same title could show its donation box here
- reported in MAGIC Grants' review of ccs-bash
---
 _layouts/cp.html  | 7 ++++++-
 _layouts/fr.html  | 7 ++++++-
 _layouts/wip.html | 7 ++++++-
 3 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/_layouts/cp.html b/_layouts/cp.html
index 334cdd6..c21d7e5 100644
--- a/_layouts/cp.html
+++ b/_layouts/cp.html
@@ -1,6 +1,11 @@
 ---
 layout: base
 ---
+{% comment %} This page's entry in the JSON is the one whose local-url is this file's,
+HTML-escaped as ccs-bash writes it. Matching by title missed escaped titles and let
+another proposal with the same title take this page's donation box. {% endcomment %}
+{% assign name_length = page.name.size | minus: 3 %}
+{% capture page_local_url %}/proposals/{{ page.name | slice: 0, name_length | escape }}.html{% endcapture %}
 <div class="site-wrap ffs-proposal ffs-cp">
 
 <div class="container ffs-breadcrumbs">
@@ -19,7 +24,7 @@ layout: base
                            {% for toplevel in site.data.completed-proposals %}
                              {% if toplevel.stage == "Completed Proposals" %}
                                 {% for proposal in toplevel.proposals%}
-                                  {% if proposal.name == {{page.title}} %}
+                                  {% if proposal.local-url == page_local_url %}
                             <h2>{{page.title}}</h2>
                                 <p class="author-list">by {{proposal.author}}</p>
                                 <p class="date-list">{{proposal.date}}</p>
diff --git a/_layouts/fr.html b/_layouts/fr.html
index 75292ad..d499a68 100644
--- a/_layouts/fr.html
+++ b/_layouts/fr.html
@@ -1,6 +1,11 @@
 ---
 layout: base
 ---
+{% comment %} This page's entry in the JSON is the one whose local-url is this file's,
+HTML-escaped as ccs-bash writes it. Matching by title missed escaped titles and let
+another proposal with the same title take this page's donation box. {% endcomment %}
+{% assign name_length = page.name.size | minus: 3 %}
+{% capture page_local_url %}/proposals/{{ page.name | slice: 0, name_length | escape }}.html{% endcapture %}
 
 <div class="site-wrap ffs-proposal ffs-fr">
 
@@ -21,7 +26,7 @@ layout: base
                            {% for toplevel in site.data.proposals %}
                              {% if toplevel.stage == "Funding Required" %}
                                 {% for proposal in toplevel.proposals%}
-                                  {% if proposal.name == {{page.title}} %}
+                                  {% if proposal.local-url == page_local_url %}
                             <h2>{{page.title}}</h2>
                                 <p class="author-list">{{proposal.author}}</p>
                                 <p class="date-list">{{proposal.date}}</p>
diff --git a/_layouts/wip.html b/_layouts/wip.html
index 3373ae0..3b79530 100644
--- a/_layouts/wip.html
+++ b/_layouts/wip.html
@@ -1,6 +1,11 @@
 ---
 layout: base
 ---
+{% comment %} This page's entry in the JSON is the one whose local-url is this file's,
+HTML-escaped as ccs-bash writes it. Matching by title missed escaped titles and let
+another proposal with the same title take this page's donation box. {% endcomment %}
+{% assign name_length = page.name.size | minus: 3 %}
+{% capture page_local_url %}/proposals/{{ page.name | slice: 0, name_length | escape }}.html{% endcapture %}
 <div class="site-wrap ffs-proposal ffs-wip"> 
     
 <div class="container ffs-breadcrumbs">
@@ -21,7 +26,7 @@ layout: base
                            {% for toplevel in site.data.proposals %}
                              {% if toplevel.stage == "Work in Progress" %}
                                 {% for proposal in toplevel.proposals%}
-                                  {% if proposal.name == {{page.title}} %}
+                                  {% if proposal.local-url == page_local_url %}
                             <h2>{{page.title}}</h2>
                             <p class="author-list">{{page.author}}</p>
                             <p class="date-list">{{page.date}}</p>
