#!/bin/bash
# gate-build OUT: build the site on the web server into OUT, the same way the backend builds it.
# Installed in the gate's image as /usr/local/bin/ccs-gate-build. Inputs come from the environment:
#   DATA      the push's site-data.json, as ccs-check data parsed and re-wrote it
#   GIT       the proposals repository the gate fetched (bare, refs/heads/ccs; newest commit)
#   MRS       https://host of the forge; each proposal's MR link is read from the history
#   MR_REPOS  host/path of the repositories, space-separated. A proposal's own gitlab_url is used
#             only if it points into one of them.
#   LIST      the signed list, with its .asc, .key.asc, .pin, .qr.sha256 and .viewkey beside it
#   DESIGN    an unpacked design release
#   QR        the list's QR codes (<address>.png). ccs-front-bash takes each only if its sum is
#             in the list's .qr.sha256.
#   ONION, SITE  the footer's onion address, and the base for the feed's links
# Step 1: lib/site-data.sh's site_from_data (the backend's own read_proposals, proposal_images
# and site.jq). Step 2: the vendored ccs-front-bash (vendor/ccs-front-bash).
# If any step fails, exits non-zero and OUT is not made.
set -euo pipefail
out=${1:?OUT}
: "${DATA:?DATA}" "${GIT:?GIT}" "${DESIGN:?DESIGN}" "${LIST:?LIST}" "${QR:?QR}"
here=$(dirname "$(readlink -f "$0")")
CCS_LIB=${CCS_GATE_LIB:-$here/../lib}
front=${CCS_FRONT_BASH:-$here/../vendor/ccs-front-bash}
# shellcheck source=lib/common.sh
source "$CCS_LIB/common.sh"
# shellcheck source=lib/proposals.sh
source "$CCS_LIB/proposals.sh"
# shellcheck source=lib/images.sh
source "$CCS_LIB/images.sh"
# shellcheck source=lib/site-data.sh
source "$CCS_LIB/site-data.sh"
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
mkdir -p "$t/proposals" "$t/data" "$t/work" "$t/list"
git -C "$GIT" archive refs/heads/ccs | tar -x -C "$t/proposals"
# Strip bidi controls from the proposals' text (ccs-check nobidi). They can display the text
# after them in a different order than written. 36c3.md has one, pasted in with a number.
# Only plain files, as read_proposals takes: a folder or a symlink named *.md is skipped there,
# and must not stop the build here.
md=()
for f in "$t"/proposals/*.md; do if [[ -f $f && ! -L $f ]]; then md+=("$f"); fi; done
((${#md[@]} == 0)) || "${CCS_CHECK:-ccs-check}" nobidi "${md[@]}" > /dev/null
PROPOSALS_DIR=$t/proposals OUTPUT_DIR=$t/data WORK=$t/work
links=''
if [[ ${MRS:-} ]]; then links=$t/links.json && merge_requests "$GIT" "$MRS" "${MR_REPOS:-}" > "$links"; fi
site_from_data "$DATA" "$LIST" "$links" "${MR_REPOS:-}"
cp "$DATA" "$t/data/site-data.json"
name=$(basename "$LIST")
for f in "$LIST" "$LIST.asc" "$LIST.key.asc" "$LIST.pin" "$LIST.qr.sha256" "$LIST.viewkey"; do
    if [[ -f $f ]]; then cp "$f" "$t/list/"; fi
done
ln -s "$(readlink -f "$QR")" "$t/list/$name.qr"
CCS_ONION=${ONION:-} CCS_SITE_URL=${SITE:-} bash "$front/ccs-front-bash.sh" "$DESIGN" "$t/data" "$t/proposals" "$out" "$t/list/$name"
