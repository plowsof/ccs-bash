#!/usr/bin/env bash
# ccs COMMAND: looking at the backend, by the names of ccs-back's artisan commands (so what a CCS
# maintainer typed there works here; docs/troubleshooting.md, "Looking"). As root on the backend,
# installed as /usr/local/bin/ccs. Only proposal:process changes anything (it runs the update).
#
#   ccs proposal:process          one run by hand, the loop paused for it (and started again after,
#                                 if it was running): this run's lines
#   ccs proposal:update           the ideas: each open MR looked at, and why it is or isn't one
#   ccs generate:addresses [F.md] which proposal has which subaddress (proposals.csv)
#   ccs wallet:notify [N]         the funding-required proposals' donations, and the last N (20)
#   ccs deposit:list [F.md]       every deposit as JSON: the live wallet's and each retired one's
#   ccs log [N]                   the errors and warnings of the last N runs (3), once each, with
#                                 what troubleshooting.md says of them
#   ccs status                    the loop, the last run, the wallet, the forge, the backup, the
#                                 web server, the releases
#   ccs config:check              every file setup needs (contrib/examples/backend): there, as
#                                 setup makes it, filled in, agreeing, and answering
#
# It reads the state as ccs, its owner (root never opens a file another account controls: it
# could be a link to any file), prints no password or key, and changes nothing else.
set -euo pipefail
export LC_ALL=C.UTF-8
CONFIG=${CCS_CONFIG:-/etc/ccs/ccs.conf}
DOCS=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../docs
as_ccs=(runuser -u ccs --)
[[ ${CCS_AS:-} != none ]] || as_ccs=()   # (the tests: no ccs user)

die() { echo "ccs: $*" >&2; exit 1; }
# conf KEY DEFAULT: one key of the config, as written (a sourced file: read here, not run)
conf() { local v; v=$(sed -n "s/^$1=//p" "$CONFIG" 2> /dev/null | tail -n 1); v=${v%\"}; v=${v#\"}; printf '%s' "${v:-$2}"; }
STATE_DIR=$(conf STATE_DIR /var/lib/ccs/state)
OUTPUT_DIR=$(conf OUTPUT_DIR /var/lib/ccs/out)
PROPOSALS_DIR=$(conf PROPOSALS_DIR /var/lib/ccs/proposals)
read_ccs() { "${as_ccs[@]}" cat -- "$1"; }
# the backend compose (docs/docker.md): its run folder, when the host's loop isn't running
RUN_DIR=${CCS_RUN_DIR:-/var/lib/ccs/run}
compose() { [[ -d $RUN_DIR/push ]] && ! systemctl is-active -q ccs-bash 2> /dev/null; }
# the log: the host loop's file; the compose's is journald's (journalctl -t ccs), its last lines
# copied to a file here and read as the host's is. CCS_LOG: a file, either way
LOG=${CCS_LOG:-} LOG_NAME=''
journal() { journalctl -q -o cat -t ccs "$@" > "$LOG" 2> /dev/null || true; }
if [[ -z $LOG ]]; then
    if compose; then
        LOG=$(mktemp) LOG_NAME="the journal's last lines (journalctl -t ccs)"; trap 'rm -f "$LOG"' EXIT
        journal -n 20000
    else
        LOG=/var/log/ccs-bash.log
    fi
fi
# a compose service's container: SERVICE
container() { docker ps -q --filter label=com.docker.compose.project=backend --filter "label=com.docker.compose.service=$1" | head -n 1; }
stage_num() { local v; v=$(cat "$RUN_DIR/$1/${2:-done}" 2> /dev/null) || v=0; [[ $v =~ ^[0-9]+$ ]] && echo "$v" || echo 0; }
# a run going now: the host's update script, or the compose's pull past its push
running() {
    if compose; then
        (($(stage_num pull) > $(stage_num push))) || (($(stage_num pull started) > $(stat -c %Y "$RUN_DIR/push/done" 2> /dev/null || echo 0)))
    else
        pgrep -x ccs-bash-update > /dev/null
    fi
}

# the state as JSON: {"file.md": {index, address, since, url}}
state_json() {
    read_ccs "$STATE_DIR/proposals.csv" | jq -R -s '
        def csvrow: [("," + .) | match(",(\"(?:[^\"]|\"\")*\"|[^,]*)"; "g") | (.captures[0].string // "")
                     | if startswith("\"") then .[1:-1] | gsub("\"\""; "\"") else . end];
        split("\n") | map(select(. != "") | csvrow | {key: .[0], value: {url: .[1], index: (.[2] | tonumber? // null), address: .[3], since: .[4]}}) | from_entries'
}
xmr() { jq -r '. / 1e12 | . * 1e4 | floor / 1e4 | tostring'; }

# "FROM TO": the lines of the last N runs that have ended, by "== run <time>" (ccs-bash-update
# writes it at each start); a run going now is left out (it hasn't said everything yet). A log
# from before the markers: its last 400 lines
runs_range() {
    local n=$1 total marks to
    total=$(wc -l < "$LOG")
    marks=$(grep -n '^== run ' "$LOG" | cut -d: -f1)
    if [[ -z $marks ]]; then echo "$((total > 400 ? total - 399 : 1)) $total"; return; fi
    to=$total
    if running; then to=$(($(tail -n 1 <<<"$marks") - 1)); marks=$(sed '$d' <<<"$marks"); fi
    echo "$(tail -n "$n" <<<"$marks" | head -n 1) $to"
}

# the rows of troubleshooting.md's tables whose first cell names a message: {re, where, says}
hints() {
    [[ -f $DOCS/troubleshooting.md ]] || { echo '[]'; return; }
    jq -R -s '
        def re_escape: gsub("(?<c>[.^$|()\\[\\]{}*+?\\\\])"; "\\\(.c)");
        def unlink: gsub("\\[(?<t>[^\\]]*)\\]\\([^)]*\\)"; .t) | gsub("\\*\\*"; "") | gsub("`"; "");
        reduce (split("\n")[]) as $l ({where: "", rows: []};
            if $l | startswith("## ") then .where = ($l | ltrimstr("## "))
            elif $l | test("^\\| `") then
                ($l | ltrimstr("| ") | rtrimstr(" |") | split(" | ")) as $c | .where as $w
                # (11 characters at least of the message itself: not "could not …", nor placeholders only)
                | .rows += [$c[0] | [scan("`([^`]+)`") | .[0]] | .[] | select(gsub("<[^>]*>|…|\\b[NH]\\b|[ :.,()]"; "") | length >= 11)
                    | {re: (re_escape | gsub("…"; ".*") | gsub("<[^>]*>"; ".*") | gsub("\\b[NH]\\b"; "[0-9]+")),
                       lit: (gsub("<[^>]*>|…"; "") | length), where: $w, says: ($c[1:] | map(unlink) | join("; "))}]
            else . end)
        # the most particular first: "could not fetch ideas from GitLab" before "could not …"
        | .rows | sort_by(-.lit)' "$DOCS/troubleshooting.md"
}

# the compose's: a line on the pull's "now" pipe; this run is the one that starts after it, and
# its lines are printed once its push is done (10 minutes at most)
compose_process() {
    local started before n at t0
    started=$(stage_num pull started) before=$(stage_num pull) t0=$(date +%s)
    printf 'now\n' 1<> "$RUN_DIR/pull/now"
    for _ in $(seq 600); do (($(stage_num pull started) != started)) && break; sleep 1; done
    (($(stage_num pull started) != started)) || die "no run started in 10 minutes: look at the compose (ccs status, docker compose logs)"
    at=$(grep -n '^== run ' "$LOG" | tail -n 1 | cut -d: -f1)
    for _ in $(seq 600); do (($(stage_num pull) > before)) && break; sleep 1; done
    n=$(stage_num pull)
    for _ in $(seq 600); do (($(stage_num push) >= n)) && break; sleep 1; done
    (($(stage_num push) >= n)) || die "run $n isn't done after 10 minutes: look at the compose (ccs status, docker compose logs)"
    # (the journal's: its lines since, up to the next run's start, if that has begun)
    if [[ -z ${CCS_LOG:-} ]]; then journal --since "@$t0"; awk '/^== run / { m++ } m == 1' "$LOG" > "$LOG.run" && mv "$LOG.run" "$LOG"; at=1; fi
    tail -n +"${at:-1}" "$LOG" | grep -vE '^\s*$|^(skipping|ignoring) ' || true
    echo "(run $n of the compose; $(tail -n +"${at:-1}" "$LOG" | grep -cE '^(skipping|ignoring) ' || true) proposal files skipped or ignored: ccs log shows why)"
}

cmd_process() {
    local was start
    if compose; then compose_process; return; fi
    was=$(systemctl is-active ccs-bash 2> /dev/null || true)
    for _ in $(seq 60); do pgrep -x ccs-bash-update > /dev/null || break; sleep 5; done
    if [[ $was == active ]]; then
        trap 'systemctl start ccs-bash; echo "(the loop: $(systemctl is-active ccs-bash))"' EXIT
        systemctl stop ccs-bash
        for _ in $(seq 60); do pgrep -x ccs-bash-update > /dev/null || break; sleep 5; done
    fi
    pgrep -x ccs-bash-update > /dev/null && die "a run is still going after 5 minutes: look at it first (ccs status)"
    start=$(wc -l < "$LOG")
    /usr/local/bin/ccs-bash-update || true
    tail -n +"$((start + 1))" "$LOG" | grep -vE '^\s*$|^(skipping|ignoring) ' || true
    echo "($(tail -n +"$((start + 1))" "$LOG" | grep -cE '^(skipping|ignoring) ' || true) proposal files skipped or ignored: ccs log shows why)"
}

cmd_ideas() {
    local cache=$STATE_DIR/ideas.cache iid sha file rc why
    echo "Ideas shown (open MRs adding a proposal that reads):"
    read_ccs "$OUTPUT_DIR/proposals.json" | jq -r '[.. | objects | select(has("upvotes") and has("gitlab-url"))] | if length == 0 then "  (none)" else .[] | "  \(."gitlab-url"): \(.name) (\(.author), \(.date); 👍 \(.upvotes // "?") 👎 \(.downvotes // "?"))" end'
    echo "Every open MR looked at (the most recently updated, at most IDEAS_MAX):"
    "${as_ccs[@]}" test -s "$cache" || { echo "  (none yet: no run since the cache was emptied)"; return; }
    while IFS=$'\t' read -r iid sha file rc; do
        [[ $iid =~ ^[0-9]+$ ]] || continue
        if [[ $file == - ]]; then why="adds no proposal (one new .md at the root, and only its images)"
        elif "${as_ccs[@]}" test -e "$PROPOSALS_DIR/$file"; then why="$file: merged already"
        elif [[ $rc == 0 ]]; then why="$file: an idea"
        else why="$file: doesn't read as a proposal: $(grep -F "MR !$iid's" "$LOG" | tail -n 1 | sed 's/.*doesn.t read as a proposal: //')"
        fi
        echo "  MR !$iid (${sha:0:8}): $why"
    done < <(read_ccs "$cache")
}

cmd_addresses() {
    state_json | jq -r --arg f "${1:-}" '
        to_entries | map(select($f == "" or .key == $f)) as $all
        | ($all | map(select(.value.index != null)) | sort_by(.value.index)[] | "Project: \(.key), subaddress \(.value.index), address: \(.value.address)\(if .value.since != "" then ", funding since \(.value.since)" else "" end)"),
          "(\($all | map(select(.value.index == null)) | length) without a subaddress: not funding required yet, retired, or never)"'
}

cmd_notify() {
    local n=${1:-20} st
    [[ $n =~ ^[0-9]+$ ]] || die "wallet:notify N: a number"
    st=$(state_json)
    echo "Funding required:"
    read_ccs "$OUTPUT_DIR/projects.json" | jq -r '
        map(select(.state == "FUNDING-REQUIRED")) | sort_by(.filename) | if length == 0 then "  (none)" else .[]
        | "  \(.filename): \(.raised_amount) of \(.target_amount) XMR raised, \(.contributions) donation(s), \(.percentage_funded)%" end'
    echo "The last $n donations to the live wallet (deposits.csv: the confirmed ones a run kept):"
    read_ccs "$STATE_DIR/deposits.csv" 2> /dev/null | awk -F, 'NR > 1' | tail -n "$n" | jq -R -r --argjson s "$st" '
        split(",") as $d | ($s | to_entries | map(select(.value.index == ($d[2] | tonumber))) | .[0].key // "subaddress \($d[2]), no proposal") as $p
        | "Donation to \"\($p)\": \($d[3] | tonumber / 1e12) XMR, height \($d[0]), tx \($d[1][0:16])…"'
}

cmd_deposits() {
    local st f
    st=$(state_json)
    {
        read_ccs "$STATE_DIR/deposits.csv" 2> /dev/null | awk -F, 'NR > 1' | jq -R --argjson s "$st" '
            split(",") as $d | {wallet: "live", proposal: ($s | to_entries | map(select(.value.index == ($d[2] | tonumber))) | .[0].key // null),
                height: ($d[0] | tonumber), txid: $d[1], subaddress: ($d[2] | tonumber), amount: (($d[3] | tonumber) / 1e12)}'
        for f in $("${as_ccs[@]}" find "$STATE_DIR/retired" -maxdepth 1 -name '*.csv' 2> /dev/null | sort); do
            read_ccs "$f" | awk -F, 'NR > 1' | jq -R --arg w "$(basename "$f" .csv)" '
                split(",") as $d | {wallet: $w, proposal: $d[5], height: ($d[0] | tonumber), txid: $d[1], subaddress: ($d[2] | tonumber), amount: (($d[3] | tonumber) / 1e12)}'
        done
    } | jq -s --arg f "${1:-}" 'map(select($f == "" or .proposal == $f))'
}

cmd_log() {
    local n=${1:-3} from to
    [[ $n =~ ^[0-9]+$ && $n -gt 0 ]] || die "log N: a number"
    read -r from to <<<"$(runs_range "$n")"
    echo "The errors and warnings of the last $n run(s), lines $from to $to of ${LOG_NAME:-$LOG} (each once, the last time it was said):"
    # (and the gate's reason for each file it held back: "ccs-gate:   <file>: <why>")
    sed -n "${from},${to}p" "$LOG" | grep -iE 'error|warning|fail|refus|held back|alert|could not|can.t |cannot|denied|timed out|not ok|stop|^ccs-gate:   ' \
        | grep -vE 'ccs-watch: the [0-9]+ pages on .* are what was pushed|^(skipping|ignoring) ' \
        | jq -R -s -r --argjson h "$(hints)" '
            split("\n") | map(select(. != "")) | map({line: ., msg: sub("^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8} "; "")})
            | group_by(.msg) | map({line: .[-1].line, msg: .[0].msg, n: length}) | sort_by(.line)[]
            | . as $e | ([$h[] | select(.re as $r | $e.msg | test($r))][0]) as $m
            | "\($e.line)\(if $e.n > 1 then "  (×\($e.n))" else "" end)",
              (if $m then "    ↳ \($m.where): \($m.says | .[0:300])" else empty end)' \
        | grep . || echo "  (none)"
    # the proposal files a run leaves out (troubleshooting.md, "A proposal isn't on the site"):
    # the same each run, so once, at the end
    echo "Proposal files left out (not on the site):"
    sed -n "${from},${to}p" "$LOG" | grep -E '^(skipping|ignoring) ' | sort -u | sed 's/^/  /' | grep . || echo "  (none)"
}

cmd_status() {
    local last at failed f
    age() { local t; t=$("${as_ccs[@]}" stat -c %Y "$1" 2> /dev/null) || { echo "never"; return; }; echo "$(( ($(date +%s) - t) / 60 )) min ago"; }
    if compose; then
        # each service: running or not, and its healthcheck's last word
        echo "the loop: the backend compose ($(docker ps -a --filter label=com.docker.compose.project=backend --format '{{.Label "com.docker.compose.service"}} {{.State}} {{.Status}}' 2> /dev/null \
            | grep -v '^init ' | sed -E 's/^([^ ]+ [^ ]+) .*\((healthy|unhealthy|health: starting)\).*/\1 \2/; t; s/^([^ ]+ [^ ]+) .*/\1/' | sort | paste -sd ',' - | sed 's/,/, /g'))$(running && echo ", a run going now")"
        echo "the stages: $(for s in pull ccs-bash backup front push watch; do printf '%s %s; ' "$s" "$(cat "$RUN_DIR/$s/status" 2> /dev/null || echo '?')"; done)"
    else
        echo "the loop: $(systemctl is-active ccs-bash 2> /dev/null || true)$(running && echo ", a run going now")"
    fi
    at=$(grep -n '^== run ' "$LOG" | tail -n 1) || at=''
    if [[ $at ]]; then
        read -r f last <<<"$(runs_range 1)"
        failed=$(sed -n "${f},${last}p" "$LOG" | grep -o 'this run failed (.*' | tail -n 1 || true)
        echo "the last run (ended): $(sed -n "${f}s/^== run //p" "$LOG") UTC, ${failed:-ok}"
    else
        # (a log from before "== run": a failed run ends with its "this run failed", after its pages line)
        last=$(grep -E 'ccs-watch: (this run failed|the [0-9]+ pages on)' "$LOG" | tail -n 1)
        if [[ $last == *"this run failed"* ]]; then echo "the last run: ${last#*ccs-watch: }"; else echo "the last run: ok (${last:0:19})"; fi
    fi
    echo "the proposals pulled: $(age /var/lib/ccs/pull-ok); GitLab/Forgejo answered: $(age "$STATE_DIR/forge-ok")"
    if compose; then
        f=$(find "$RUN_DIR/backup" -maxdepth 1 -name 'sent-*' -printf '%T@ %p\n' 2> /dev/null | sort -rn | head -n 1 | cut -d' ' -f2-)
        echo "the state backed up: $(age "${f:-/nonexistent}") (sent when it changes; the backup stage: $(cat "$RUN_DIR/backup/status" 2> /dev/null || echo '?'))"
    else
        echo "the state backed up: $(age /var/lib/ccs/backup-sent) (sent when it changes)"
    fi
    echo "the web server: $(grep -E 'ccs-watch: (the [0-9]+ pages|ALERT)' "$LOG" | tail -n 1 | cut -c1-160)"
    f=$(read_ccs "$OUTPUT_DIR/projects.json" 2> /dev/null | jq -r '[length, (map(select(.state == "FUNDING-REQUIRED")) | length)] | "\(.[0]) proposals, \(.[1]) funding required"' 2> /dev/null || echo "no projects.json")
    echo "the site: $f"
    echo "the wallet: $(wallet_line)"
    if compose; then
        echo "the releases: the compose's images: $(docker ps --filter label=com.docker.compose.project=backend --format '{{.Label "com.docker.compose.service"}}={{.Image}}' 2> /dev/null | sort -u -t= -k2,2 | sed 's/sha256:\(.\{12\}\).*/\1/' | paste -sd ' ' -), design $(cut -d' ' -f1 /opt/ccs-front-hugo/VERSION 2> /dev/null || echo '?')"
    else
        echo "the releases: ccs-bash $(release /usr/local/bin/ccs-bash-run), ccs-front-bash $(release /usr/local/bin/ccs-front-run), design $(cut -d' ' -f1 /opt/ccs-front-hugo/VERSION 2> /dev/null || echo '?')"
    fi
}
# release RUN_SCRIPT: the version its comment names ("# v0.2.29, by ID"), else the image ID it starts
release() {
    local v
    v=$(grep -o '# v[0-9.]*, by ID' "$1" 2> /dev/null | head -n 1 | sed 's/# //; s/, by ID//')
    [[ $v ]] || v="image $(grep -o -- '--pull never sha256:[0-9a-f]\{12\}' "$1" 2> /dev/null | head -n 1 | sed 's/.*sha256://')"
    echo "${v:-?}"
}
# the wallet's height and the node's, the wallet's main address (its config's login, not shown)
wallet_line() {
    local url user pass h a
    url=$(conf RPC_URL http://127.0.0.1:18082/json_rpc) user=$(conf RPC_USER '') pass=$(conf RPC_PASSWORD '')
    # (the login on stdin, not in a command line other users could see; the compose's wallet
    # asked from ccs-bash's container, the one that can reach it)
    local in=()
    if compose; then in=(docker exec -i "$(container ccs-bash)"); fi
    r() { printf 'user = "%s:%s"\n' "$user" "$pass" | "${in[@]}" curl -fsS -m 20 --digest -K - "$url" -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"$1\"$2}"; }
    h=$(r get_height '' | jq -r .result.height) || { echo "doesn't answer at $url"; return; }
    a=$(r get_address ',"params":{"account_index":0}' | jq -r .result.address) || a='?'
    echo "${a:0:6}…${a: -4} at height $h$( [[ $a == "$(conf WALLET_ADDRESS '')" ]] || echo ", NOT the config's WALLET_ADDRESS")"
}

# config:check: every file the backend needs (contrib/examples/backend), as setup makes it, and
# whether its parts agree and answer. Reads only; never prints a password, key or alert URL.
# CCS_CHECK_ROOT: the files under another folder, CCS_CHECK_OFFLINE=1: nothing asked (the tests)
# shellcheck disable=SC2015  # (ok, bad and warn always succeed: A && ok || bad is if-then-else)
cmd_check() {
    local root=${CCS_CHECK_ROOT:-} cdir=${CCS_COMPOSE_DIR:-/opt/ccs-bash/contrib/docker/backend} fails=0 warns=0
    local env wconf aconf url port host hostmode='' f v
    ok() { echo "ok   $*"; }
    bad() { echo "FAIL $*"; fails=$((fails + 1)); }
    warn() { echo "warn $*"; warns=$((warns + 1)); }
    # kv FILE KEY: KEY's value in FILE (KEY=value lines; quotes dropped), the last one
    kv() { local v; v=$(sed -n "s/^$2=//p" "$root$1" 2> /dev/null | tail -n 1); v=${v%\"}; v=${v#\"}; printf '%s' "$v"; }
    # file PATH OWNER GROUP MODE: there, owned as setup makes it, its mode no looser than MODE
    # (a stricter one is fine), no <placeholder> left
    file() {
        local p=$root$1 o g m n r=0
        [[ -e $p ]] || { bad "$1: missing (contrib/examples/backend$1)"; return 1; }
        read -r o g m <<<"$(stat -c '%U %G %a' "$p")"
        if [[ $CCS_AS != none && "$o $g" != "$2 $3" ]]; then bad "$1: owned by $o:$g, not $2:$3"; r=1; fi
        if ((8#$m & ~8#$4)); then bad "$1: mode $m, looser than $4"; r=1; fi
        # (the keys named, never their values)
        n=$(grep -vE '^\s*#' "$p" | grep -cE '<[^>]+>|=change-me$|^WALLET_ADDRESS=4\.\.\.$' || true)
        if ((n)); then bad "$1: $n line(s) still to fill in ($(grep -vE '^\s*#' "$p" | grep -E '<[^>]+>|=change-me$|=4\.\.\.$' | cut -d= -f1 | sort -u | paste -sd ' ' -))"; r=1; fi
        return "$r"
    }
    CCS_AS=${CCS_AS:-}
    env=/${cdir#/}/.env wconf=/etc/ccs-wallet/wallet-rpc.conf aconf=/etc/ccs/alert.conf
    echo "== the files"
    file /etc/ccs/ccs.conf root ccs 640 && ok "/etc/ccs/ccs.conf"
    file $wconf root ccs-wallet 640 && ok "$wconf"
    file $aconf root ccs 640 && ok "$aconf"
    file /etc/ccs/trusted-signers root root 644 && ok "/etc/ccs/trusted-signers"
    for f in subaddresses.txt subaddresses.txt.asc subaddresses.txt.key.asc subaddresses.txt.pin list-signers; do
        file "/etc/ccs-front/$f" root root 644 && ok "/etc/ccs-front/$f"
    done
    file /var/lib/ccs/.ssh/id_ed25519 ccs ccs 600 && ok "/var/lib/ccs/.ssh/id_ed25519 (the push key)"
    file /var/lib/ccs/.ssh/known_hosts ccs ccs 644 && ok "/var/lib/ccs/.ssh/known_hosts"
    if [[ -e $root$env ]]; then
        file "$env" root root 600 && ok "$env (the compose)"
        file /etc/ccs/backup/id_ed25519 ccs ccs 600 && ok "/etc/ccs/backup/id_ed25519 (the backup key)"
        file /etc/ccs/backup/known_hosts ccs ccs 600 && ok "/etc/ccs/backup/known_hosts"
        [[ $(kv "$env" COMPOSE_FILE) == *compose.host.yml* ]] && hostmode=1
    else
        warn "no $env: the host setup (setup.md), not the compose; its run scripts aren't checked here"
    fi

    echo "== they agree"
    url=$(kv /etc/ccs/ccs.conf RPC_URL) port=$(kv $wconf rpc-bind-port)
    host=${url#*://} host=${host%%[:/]*}
    [[ $url == *":$port/"* ]] && ok "RPC_URL's port is wallet-rpc.conf's ($port)" || bad "RPC_URL's port isn't wallet-rpc.conf's rpc-bind-port ($port)"
    [[ $(kv $wconf rpc-login) == "$(kv /etc/ccs/ccs.conf RPC_USER):$(kv /etc/ccs/ccs.conf RPC_PASSWORD)" ]] \
        && ok "RPC_USER and RPC_PASSWORD are wallet-rpc.conf's rpc-login" || bad "RPC_USER:RPC_PASSWORD isn't wallet-rpc.conf's rpc-login"
    v=$(kv /etc/ccs/ccs.conf WALLET_ADDRESS)
    if [[ $v =~ ^4[1-9A-HJ-NP-Za-km-z]{94}$ ]]; then ok "WALLET_ADDRESS: a mainnet address"
    elif [[ $v =~ ^[9A][1-9A-HJ-NP-Za-km-z]{94}$ ]]; then warn "WALLET_ADDRESS: a testnet address"
    else bad "WALLET_ADDRESS: not a main address (95 characters, 4...)"; fi
    if [[ -e $root$env ]]; then
        [[ $(kv "$env" WALLET_PORT) == "${port:-x}" || ( -z $(kv "$env" WALLET_PORT) && $port == 18182 ) ]] \
            && ok ".env's WALLET_PORT is the wallet's port (its healthcheck)" || bad ".env's WALLET_PORT isn't rpc-bind-port ($port): the wallet never shows healthy, ccs-bash never starts"
        for v in CCS_BASH_IMAGE CCS_FRONT_IMAGE WALLET_IMAGE; do [[ $(kv "$env" $v) =~ ^sha256:[0-9a-f]{64}$ ]] || bad ".env's $v: not an image ID (sha256:...)"; done
        if [[ $hostmode ]]; then
            [[ $host == 127.0.0.1 || $host == localhost ]] && ok "RPC_URL on 127.0.0.1 (compose.host.yml)" || bad "RPC_URL: with compose.host.yml, http://127.0.0.1:$port/json_rpc"
        else
            [[ $host == wallet-rpc ]] && ok "RPC_URL: wallet-rpc, on the compose's wallet network" || bad "RPC_URL: http://wallet-rpc:$port/json_rpc (or compose.host.yml)"
            # what a container can't reach on this machine's 127.0.0.1
            [[ $(kv $wconf daemon-address) == 127.0.0.1:* || $(kv $wconf daemon-address) == localhost:* ]] \
                && bad "daemon-address on 127.0.0.1: the wallet's container can't reach it (compose.host.yml, or another address)"
            grep -qE '^(ALERT_URL|WATCH_PROXY)=.*(127\.0\.0\.1|localhost)' "$root$aconf" 2> /dev/null \
                && bad "alert.conf: the bot or a proxy on 127.0.0.1: the watch's container can't reach it (compose.host.yml)"
        fi
    fi
    [[ $(kv $aconf SUBADDRESSES) == /etc/ccs-front/subaddresses.txt ]] && ok "alert.conf's SUBADDRESSES" || warn "alert.conf: no SUBADDRESSES=/etc/ccs-front/subaddresses.txt (an alert won't name a foreign address)"
    [[ $(kv $aconf WATCH_PROXY) ]] && ok "alert.conf's WATCH_PROXY" || warn "alert.conf: no WATCH_PROXY (the web server can tell the watcher by its address)"

    [[ ${CCS_CHECK_OFFLINE:-} ]] && { echo "($fails failed, $warns warnings; nothing asked: CCS_CHECK_OFFLINE)"; ((fails == 0)); return; }
    echo "== they answer"
    local in=() user pass a k
    if compose; then in=(docker exec -i "$(container ccs-bash)"); fi
    user=$(kv /etc/ccs/ccs.conf RPC_USER) pass=$(kv /etc/ccs/ccs.conf RPC_PASSWORD)
    rq() { printf 'user = "%s:%s"\n' "$user" "$pass" | "${in[@]}" curl -fsS -m 20 --digest -K - "$url" -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"$1\"$2}"; }
    if a=$(rq get_address ',"params":{"account_index":0}' | jq -er .result.address); then
        [[ $a == "$(kv /etc/ccs/ccs.conf WALLET_ADDRESS)" ]] && ok "the wallet answers, with WALLET_ADDRESS" || bad "the wallet answers with another address than WALLET_ADDRESS"
        # view-only: asking for its spend key must fail (the answer is never printed)
        k=$(rq query_key ',"params":{"key_type":"spend_key"}' | jq -r '.result.key // empty' 2> /dev/null || true)
        if [[ -z $k ]]; then ok "the wallet is view-only"
        elif [[ $(kv /etc/ccs/ccs.conf WALLET_ADDRESS) == [9A]* ]]; then warn "the wallet can spend (a testnet wallet: allowed)"
        else bad "the wallet can spend: use a view-only one (handover, 1)"; fi
    else bad "the wallet doesn't answer at RPC_URL"; fi
    v=$(kv /etc/ccs/ccs.conf REPOSITORY_URL)
    curl -fsS -m 20 -o /dev/null "$v" && ok "REPOSITORY_URL answers" || bad "REPOSITORY_URL doesn't answer ($v)"
    v=$(runuser -u ccs-git -- git -C "$(kv /etc/ccs/ccs.conf PROPOSALS_DIR)" remote get-url origin 2> /dev/null || true)
    [[ $v ]] && ok "the proposals checkout, from $v" || bad "PROPOSALS_DIR: not a checkout ccs-git can read"
    if [[ -e $env ]]; then
        local who kh
        for who in CCS_PUSH:/var/lib/ccs/.ssh/known_hosts CCS_BACKUP:/etc/ccs/backup/known_hosts; do
            v=$(kv "$env" "${who%%:*}") kh=${who#*:} host=${v#*@}
            if timeout 10 bash -c ": > /dev/tcp/$host/22" 2> /dev/null; then ok "${who%%:*}: $host answers on 22"; else bad "${who%%:*}: $host doesn't answer on 22"; fi
            ssh-keygen -F "$host" -f "$kh" > /dev/null 2>&1 && ok "${who%%:*}: $host's host key in $kh" || bad "${who%%:*}: no host key for $host in $kh"
        done
        local sigs=${CCS_SIGS_REPO:-/opt/ccs-sigs} id
        for v in CCS_BASH_IMAGE CCS_FRONT_IMAGE; do
            id=$(kv "$env" $v); id=${id#sha256:}
            docker image inspect "sha256:$id" > /dev/null 2>&1 || { bad ".env's $v: no such image here"; continue; }
            grep -rqs --include='*SHA256SUMS*' "^$id " "$sigs" && ok ".env's $v: attested in ccs-sigs (contrib/release/verify checks by whom)" \
                || bad ".env's $v: in no attestation in $sigs (a dev build?)"
        done
        docker image inspect "$(kv "$env" WALLET_IMAGE)" > /dev/null 2>&1 && ok ".env's WALLET_IMAGE is here" || bad ".env's WALLET_IMAGE: no such image here"
    fi
    echo "($fails failed, $warns warnings)"
    ((fails == 0))
}

case ${1:-} in
    proposal:process) cmd_process ;;
    proposal:update) cmd_ideas ;;
    generate:addresses) cmd_addresses "${2:-}" ;;
    wallet:notify) cmd_notify "${2:-}" ;;
    deposit:list) cmd_deposits "${2:-}" ;;
    log) cmd_log "${2:-}" ;;
    status) cmd_status ;;
    config:check) cmd_check ;;
    *) sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p}' "$0" | sed '/^set /d'; exit 1 ;;
esac
