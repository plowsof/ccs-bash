#!/usr/bin/env bash
# ccs-watch SITE_URL OUT [CONF]: the backend watching the web server. After each run, and between
# runs at random times (ccs-watch.timer, docs/handover.md), fetch the pages where donations are
# asked for (home, Funding Required, Donate, Verify, every funding-required proposal), and some
# others at random, from SITE_URL as a visitor's browser would, and check their addresses: every
# address on them (95 or 106 base58 characters, as text or link) is one of the wallet's signed
# list (SUBADDRESSES) or allowed (WATCH_ALLOWED: the General Fund), read as the gate reads them
# with ccs-check (in the ccs-bash image: entities, groups, letters drawn as an address's, and a
# bidi control fails a page; without it, 95 or 106 base58 characters as text or link); each
# funding-required proposal's donation box is its own address, as ccs-bash gave it
# (OUT/projects.json), and its one image the QR code of that address, the list's own file
# (SUBADDRESSES.qr/). A page that fails on three fetches
# alerts, the second time it is seen within a day. Also a page that doesn't exist (it must answer
# 404) and, with the themes, the theme button's redirect. The web server builds the pages itself:
# what they say is its gate's to check; what this sees is a web server serving a visitor an
# address that isn't the wallet's.
# CONF (default /etc/ccs/alert.conf, root-owned, not in any repository):
#   ALERT_URL=https://bot.example/simple?channel=%23ccs   POSTed the message as plain text
#                                                         (CptHook's simple module, ntfy, ...)
#   ALERT_TARGET=#channel  ALERT_PASSWORD=...             instead, wmb's /directedMessage JSON
#                                                         (ALERT_URL=http://127.0.0.1:8081/directedMessage)
#   WATCH_PROXY=socks5h://127.0.0.1:9050                  recommended: fetch through a proxy, or
#                                                         several (space-separated), one picked at
#                                                         random for each fetch: Tor and a clearnet
#                                                         one elsewhere (ssh -D), so the web server
#                                                         can't tell the watcher by its address
#   WATCH_THEMES=1                                        also /dark/ and /light/ (the theme lines
#                                                         in docs/two-machines.md): each page under
#                                                         one of the three, at random
#   WATCH_SAMPLE=10                                       how many of the other proposals' pages to
#                                                         check too, at random each run (default 10)
#   WATCH_FIREFOX_ESR=140 WATCH_FIREFOX=144 WATCH_CHROME=141
#                                                         optional: the browsers' current versions
#                                                         (Tor Browser's Firefox ESR, Firefox,
#                                                         Chrome): one asked as, at random each
#                                                         run; a version no one runs is a tell
#   SUBADDRESSES=/etc/ccs-front/subaddresses.txt          the signed list (the default), its QR
#                                                         codes in subaddresses.txt.qr/ beside it
#   WATCH_ALLOWED=888tNk...                               the other addresses a page may show,
#                                                         space-separated (default: the General Fund)
#   WATCH_DESIGN_SUMS=/etc/ccs-front/design.sha256        the design release's files' sums
#                                                         (sha256sum's lines, ./assets/...): what
#                                                         the pages' images under assets/ must be
#   WATCH_PROPOSALS=/var/lib/ccs/proposals                the proposals checkout: what a
#                                                         proposal's image (images/...) must be
#   FORGE_HOURS=6                                         optional: how long GitLab or Forgejo may
#                                                         be down before --run alerts (default 6)
#   ALERT_PREFIX=[CCS-watch]                              optional: how messages start
#   ALERT_PLAIN=1                                         optional: no IRC colours (for ntfy and the like)
# One alert per problem an hour; "unreachable" after 3 runs in a row. Logs to stderr.
#
# ccs-watch --run RESULT [CONF]: ccs-bash-update tells it how the whole run went, "ok" or the
# steps that failed ("ccs-bash", "the push", ...). The page check above only runs after a good
# push, so it can't see a backend that has stopped: this does. Three failed runs in a row (about
# six minutes; one or two are a blip) alert, once an hour while it lasts; the first good run
# after that says so. A GitLab or Forgejo outage isn't a failed run (ccs-bash keeps the old data),
# but one that lasts alerts: no good pull of the proposals (/var/lib/ccs/pull-ok, which
# ccs-bash-update touches after one) or no answer from its API (ccs-bash's STATE_DIR/forge-ok) for
# FORGE_HOURS (CONF, default 6), and new merged proposals and Ideas aren't reaching the site. Once
# an hour while it lasts, and a line when both answer again.
set -euo pipefail
# ccs-watch --test SITE_URL [CONF]: send one test message, to check ALERT_URL works
test_only=''
if [[ ${1:-} == --test ]]; then
    [[ ${2:-} == http* ]] || { echo "usage: ccs-watch --test SITE_URL [CONF]" >&2; exit 2; }
    test_only=1; set -- "$2" /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
run_result=''
if [[ ${1:-} == --run ]]; then
    [[ ${2:-} ]] || { echo "usage: ccs-watch --run ok|STEPS [CONF]" >&2; exit 2; }
    run_result=$2; set -- - /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
site_url=${1:?SITE_URL} out=${2:?OUT} conf=${3:-/etc/ccs/alert.conf}
state=${CCS_WATCH_STATE:-/var/lib/ccs/state/watch}
ALERT_URL='' WATCH_PROXY='' WATCH_THEMES='' SUBADDRESSES='' ALERT_PREFIX='' ALERT_TARGET='' ALERT_PASSWORD='' ALERT_PLAIN='' FORGE_HOURS=''
WATCH_DESIGN_SUMS='' WATCH_PROPOSALS=''
WATCH_FIREFOX_ESR='' WATCH_FIREFOX='' WATCH_CHROME='' WATCH_ALLOWED='' WATCH_SAMPLE=${WATCH_SAMPLE:-}
keys='ALERT_URL|WATCH_PROXY|WATCH_THEMES|SUBADDRESSES|ALERT_PREFIX|ALERT_TARGET|ALERT_PASSWORD|ALERT_PLAIN|FORGE_HOURS|WATCH_FIREFOX_ESR|WATCH_FIREFOX|WATCH_CHROME|WATCH_ALLOWED|WATCH_SAMPLE|WATCH_DESIGN_SUMS|WATCH_PROPOSALS'
if [[ -f $conf ]]; then
    # only these keys, KEY=value lines; nothing in it is run
    while IFS='=' read -r k v; do
        [[ $k =~ ^($keys)$ ]] && printf -v "$k" '%s' "$v"
    done < <(grep -E "^($keys)=" "$conf")
fi
# IRC colours as CptHook's GitLab messages have them: the [CCS-watch] tag light blue (12), a
# bad address red (04); none with ALERT_PLAIN
if [[ $ALERT_PLAIN ]]; then blue='' red='' off=''; else blue=$'\x0312' red=$'\x0304' off=$'\x03'; fi
ALERT_PREFIX=${ALERT_PREFIX:-"[${blue}CCS-watch${off}]"}
[[ $test_only ]] || mkdir -p "$state"
log() { printf '%s ccs-watch: %s\n' "$(date -u '+%F %T')" "$*" | sed 's/\x03[0-9]*//g' >&2; }   # no IRC colours in the log

# alert KEY MESSAGE: post MESSAGE (to the log always), at most once an hour for the same KEY
alert() {
    local stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    log "ALERT: $2"
    [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]] && return 0
    touch "$stamp"
    [[ $ALERT_URL ]] || return 0
    send "$ALERT_PREFIX $2" || log "could not send the alert to ALERT_URL"
}

# send MESSAGE: to ALERT_URL, as wmb's JSON when ALERT_TARGET is set (the password goes in the
# body, on stdin: never on a command line), else as plain text
send() {
    if [[ $ALERT_TARGET ]]; then
        jq -n --arg t "$ALERT_TARGET" --arg m "$1" --arg p "$ALERT_PASSWORD" '{Target: $t, IncomingMessage: {Message: $m, Password: $p}}' \
            | curl -fsS --max-time 20 --data-binary @- -H 'Content-Type: application/json' "$ALERT_URL" > /dev/null
    else
        curl -fsS --max-time 20 --data-binary "$1" -H 'Content-Type: text/plain' "$ALERT_URL" > /dev/null
    fi
}

# fetch URL FILE: only a whole answer counts: HTTP 200, not empty, within 60s (curl also fails a
# body cut short of its Content-Length). 1 if nothing answered; 3 if the web server answered
# something else (its status in $code, a redirect's target in $location): a page that keeps doing
# that is an alert (below), as a web server sending visitors elsewhere would. Never a "differs".
# Asked for as a visitor's browser asks, one of three for the whole run, at random: Tor Browser
# (its Firefox ESR), Firefox or Chrome, each with its own user agent and the headers it sends, a
# page as a page (Sec-Fetch-Dest: document...) and a stylesheet, font or image as one, compressed
# as it compresses (what this curl can undo of it), through one of the proxies at random: a web
# server serving the watcher the right pages and visitors others must first tell it apart from
# them, and a rule for all but one browser is seen too. A page is asked for as a visitor arrives
# at it, at random: typed in or from a bookmark (Sec-Fetch-Site: none), a click on the site itself
# (same-origin: from Funding Required, say) or on another (cross-site: getmonero.org's link); never
# only one way, or a web server could change the page for the others. No Referer: the site's
# Referrer-Policy (no-referrer) has a browser send none to it either.
# Its TLS handshake is still curl's, which a web server can tell from a browser's.
read -ra proxies <<<"$WATCH_PROXY"
v() { [[ $1 =~ ^[1-9][0-9]{1,3}$ ]] && echo "$1" || echo "$2"; }
esr=$(v "$WATCH_FIREFOX_ESR" 140) firefox=$(v "$WATCH_FIREFOX" 144) chrome=$(v "$WATCH_CHROME" 141)
enc=$(curl -V 2> /dev/null | awk '/^Features:/ { f = " " $0 " " } END {
    e = "gzip, deflate"; if (f ~ / brotli /) e = e ", br"; if (f ~ / zstd /) e = e ", zstd"; print e }')
origin=$(sed -E 's#^([a-z]+://[^/]+).*#\1#' <<<"$site_url")
browser=$(shuf -n 1 -e tor firefox chrome)
case $browser in
    tor) ua="Mozilla/5.0 (Windows NT 10.0; rv:$esr.0) Gecko/20100101 Firefox/$esr.0" lang='en-US,en;q=0.5' ;;
    firefox) ua="Mozilla/5.0 (X11; Linux x86_64; rv:$firefox.0) Gecko/20100101 Firefox/$firefox.0" lang='en-US,en;q=0.5' ;;
    chrome) ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/$chrome.0.0.0 Safari/537.36" lang='en-US,en;q=0.9' ;;
esac
code='' location=''
fetch() {
    local proxy='' kind=() out rc=0
    ((${#proxies[@]})) && proxy=${proxies[RANDOM % ${#proxies[@]}]}
    if [[ $browser == chrome ]]; then
        kind=(-H "sec-ch-ua: \"Google Chrome\";v=\"$chrome\", \"Not?A_Brand\";v=\"8\", \"Chromium\";v=\"$chrome\"" -H 'sec-ch-ua-mobile: ?0' -H 'sec-ch-ua-platform: "Windows"')
        case ${1%%[?#]*} in
            *.css) kind+=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind+=(-H 'Accept: */*' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind+=(-H 'Accept: image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind+=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    else
        case ${1%%[?#]*} in
            *.css) kind=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind=(-H 'Accept: application/font-woff2;q=1.0,application/font-woff;q=0.9,*/*;q=0.8' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind=(-H 'Accept: image/avif,image/webp,image/png,image/svg+xml,image/*;q=0.8,*/*;q=0.5' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    fi
    # (16 MB at most, as received or once decompressed: the site's largest file is a few hundred
    # KB, and a web server's endless or compressed answer would otherwise fill /tmp, which is memory;
    # one over that is an answer, but not the page: 3, as a wrong status is)
    out=$(curl -sS --max-time 60 --max-filesize "${WATCH_MAX_BYTES:-16777216}" ${proxy:+--proxy "$proxy"} --compressed -A "$ua" -H "Accept-Language: $lang" \
        -H "Accept-Encoding: $enc" "${kind[@]}" -o "$2" -w '%{http_code}\t%{redirect_url}' "$1" 2> /dev/null) || rc=$?
    if ((rc == 63)); then code='with more than 16 MB' location=''; : > "$2"; return 3; fi
    if ((rc)); then code=000 location=''; else code=${out%%$'\t'*} location=${out#*$'\t'}; fi
    [[ $code == 200 && -s $2 ]] && return 0
    [[ $code != 000 ]] && return 3
    return 1
}

# sighted FILE...: 0 if any of these marks a difference seen within the last 24 hours (the second
# sighting: alert); else 1, the first, marked now. A run that sees no difference doesn't clear it:
# a web server showing its own page only on every other push is still seen twice.
sighted() {
    local f now
    now=$(date +%s)
    for f in "$@"; do
        [[ -f $f ]] && ((now - $(stat -c %Y "$f") < 86400)) && return 0
    done
    touch "$@"
    return 1
}

# forge: the proposals' forge down for FORGE_HOURS (above). A file not there yet (before the first
# good pull or answer) is nothing known, not an outage.
forge() {
    local hours=6 f path what t down=''
    [[ $FORGE_HOURS =~ ^[1-9][0-9]*$ ]] && hours=$FORGE_HOURS
    for f in "${CCS_WATCH_PULL:-/var/lib/ccs/pull-ok}|the proposals repository (git pull)" \
        "${CCS_WATCH_FORGE:-/var/lib/ccs/state/forge-ok}|its API (Ideas, merge requests)"; do
        path=${f%%|*} what=${f#*|}
        t=$(stat -c %Y "$path" 2> /dev/null) || continue
        (($(date +%s) - t >= hours * 3600)) || continue
        down+="${down:+, }$what since $(date -u -d "@$t" '+%F %H:%M UTC')"
    done
    if [[ $down ]]; then
        touch "$state/forge-down"
        alert forge "GitLab/Forgejo hasn't answered for over ${hours}h: $down. New merged proposals and Ideas aren't on the site (the last ones stay)"
    elif [[ -f $state/forge-down ]]; then
        rm -f "$state/forge-down"
        alert forge-ok "GitLab/Forgejo answers again: the proposals and Ideas are up to date"
    fi
}

if [[ $run_result ]]; then
    forge
    n=$(cat "$state/failed-runs" 2> /dev/null || echo 0)
    if [[ $run_result == ok ]]; then
        ((n < 3)) || alert backend-ok "the backend runs again, after $n failed runs"
        rm -f "$state/failed-runs" "$state/failed-since"
        exit 0
    fi
    n=$((n + 1)); echo "$n" > "$state/failed-runs"
    [[ -f $state/failed-since ]] || date -u '+%F %H:%M UTC' > "$state/failed-since"
    log "this run failed ($run_result), $n in a row"
    ((n < 3)) || alert backend "the backend has failed $n runs in a row since $(cat "$state/failed-since"): $run_result (ccs log on the backend)"
    exit 0
fi

if [[ $test_only ]]; then
    [[ $ALERT_URL ]] || { echo "no ALERT_URL in $conf" >&2; exit 1; }
    if ! send "$ALERT_PREFIX test, please ignore @ $1"; then echo "could not send" >&2; exit 1; fi
    echo "sent"
    exit 0
fi

# what the pages are checked against: the signed list and its QR codes, the allowed addresses,
# and each proposal's own address (ccs-bash's projects.json)
list=${SUBADDRESSES:-/etc/ccs-front/subaddresses.txt}
[[ -r $list && -r $out/projects.json ]] || { log "no $list or $out/projects.json: nothing to check the pages against"; exit 1; }
WATCH_ALLOWED=${WATCH_ALLOWED:-888tNkZrPN6JsEgekjMnABU4TBzc2Dt29EPAvkRxbANsAnjyPbb3iQ1YBRk1UXcdRsiKc9dhwMVgN5S9cQUiyoogDavup3H}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/img"
# what the pages' images are checked against, byte for byte (images): the design release's sums,
# the proposals checkout; one not here: those images not checked, said once a run
sums=${WATCH_DESIGN_SUMS:-/etc/ccs-front/design.sha256} props=${WATCH_PROPOSALS:-/var/lib/ccs/proposals}
[[ -r $sums ]] || { log "no $sums (the design's sums): the pages' images under assets/ not checked"; sums=''; }
[[ -d $props/images ]] || props=''
{ awk 'NF >= 2 { print $2 }' "$list"; tr ' ' '\n' <<<"$WATCH_ALLOWED"; } | grep . | sort -u > "$tmp/ok"
# each proposal page's name, its address (funding required: its donation box's; "" for none)
jq -r '.[] | select(.filename | type == "string") | [(.filename | sub("\\.md$"; "")), (if .state == "FUNDING-REQUIRED" then .address // "" else "" end)] | @tsv' \
    "$out/projects.json" > "$tmp/proposals" || { log "$out/projects.json can't be read"; exit 1; }

# the pages: the fixed ones, every funding-required proposal's, and WATCH_SAMPLE (10) of the other
# proposals' at random, so that each is seen within a few runs (a web server could add a donation
# box to any page); /projects, the JSON others read. Each under one of the theme prefixes at random
prefixes=('')
[[ $WATCH_THEMES ]] && prefixes+=(dark/ light/)
pre() { printf '%s' "${prefixes[RANDOM % ${#prefixes[@]}]}"; }
[[ $WATCH_SAMPLE =~ ^[0-9]+$ ]] || WATCH_SAMPLE=10
checks=()
for p in '' funding-required/ donate/ verify/; do checks+=("$(pre)$p"$'\t'"-"); done
while IFS=$'\t' read -r name a; do checks+=("$(pre)proposals/$name.html"$'\t'"$a"); done < <(awk -F '\t' '$2 != ""' "$tmp/proposals")
while IFS=$'\t' read -r name _; do checks+=("$(pre)proposals/$name.html"$'\t'"-"); done < <(awk -F '\t' '$2 == ""' "$tmp/proposals" | shuf -n "$WATCH_SAMPLE")
checks+=("projects"$'\t'"-")
pages=$(awk -F '\t' '$2 != ""' "$tmp/proposals" | grep -c . || true); pages=$((pages + 4))
fetches=${#checks[@]}
# and, among them at random (no fixed last ask that a web server could switch after): a page that
# doesn't exist, named like the site's own, which must answer 404; with the themes, the theme
# button (?theme=dark|light|system) on a page, which must send the visitor to that same page
# under that prefix (or none), not elsewhere
checks+=(missing)
[[ $WATCH_THEMES ]] && checks+=("theme"$'\t'"$(shuf -n 1 -e '' funding-required/ donate/ verify/)")
mapfile -t checks < <(printf '%s\n' "${checks[@]}" | grep . | shuf)   # in no fixed order

bad=0 failed=0 answered=()
urlof() { printf '%s/%s' "$site_url" "$(jq -rn --arg p "$1" '$p | split("/") | map(@uri) | join("/")')"; }
short() { sed -E 's/^(.{6}).*(.{4})$/\1…\2/' | paste -sd ' '; }

# the gate's scan (ccs-check: in the ccs-bash image; CCS_CHECK, another), or none
scanner=${CCS_CHECK-$(command -v ccs-check || true)}

# norm PATH: PATH without its . and .. steps; fails for one that steps out of the site
norm() {
    local s out=()
    IFS=/ read -ra parts <<<"$1"
    for s in "${parts[@]}"; do
        case $s in
            '' | .) ;;
            ..) ((${#out[@]})) || return 1; unset 'out[${#out[@]}-1]' ;;
            *) out+=("$s") ;;
        esac
    done
    (IFS=/; printf '%s' "${out[*]}")
}

# image_ok PATH FILE: "" if the site's image PATH, fetched into FILE, is one the watcher knows
# byte for byte; else what is wrong. Not answered: nothing known, ""
image_ok() {
    local p=$1 f=$2 a sum
    case $p in
        qr/*.png)
            a=${p#qr/} a=${a%.png}
            [[ $a =~ ^[1-9A-HJ-NP-Za-km-z]{95}$ && -f $list.qr/$a.png ]] || { echo "an image that isn't one of the signed list's QR codes ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            cmp -s "$f" "$list.qr/$a.png" || echo "a QR code that isn't the signed list's file of its address ($p)" ;;
        images/*)
            [[ $props ]] || return 0
            [[ -f $props/$p && ! -L $props/$p ]] || { echo "an image no proposal has ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            cmp -s "$f" "$props/$p" || echo "an image that isn't its proposal's, as the proposals repository has it ($p)" ;;
        *)
            [[ $sums ]] || return 0
            sum=$(awk -v p="./$p" '$2 == p { print $1; exit }' "$sums")
            [[ $sum ]] || { echo "an image that isn't the design's ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            [[ $(sha256sum < "$f" | cut -d' ' -f1) == "$sum" ]] || echo "an image that isn't the design's file ($p)" ;;
    esac
}

# images FILE PAGE: "" if every image the page FILE (PAGE, its path on the site) shows (<img>,
# its src and srcset) is a design file (its sum the design release's), a QR code of the signed
# list's, or a proposal's image as the proposals repository has it, each compared byte for byte;
# else what is wrong. Nothing here reads what an image shows: a picture of another address's QR
# code, anywhere on a page, is a file none of those has (review 12's L-2). Each fetched once a run.
images() {
    local src p f why dir='' base
    [[ $2 == */* ]] && dir=${2%/*}
    # (a <base href>, as a browser takes it: the site's 404 page has <base href="&#47;">)
    base=$(grep -oiE '<base[^>]*href="[^"]*"' "$1" | head -n 1 | sed -E 's/.*href="//; s/"$//; s/&#0*47;|&#[xX]0*2[fF];/\//g' || true)
    case $base in
        "$origin"/*) dir=${base#"$origin"/} dir=${dir%/} ;;
        /*) dir=${base#/} dir=${dir%/} ;;
        '') ;;
        *) dir=${dir:+$dir/}${base%/} ;;
    esac
    while IFS= read -r src; do
        [[ $src ]] || continue
        case $src in
            "$origin"/*) p=${src#"$origin"/} ;;
            //* | *://* | data:*) echo "an image from elsewhere ($src)"; return ;;
            /*) p=${src#/} ;;
            *) p=${dir:+$dir/}$src ;;
        esac
        p=${p%%[?#]*}
        p=$(norm "$p") || { echo "an image out of the site ($src)"; return; }
        p=${p#dark/} p=${p#light/}
        f=$tmp/img/${p//\//_}
        [[ ! -e $f.ok ]] || continue
        [[ ! -e $f.bad ]] || { cat "$f.bad"; return; }
        why=$(image_ok "$p" "$f")
        if [[ $why ]]; then printf '%s\n' "$why" > "$f.bad"; printf '%s\n' "$why"; return; fi
        [[ ! -s $f ]] || : > "$f.ok"
    done < <(grep -oiE '<img[^>]*>' "$1" | grep -oiE '(src|srcset)="[^"]*"' | sed -E 's/^[A-Za-z]+="//; s/"$//' | tr ',' '\n' | awk '{ print $1 }')
}

# wrong FILE WANT [PAGE]: "" if every address on the page FILE (as text or a link, read as the gate
# reads it: scanner) is the list's or allowed, every image it shows one known byte for byte
# (images; PAGE, its path on the site) and, WANT not "-", its donation box (a monero: link), if
# it shows one, WANT's alone, its one image the QR code qr/WANT.png, the list's file of it; else what is wrong
wrong() {
    local found foreign box region imgs lines why first='' mode=scan
    if [[ $scanner ]]; then
        IFS= read -r -n 1 first < "$1" || true
        case $first in '['|'{') mode=json ;; esac
        lines=$("$scanner" "$mode" "$1" 2> /dev/null) || { echo "the gate's scan (ccs-check) could not read the page"; return; }
        lines=$(cut -f2- <<<"$lines")
        found=$(grep -v '^[!?]' <<<"$lines" | sort -u || true)
        # (a page that doesn't start as one: the gate's rule for what goes live, not an address)
        why=$(grep '^[!?]' <<<"$lines" | grep -v '^!not text that starts as a page' | head -n 1 || true)
        [[ $why != \?qr* ]] || why="!a data: image (a QR code that isn't the list's file)"
        [[ ! $why ]] || { echo "the page fails the gate's scan: ${why#!}"; return; }
    else
        found=$(grep -oE '(^|[^1-9A-HJ-NP-Za-km-z])([1-9A-HJ-NP-Za-km-z]{106}|[1-9A-HJ-NP-Za-km-z]{95})([^1-9A-HJ-NP-Za-km-z]|$)' "$1" \
            | grep -oE '[1-9A-HJ-NP-Za-km-z]{95,106}' | sort -u || true)
    fi
    foreign=$(comm -23 <(printf '%s\n' "$found" | grep .) "$tmp/ok" | head -n 3 || true)
    [[ ! $foreign ]] || { echo "donation address $red$(short <<<"$foreign")$off does not match the CCS wallet"; return; }
    why=$(boxed "$1" "$2")
    [[ ! $why ]] || { echo "$why"; return; }
    [[ ! ${3:-} ]] || images "$1" "$3"
}

# boxed FILE WANT: "" if WANT is "-", or if the page FILE's donation box (a monero: link), if it
# shows one, is WANT's alone, its one image the QR code qr/WANT.png, the list's file of it; else
# what is wrong
boxed() {
    local box region imgs
    [[ $2 != - ]] || return 0
    box=$(grep -oE 'monero:[1-9A-HJ-NP-Za-km-z]{95}' "$1" | sort -u | grep -vxF "monero:${WATCH_ALLOWED// /$'\n'monero:}" || true)
    # no box at all (a proposal at its goal: the design's "Funded" in its place): no address there
    # to be wrong
    [[ $box ]] || return 0
    [[ $box == "monero:$2" ]] || { echo "the donation box isn't its proposal's address (${2:0:6}…${2: -4})"; return; }
    # the box, the design's ccs:donate part: one image, qr/WANT.png, and no style that could draw
    # another (review 12's L-2: a box with the right link and text, and another image, passed)
    region=$(< "$1")
    if [[ $region == *'<!-- ccs:donate -->'* ]]; then region=${region#*<!-- ccs:donate -->} region=${region%%<!-- /ccs:donate -->*}; else region=''; fi
    imgs=$(grep -oE '<img[^>]*>' <<<"$region" || true)
    if [[ $(grep -c . <<<"$imgs" || true) != 1 || $imgs != *"qr/$2.png\""* ]] || grep -qiE 'style|url\(|background' <<<"$region"; then
        echo "the donation box shows another image than its address's QR code (qr/${2:0:6}…${2: -4}.png)"; return
    fi
    [[ -f $list.qr/$2.png ]] || return 0
    # (the page's own link, from where it is: ../qr/<address>.png)
    fetch "$(urlof "qr/$2.png")" "$tmp/qr" || return 0
    cmp -s "$tmp/qr" "$list.qr/$2.png" || echo "the donation box's QR code isn't the signed list's of its address"
}

# missing: a path that doesn't exist, named as the site's own are (a proposal's name with -2, two of
# them run together, ...), in proposals/ or not, under a theme prefix at random: a web server that
# answers its own page only where the watcher never asks must not know where that is
missing() {
    local names=() a b name='' try
    mapfile -t names < <(cut -f1 "$tmp/proposals")
    for _ in 1 2 3 4 5 6; do
        try=$(printf '%04x%04x%04x' $RANDOM $RANDOM $RANDOM)
        if ((${#names[@]})); then
            a=${names[RANDOM % ${#names[@]}]} b=${names[RANDOM % ${#names[@]}]}
            case $((RANDOM % 4)) in
                0) try=$a-$((RANDOM % 8 + 2)) ;;
                1) try=${a%%-*}-${b#*-} ;;
                2) try=$b-${a%%-*} ;;
                3) try=${a%-*} ;;
            esac
        fi
        case $((RANDOM % 5)) in 0) try=$try.html ;; 1) try=$try/ ;; *) try=proposals/$try.html ;; esac
        grep -qxF -- "${try#proposals/}" <(sed 's/$/.html/' <(cut -f1 "$tmp/proposals")) || { name=$try; break; }
    done
    [[ $name ]] || name=proposals/$(printf '%04x%04x%04x' $RANDOM $RANDOM $RANDOM).html
    name=$(pre)$name
    rc=0; fetch "$(urlof "$name")" "$tmp/page" || rc=$?
    ((rc == 1)) && return   # nothing answered: nothing known
    local why=''
    if ((rc == 3)) && [[ $code == 404 ]]; then why=$(wrong "$tmp/page" - "$name"); [[ $why ]] || return 0; fi
    bad=$((bad + 1))
    if ! sighted "$state/differs-missing"; then
        log "$(urlof "$name") (no such page) answers HTTP $code${why:+: $why}, not a 404; alerting if it does again within a day"
    else
        alert missing "a page that doesn't exist answers HTTP $code${why:+ ($why)}, not a 404 @ $(urlof "$name")"
    fi
}

# theme PAGE: the theme button on PAGE, under a prefix at random, as a click on it: HTTP 302 to
# that page under /dark/ or /light/, or none for system (the theme lines in docs/two-machines.md)
theme() {
    local page=$1 t want from rc
    t=$(shuf -n 1 -e dark light system) from=$(pre)
    if [[ $t == system ]]; then want=$(urlof "$page"); else want=$(urlof "$t/$page"); fi
    rc=0; fetch "$(urlof "$from$page")?theme=$t" "$tmp/page" || rc=$?
    ((rc == 1)) && return
    [[ $code == 302 && ($location == "$want" || $location == "${want#"$origin"}") ]] && return
    bad=$((bad + 1))
    if ! sighted "$state/differs-theme"; then
        log "the theme button on $(urlof "$from$page") (?theme=$t) answers HTTP $code ${location:+to $location}, not $want; alerting if it does again within a day"
    else
        alert theme "the theme button sends visitors to ${location:-nowhere} (HTTP $code), not to the page @ $(urlof "$from$page")?theme=$t"
    fi
}

for c in "${checks[@]}"; do
    case $c in
        missing) missing; continue ;;
        theme$'\t'*) theme "${c#*$'\t'}"; continue ;;
    esac
    remote=${c%%$'\t'*} want=${c#*$'\t'}
    url=$(urlof "$remote")
    # seen: by the page, prefix aside (wrong under any prefix, then any other: alert), and by
    # the address, prefix and all
    p=${remote#dark/} p=${p#light/}
    seen=$state/differs-${p//[^A-Za-z0-9._-]/_} seen_at=$state/differs-at-${remote//[^A-Za-z0-9._-]/_}
    other=$state/answers-${p//[^A-Za-z0-9._-]/_}
    rc=0; fetch "$url" "$tmp/page" || rc=$?
    if ((rc)); then
        failed=$((failed + 1)); log "could not fetch $url${code:+ (HTTP $code)}"
        # the web server answered, but not with the page: counted, alerted below if it lasts
        if ((rc == 3)); then
            n=$(($(cat "$other" 2> /dev/null || echo 0) + 1)); echo "$n" > "$other"
            answered+=("$n"$'\t'"$code"$'\t'"$p"$'\t'"$url")
        fi
        continue
    fi
    rm -f "$other"
    why=$(wrong "$tmp/page" "$want" "$remote")
    [[ $why ]] || continue
    # wrong: on two more whole fetches, 10s and 30s later (a build may be landing), or a recheck
    # not answered (a web server refusing the watcher's second ask mustn't hide what the first saw)
    for wait in ${CCS_WATCH_WAITS:-10 30}; do   # (tests make them shorter)
        sleep "$wait"
        fetch "$url" "$tmp/again" || continue
        rm -f "$tmp"/img/*   # (the images fetched again too)
        why=$(wrong "$tmp/again" "$want" "$remote")
        [[ $why ]] || break
    done
    [[ $why ]] || continue
    # The second run within a day that sees it alerts, runs that see the page right in between or
    # not: no single moment, a build or a glitch, raises an alarm, and neither does showing it only
    # now and then hide it.
    bad=$((bad + 1))
    if ! sighted "$seen" "$seen_at"; then
        log "$url: $why; alerting if it does again within a day"; continue
    fi
    # n1oc's style: "<what> @ <link>"; an address shortened to its first 6 and last 4
    alert "page-$p" "$why @ $url"
done
if ((failed == fetches)); then
    n=$(($(cat "$state/unreachable" 2> /dev/null || echo 0) + 1)); echo "$n" > "$state/unreachable"
    ((n < 3)) || alert unreachable "$site_url could not be fetched ($n checks in a row)"
else
    rm -f "$state/unreachable"
    # The site answers, but a page keeps answering something else (a redirect, an error,
    # nothing): three checks in a row alert, as a web server sending visitors elsewhere would
    for a in "${answered[@]}"; do
        IFS=$'\t' read -r n c p url <<<"$a"
        [[ $c == 200 ]] && c='200 with nothing'
        ((n < 3)) || alert "page-$p" "the page answers HTTP $c, not the page ($n checks in a row) @ $url"
    done
fi
((bad == 0 && failed == 0)) && log "the $pages pages on $site_url, and the $((fetches - pages)) others: every address the wallet's, each donation box its proposal's (asked for as $browser)"
exit $((bad > 0))
