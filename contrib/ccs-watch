#!/usr/bin/env bash
# ccs-watch SITE_URL LOCAL_SITE [CONF]: the backend watching the web server. Right after a push,
# and between pushes at random times (ccs-watch.timer, docs/handover.md), fetch the pages where
# donations are asked for (home, Funding Required, Donate, Verify, every funding-required proposal)
# from SITE_URL, as a visitor's browser would, and every file they use (stylesheets with
# theme.css, fonts, icons, the General Fund's QR code, images), and compare each, byte for byte,
# with LOCAL_SITE, what was last pushed. A difference means the web server serves something the
# backend didn't make (a push skips a file whose size and time were kept: this doesn't): alert,
# the second time it is seen within a day. Also a page never pushed (it must be the 404 page) and,
# with the themes, the theme button's redirect.
# CONF (default /etc/ccs/alert.conf, root-owned, not in any repository):
#   ALERT_URL=https://bot.example/simple?channel=%23ccs   POSTed the message as plain text
#                                                         (CptHook's simple module, ntfy, ...)
#   ALERT_TARGET=#channel  ALERT_PASSWORD=...             instead, wmb's /directedMessage JSON
#                                                         (ALERT_URL=http://127.0.0.1:8081/directedMessage)
#   WATCH_PROXY=socks5h://127.0.0.1:9050                  recommended: fetch through a proxy, or
#                                                         several (space-separated), one picked at
#                                                         random for each fetch: Tor and a clearnet
#                                                         one elsewhere (ssh -D), so the web server
#                                                         can't tell the watcher by its address
#   WATCH_THEMES=1                                        also /dark/ and /light/ (the theme lines
#                                                         in docs/two-machines.md): each page under
#                                                         one of the three, at random, and both
#                                                         theme.css files
#   WATCH_SAMPLE=10                                       how many of the other pages to check
#                                                         too, at random each run (default 10)
#   WATCH_FIREFOX_ESR=140 WATCH_FIREFOX=144 WATCH_CHROME=141
#                                                         optional: the browsers' current versions
#                                                         (Tor Browser's Firefox ESR, Firefox,
#                                                         Chrome): one asked as, at random each
#                                                         run; a version no one runs is a tell
#   SUBADDRESSES=/etc/ccs-front/subaddresses.txt          optional: name addresses not on it
#   FORGE_HOURS=6                                         optional: how long GitLab or Forgejo may
#                                                         be down before --run alerts (default 6)
#   ALERT_PREFIX=[CCS-watch]                              optional: how messages start
#   ALERT_PLAIN=1                                         optional: no IRC colours (for ntfy and the like)
# One alert per problem an hour; "unreachable" after 3 runs in a row. Logs to stderr.
#
# ccs-watch --run RESULT [CONF]: ccs-bash-update tells it how the whole run went, "ok" or the
# steps that failed ("ccs-bash", "the push", ...). The page check above only runs after a good
# push, so it can't see a backend that has stopped: this does. Three failed runs in a row (about
# six minutes; one or two are a blip) alert, once an hour while it lasts; the first good run
# after that says so. A GitLab or Forgejo outage isn't a failed run (ccs-bash keeps the old data),
# but one that lasts alerts: no good pull of the proposals (/var/lib/ccs/pull-ok, which
# ccs-bash-update touches after one) or no answer from its API (ccs-bash's STATE_DIR/forge-ok) for
# FORGE_HOURS (CONF, default 6), and new merged proposals and Ideas aren't reaching the site. Once
# an hour while it lasts, and a line when both answer again.
set -euo pipefail
# ccs-watch --test SITE_URL [CONF]: send one test message, to check ALERT_URL works
test_only=''
if [[ ${1:-} == --test ]]; then
    [[ ${2:-} == http* ]] || { echo "usage: ccs-watch --test SITE_URL [CONF]" >&2; exit 2; }
    test_only=1; set -- "$2" /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
run_result=''
if [[ ${1:-} == --run ]]; then
    [[ ${2:-} ]] || { echo "usage: ccs-watch --run ok|STEPS [CONF]" >&2; exit 2; }
    run_result=$2; set -- - /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
site_url=${1:?SITE_URL} local_site=${2:?LOCAL_SITE} conf=${3:-/etc/ccs/alert.conf}
state=${CCS_WATCH_STATE:-/var/lib/ccs/state/watch}
ALERT_URL='' WATCH_PROXY='' WATCH_THEMES='' SUBADDRESSES='' ALERT_PREFIX='' ALERT_TARGET='' ALERT_PASSWORD='' ALERT_PLAIN='' FORGE_HOURS=''
WATCH_FIREFOX_ESR='' WATCH_FIREFOX='' WATCH_CHROME=''
keys='ALERT_URL|WATCH_PROXY|WATCH_THEMES|SUBADDRESSES|ALERT_PREFIX|ALERT_TARGET|ALERT_PASSWORD|ALERT_PLAIN|FORGE_HOURS|WATCH_FIREFOX_ESR|WATCH_FIREFOX|WATCH_CHROME'
if [[ -f $conf ]]; then
    # only these keys, KEY=value lines; nothing in it is run
    while IFS='=' read -r k v; do
        [[ $k =~ ^($keys)$ ]] && printf -v "$k" '%s' "$v"
    done < <(grep -E "^($keys)=" "$conf")
fi
# IRC colours as CptHook's GitLab messages have them: the [CCS-watch] tag light blue (12), a
# bad address red (04); none with ALERT_PLAIN
if [[ $ALERT_PLAIN ]]; then blue='' red='' off=''; else blue=$'\x0312' red=$'\x0304' off=$'\x03'; fi
ALERT_PREFIX=${ALERT_PREFIX:-"[${blue}CCS-watch${off}]"}
[[ $test_only ]] || mkdir -p "$state"
log() { printf '%s ccs-watch: %s\n' "$(date -u '+%F %T')" "$*" | sed 's/\x03[0-9]*//g' >&2; }   # no IRC colours in the log

# alert KEY MESSAGE: post MESSAGE (to the log always), at most once an hour for the same KEY
alert() {
    local stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    log "ALERT: $2"
    [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]] && return 0
    touch "$stamp"
    [[ $ALERT_URL ]] || return 0
    send "$ALERT_PREFIX $2" || log "could not send the alert to ALERT_URL"
}

# send MESSAGE: to ALERT_URL, as wmb's JSON when ALERT_TARGET is set (the password goes in the
# body, on stdin: never on a command line), else as plain text
send() {
    if [[ $ALERT_TARGET ]]; then
        jq -n --arg t "$ALERT_TARGET" --arg m "$1" --arg p "$ALERT_PASSWORD" '{Target: $t, IncomingMessage: {Message: $m, Password: $p}}' \
            | curl -fsS --max-time 20 --data-binary @- -H 'Content-Type: application/json' "$ALERT_URL" > /dev/null
    else
        curl -fsS --max-time 20 --data-binary "$1" -H 'Content-Type: text/plain' "$ALERT_URL" > /dev/null
    fi
}

# fetch URL FILE: only a whole answer counts: HTTP 200, not empty, within 60s (curl also fails a
# body cut short of its Content-Length). 1 if nothing answered; 3 if the web server answered
# something else (its status in $code, a redirect's target in $location): a page that keeps doing
# that is an alert (below), as a web server sending visitors elsewhere would. Never a "differs".
# Asked for as a visitor's browser asks, one of three for the whole run, at random: Tor Browser
# (its Firefox ESR), Firefox or Chrome, each with its own user agent and the headers it sends, a
# page as a page (Sec-Fetch-Dest: document...) and a stylesheet, font or image as one, compressed
# as it compresses (what this curl can undo of it), through one of the proxies at random: a web
# server serving the watcher the right pages and visitors others must first tell it apart from
# them, and a rule for all but one browser is seen too. A page is asked for as a visitor arrives
# at it, at random: typed in or from a bookmark (Sec-Fetch-Site: none), a click on the site itself
# (same-origin: from Funding Required, say) or on another (cross-site: getmonero.org's link); never
# only one way, or a web server could change the page for the others. No Referer: the site's
# Referrer-Policy (no-referrer) has a browser send none to it either.
# Its TLS handshake is still curl's, which a web server can tell from a browser's.
read -ra proxies <<<"$WATCH_PROXY"
v() { [[ $1 =~ ^[1-9][0-9]{1,3}$ ]] && echo "$1" || echo "$2"; }
esr=$(v "$WATCH_FIREFOX_ESR" 140) firefox=$(v "$WATCH_FIREFOX" 144) chrome=$(v "$WATCH_CHROME" 141)
enc=$(curl -V 2> /dev/null | awk '/^Features:/ { f = " " $0 " " } END {
    e = "gzip, deflate"; if (f ~ / brotli /) e = e ", br"; if (f ~ / zstd /) e = e ", zstd"; print e }')
origin=$(sed -E 's#^([a-z]+://[^/]+).*#\1#' <<<"$site_url")
browser=$(shuf -n 1 -e tor firefox chrome)
case $browser in
    tor) ua="Mozilla/5.0 (Windows NT 10.0; rv:$esr.0) Gecko/20100101 Firefox/$esr.0" lang='en-US,en;q=0.5' ;;
    firefox) ua="Mozilla/5.0 (X11; Linux x86_64; rv:$firefox.0) Gecko/20100101 Firefox/$firefox.0" lang='en-US,en;q=0.5' ;;
    chrome) ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/$chrome.0.0.0 Safari/537.36" lang='en-US,en;q=0.9' ;;
esac
code='' location=''
fetch() {
    local proxy='' kind=() out rc=0
    ((${#proxies[@]})) && proxy=${proxies[RANDOM % ${#proxies[@]}]}
    if [[ $browser == chrome ]]; then
        kind=(-H "sec-ch-ua: \"Google Chrome\";v=\"$chrome\", \"Not?A_Brand\";v=\"8\", \"Chromium\";v=\"$chrome\"" -H 'sec-ch-ua-mobile: ?0' -H 'sec-ch-ua-platform: "Windows"')
        case ${1%%[?#]*} in
            *.css) kind+=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind+=(-H 'Accept: */*' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind+=(-H 'Accept: image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind+=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    else
        case ${1%%[?#]*} in
            *.css) kind=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind=(-H 'Accept: application/font-woff2;q=1.0,application/font-woff;q=0.9,*/*;q=0.8' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind=(-H 'Accept: image/avif,image/webp,image/png,image/svg+xml,image/*;q=0.8,*/*;q=0.5' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    fi
    out=$(curl -sS --max-time 60 ${proxy:+--proxy "$proxy"} --compressed -A "$ua" -H "Accept-Language: $lang" \
        -H "Accept-Encoding: $enc" "${kind[@]}" -o "$2" -w '%{http_code}\t%{redirect_url}' "$1" 2> /dev/null) || rc=$?
    if ((rc)); then code=000 location=''; else code=${out%%$'\t'*} location=${out#*$'\t'}; fi
    [[ $code == 200 && -s $2 ]] && return 0
    [[ $code != 000 ]] && return 3
    return 1
}

# differs URL LOCAL: 0 if the page still differs from LOCAL on two more whole fetches, 10s and 30s
# later (a push may be landing), or a recheck isn't answered (a web server refusing the watcher's
# second ask mustn't hide what the first saw; $tmp/page keeps the last differing answer); 1 only
# if it matches again
differs() {
    local wait
    for wait in ${CCS_WATCH_WAITS:-10 30}; do   # (tests make them shorter)
        sleep "$wait"
        fetch "$1" "$tmp/again" || continue
        cmp -s "$tmp/again" "$2" && return 1
        cp "$tmp/again" "$tmp/page"
    done
    return 0
}

# sighted FILE...: 0 if any of these marks a difference seen within the last 24 hours (the second
# sighting: alert); else 1, the first, marked now. A run that sees no difference doesn't clear it:
# a web server showing its own page only on every other push is still seen twice.
sighted() {
    local f now
    now=$(date +%s)
    for f in "$@"; do
        [[ -f $f ]] && ((now - $(stat -c %Y "$f") < 86400)) && return 0
    done
    touch "$@"
    return 1
}

# forge: the proposals' forge down for FORGE_HOURS (above). A file not there yet (before the first
# good pull or answer) is nothing known, not an outage.
forge() {
    local hours=6 f path what t down=''
    [[ $FORGE_HOURS =~ ^[1-9][0-9]*$ ]] && hours=$FORGE_HOURS
    for f in "${CCS_WATCH_PULL:-/var/lib/ccs/pull-ok}|the proposals repository (git pull)" \
        "${CCS_WATCH_FORGE:-/var/lib/ccs/state/forge-ok}|its API (Ideas, merge requests)"; do
        path=${f%%|*} what=${f#*|}
        t=$(stat -c %Y "$path" 2> /dev/null) || continue
        (($(date +%s) - t >= hours * 3600)) || continue
        down+="${down:+, }$what since $(date -u -d "@$t" '+%F %H:%M UTC')"
    done
    if [[ $down ]]; then
        touch "$state/forge-down"
        alert forge "GitLab/Forgejo hasn't answered for over ${hours}h: $down. New merged proposals and Ideas aren't on the site (the last ones stay)"
    elif [[ -f $state/forge-down ]]; then
        rm -f "$state/forge-down"
        alert forge-ok "GitLab/Forgejo answers again: the proposals and Ideas are up to date"
    fi
}

if [[ $run_result ]]; then
    forge
    n=$(cat "$state/failed-runs" 2> /dev/null || echo 0)
    if [[ $run_result == ok ]]; then
        ((n < 3)) || alert backend-ok "the backend runs again, after $n failed runs"
        rm -f "$state/failed-runs" "$state/failed-since"
        exit 0
    fi
    n=$((n + 1)); echo "$n" > "$state/failed-runs"
    [[ -f $state/failed-since ]] || date -u '+%F %H:%M UTC' > "$state/failed-since"
    log "this run failed ($run_result), $n in a row"
    ((n < 3)) || alert backend "the backend has failed $n runs in a row since $(cat "$state/failed-since"): $run_result (see /var/log/ccs-bash.log)"
    exit 0
fi

if [[ $test_only ]]; then
    [[ $ALERT_URL ]] || { echo "no ALERT_URL in $conf" >&2; exit 1; }
    if ! send "$ALERT_PREFIX test, please ignore @ $1"; then echo "could not send" >&2; exit 1; fi
    echo "sent"
    exit 0
fi

# the pages: the fixed ones, and every proposal page with a donation box
pages=(index.html funding-required/index.html donate/index.html verify/index.html)
while IFS= read -r f; do pages+=("proposals/${f##*/}"); done \
    < <(grep -l 'class="contribute"' "$local_site"/proposals/*.html 2> /dev/null || true)   # the Contribute box: funding-required only

# what they use: every file of the site's own a page links to with href=, src= or srcset= (the
# pages' links are relative), but not other pages, and every file those stylesheets use with
# url() (fonts, icons: a changed font can draw one character as another); with the themes, both
# theme.css files
# local_ref DIR REF: REF, a link in the file DIR/..., as a path in the site, if it is one of its files
local_ref() {
    local ref=${2%%[?#]*} path
    [[ $ref && $ref != *:* && $ref != //* && $ref != */ && $ref != *.html ]] || return 0
    if [[ $ref == /* ]]; then path=${ref#/}; else path=$(realpath -m --relative-to="$local_site" "$local_site/$1/$ref"); fi
    [[ $path != ../* && -f $local_site/$path ]] && printf '%s\n' "$path"
    return 0
}
uses() {
    local p d ref list
    # (and the 404 page's, which any path that wasn't pushed shows: its shell logo, say)
    list=$(for p in "${pages[@]}" 404.html; do
        [[ -f $local_site/$p ]] || continue
        d=${p%/*}; [[ $d == "$p" ]] && d=.
        grep -oE '(href|src|srcset)="[^"]*"' "$local_site/$p" | sed -E 's/^[a-z]+="//; s/"$//' | tr ',' '\n' \
            | awk '{ print $1 }' | while IFS= read -r ref; do local_ref "$d" "$ref"; done
    done | sort -u)
    { printf '%s\n' "$list"
      grep '\.css$' <<<"$list" | while IFS= read -r p; do
          d=${p%/*}; [[ $d == "$p" ]] && d=.
          grep -oE 'url\([^)]*\)' "$local_site/$p" | sed -E "s/^url\\(['\"]?//; s/['\"]?\\)\$//" \
              | while IFS= read -r ref; do local_ref "$d" "$ref"; done
      done; } | grep . | sort -u
}
# each check "address<TAB>local file"; a page, and each file the pages use, under one of the theme
# prefixes at random: a visitor on /dark/ loads /dark/assets/... (the links are relative), which a
# web server could serve otherwise than /assets/...
checks=()
prefixes=('')
[[ $WATCH_THEMES ]] && prefixes+=(dark/ light/)
for p in "${pages[@]}"; do
    [[ -f $local_site/$p ]] && checks+=("${prefixes[RANDOM % ${#prefixes[@]}]}${p%index.html}"$'\t'"$p")
done
# (theme.css is another file under each: theme-dark.css and theme-light.css, checked below)
while IFS= read -r f; do
    if [[ $f == assets/theme.css ]]; then checks+=("$f"$'\t'"$f"); continue; fi
    checks+=("${prefixes[RANDOM % ${#prefixes[@]}]}$f"$'\t'"$f")
done < <(uses)
if [[ $WATCH_THEMES ]]; then
    for t in dark light; do
        [[ -f $local_site/assets/theme-$t.css ]] && checks+=("$t/assets/theme.css"$'\t'"assets/theme-$t.css")
    done
fi
# and WATCH_SAMPLE (default 10) of every other page, at random, so that each is seen within a few
# runs: a web server could add a donation box to any page; and /projects, the JSON others read
sample=${WATCH_SAMPLE:-10}
[[ $sample =~ ^[0-9]+$ ]] || sample=10
while IFS= read -r p; do
    checks+=("${prefixes[RANDOM % ${#prefixes[@]}]}${p%index.html}"$'\t'"$p")
done < <(cd "$local_site" && find . -name '*.html' -printf '%P\n' | grep -vxF -f <(printf '%s\n' "${pages[@]}") | shuf -n "$sample")
[[ -f $local_site/projects.json ]] && checks+=("projects"$'\t'"projects.json")
fetches=$(printf '%s\n' "${checks[@]}" | grep -c .)
# and, among them at random (no fixed last ask that a web server could switch after):
# - a page that was never pushed, named like the site's own: the web server must answer 404 with
#   the pushed 404 page. Its own page there (a fake proposal, a donation box) is something the
#   backend never made, which the checks above can't see (they ask only for pushed files);
# - with the themes, the theme button (?theme=dark|light|system) on a page: it must send the
#   visitor to that same page under that prefix (or none), not elsewhere.
[[ -f $local_site/404.html ]] && checks+=(unpushed)
if [[ $WATCH_THEMES ]]; then
    p=$(printf '%s\n' "${checks[@]}" | awk -F'\t' '$2 ~ /\.html$/ && $2 != "404.html" { print $2 }' | shuf -n 1)
    [[ $p ]] && checks+=("theme"$'\t'"$p")
fi
mapfile -t checks < <(printf '%s\n' "${checks[@]}" | grep . | shuf)   # in no fixed order

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
bad=0 failed=0 answered=()
urlof() { printf '%s/%s' "$site_url" "$(jq -rn --arg p "$1" '$p | split("/") | map(@uri) | join("/")')"; }

# unpushed: a path never pushed, named as the site's own are (a proposal's name with -2, two of
# them run together, ...), in proposals/ or not, under a theme prefix at random: a web server that
# answers its own page only where the watcher never asks must not know where that is
unpushed() {
    local names=() a b name='' try i
    mapfile -t names < <(cd "$local_site" && for f in proposals/*.html; do [[ -f $f ]] && basename "$f" .html; done)
    for i in 1 2 3 4 5 6; do
        try=$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')
        if ((${#names[@]})); then
            a=${names[RANDOM % ${#names[@]}]} b=${names[RANDOM % ${#names[@]}]}
            case $((RANDOM % 4)) in
                0) try=$a-$((RANDOM % 8 + 2)) ;;
                1) try=${a%%-*}-${b#*-} ;;
                2) try=$b-${a%%-*} ;;
                3) try=${a%-*} ;;
            esac
        fi
        case $((RANDOM % 5)) in 0) try=$try.html ;; 1) try=$try/ ;; *) try=proposals/$try.html ;; esac
        [[ -e $local_site/$try || -e $local_site/${try%/}.html ]] || { name=$try; break; }
    done
    [[ $name ]] || name=proposals/$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n').html
    name=${prefixes[RANDOM % ${#prefixes[@]}]}$name
    rc=0; fetch "$(urlof "$name")" "$tmp/page" || rc=$?
    if ((rc == 3)) && [[ $code == 404 ]] && cmp -s "$tmp/page" "$local_site/404.html"; then return; fi
    ((rc == 1)) && return   # nothing answered: nothing known
    bad=$((bad + 1))
    if ! sighted "$state/differs-unpushed"; then
        log "$(urlof "$name") (never pushed) answers HTTP $code, not the 404 page; alerting if it does again within a day"
    else
        alert unpushed "a page that was never pushed answers HTTP $code, not the pushed 404 page @ $(urlof "$name")"
    fi
}

# theme PAGE: the theme button on PAGE, under a prefix at random, as a click on it: HTTP 302 to
# that page under /dark/ or /light/, or none for system (the theme lines in docs/two-machines.md)
theme() {
    local page=${1%index.html} t want from rc
    t=$(shuf -n 1 -e dark light system) from=${prefixes[RANDOM % ${#prefixes[@]}]}
    if [[ $t == system ]]; then want=$(urlof "$page"); else want=$(urlof "$t/$page"); fi
    rc=0; fetch "$(urlof "$from$page")?theme=$t" "$tmp/page" || rc=$?
    ((rc == 1)) && return
    [[ $code == 302 && ($location == "$want" || $location == "${want#"$origin"}") ]] && return
    bad=$((bad + 1))
    if ! sighted "$state/differs-theme"; then
        log "the theme button on $(urlof "$from$page") (?theme=$t) answers HTTP $code ${location:+to $location}, not $want; alerting if it does again within a day"
    else
        alert theme "the theme button sends visitors to ${location:-nowhere} (HTTP $code), not to the page @ $(urlof "$from$page")?theme=$t"
    fi
}

for c in "${checks[@]}"; do
    case $c in
        unpushed) unpushed; continue ;;
        theme$'\t'*) theme "${c#*$'\t'}"; continue ;;
    esac
    remote=${c%%$'\t'*} p=${c#*$'\t'}
    url=$(urlof "$remote")
    # seen: by the pushed file (differing under any prefix, then any other: alert), and by the
    # address, prefix and all (differing only under /dark/: the next time /dark/ is the prefix
    # picked for it alerts, whatever the others showed in between)
    seen=$state/differs-${p//[^A-Za-z0-9._-]/_} seen_at=$state/differs-at-${remote//[^A-Za-z0-9._-]/_}
    other=$state/answers-${p//[^A-Za-z0-9._-]/_}
    rc=0; fetch "$url" "$tmp/page" || rc=$?
    if ((rc)); then
        failed=$((failed + 1)); log "could not fetch $url${code:+ (HTTP $code)}"
        # the web server answered, but not with the page: counted, alerted below if it lasts
        if ((rc == 3)); then
            n=$(($(cat "$other" 2> /dev/null || echo 0) + 1)); echo "$n" > "$other"
            answered+=("$n"$'\t'"$code"$'\t'"$p"$'\t'"$url")
        fi
        continue
    fi
    rm -f "$other"
    cmp -s "$tmp/page" "$local_site/$p" && continue
    differs "$url" "$local_site/$p" || continue
    # It differed on three fetches over 40s (or wasn't answered again). The second run within a
    # day that sees it alerts, runs that see the page right in between or not: no single moment,
    # push or glitch, raises an alarm, and neither does showing it only now and then hide it.
    bad=$((bad + 1))
    if ! sighted "$seen" "$seen_at"; then
        log "$url differs from what was pushed; alerting if it does again within a day"; continue
    fi
    # n1oc's style: "<what> @ <link>"; an address shortened to its first 6 and last 4
    what="the page differs from what was pushed"
    [[ $p == *.html ]] || what="the file differs from what was pushed (a page's stylesheet, font or image)"
    if [[ $p == *.html && $SUBADDRESSES && -f $SUBADDRESSES ]]; then
        # the addresses on the live page that aren't on the pushed one (the General Fund in every
        # footer is on both), and of those, the ones not on the wallet's signed list
        addrs() { grep -o 'monero:[0-9A-Za-z]\{95\}\|class="address">[0-9A-Za-z]\{95\}' "$1" | grep -o '[0-9A-Za-z]\{95\}$' | sort -u; }
        foreign=$(comm -23 <(addrs "$tmp/page") <(addrs "$local_site/$p") \
            | awk 'NR == FNR { ok[$2] = 1; next } !($0 in ok)' "$SUBADDRESSES" - | head -n 3 || true)
        [[ $foreign ]] && what="donation address $red$(sed -E 's/^(.{6}).*(.{4})$/\1…\2/' <<<"$foreign" | paste -sd ' ')$off does not match the CCS wallet"
    fi
    alert "page-$p" "$what @ $url"
done
if ((failed == fetches)); then
    n=$(($(cat "$state/unreachable" 2> /dev/null || echo 0) + 1)); echo "$n" > "$state/unreachable"
    ((n < 3)) || alert unreachable "$site_url could not be fetched ($n checks in a row)"
else
    rm -f "$state/unreachable"
    # The site answers, but a page or file keeps answering something else (a redirect, an error,
    # nothing): three checks in a row alert, as a web server sending visitors elsewhere would
    for a in "${answered[@]}"; do
        IFS=$'\t' read -r n c p url <<<"$a"
        [[ $c == 200 ]] && c='200 with nothing'
        ((n < 3)) || alert "page-$p" "the page answers HTTP $c, not what was pushed ($n checks in a row) @ $url"
    done
fi
n=0; for p in "${pages[@]}"; do [[ -f $local_site/$p ]] && n=$((n + 1)); done
((bad == 0 && failed == 0)) && log "the $n pages on $site_url, and the $((fetches - n)) other pages and files, are what was pushed (asked for as $browser)"
exit $((bad > 0))
