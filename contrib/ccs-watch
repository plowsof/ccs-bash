#!/usr/bin/env bash
# ccs-watch SITE_URL OUT [CONF]: the backend checks what the web server actually serves.
# Runs after each run, and at random times between runs (ccs-watch.timer, docs/handover.md).
# Fetches from SITE_URL, as a visitor's browser would: the pages that ask for donations (home,
# Funding Required, Donate, Verify, every Funding Required proposal) and some others at random.
# Checks on each page:
# - Every address on it is on the wallet's signed list (SUBADDRESSES) or allowed
#   (WATCH_ALLOWED: the General Fund). Addresses are found the way the gate finds them, with
#   ccs-check: entities, groups, look-alike letters; a bidi control fails the page. Without
#   ccs-check: 95 or 106 base58 characters as text or link.
# - A Funding Required proposal's donation box shows its own address (OUT/projects.json), and
#   its only image is that address's QR code from the list (SUBADDRESSES.qr/).
# - Every image is a file we know byte for byte.
# A page that fails three fetches in a row alerts the second time this happens within a day.
# Also checked: a page that doesn't exist must answer 404, and the theme button must redirect
# correctly. The web server's gate checks what the pages say. This catches a web server that
# serves visitors an address that isn't the wallet's.
# CONF (default /etc/ccs/alert.conf, root-owned, not in any repository):
#   ALERT_URL=https://bot.example/simple?channel=%23ccs   POST the message here as plain text
#                                                         (CptHook's simple module, ntfy, ...)
#   ALERT_TARGET=#channel  ALERT_PASSWORD=...             or send wmb's /directedMessage JSON
#                                                         (ALERT_URL=http://127.0.0.1:8081/directedMessage)
#   WATCH_PROXY=socks5h://127.0.0.1:9050                  recommended: fetch through a proxy.
#                                                         Several (space-separated) are picked at
#                                                         random per fetch, e.g. Tor and an ssh -D
#                                                         elsewhere, so the web server can't tell
#                                                         the watcher by its IP address
#   WATCH_THEMES=1                                        also fetch under /dark/ and /light/
#                                                         (see docs/two-machines.md), one of the
#                                                         three at random per page
#   WATCH_SAMPLE=10                                       how many other proposal pages to check,
#                                                         picked at random each run (default 10)
#   WATCH_FIREFOX_ESR=140 WATCH_FIREFOX=144 WATCH_CHROME=141
#                                                         optional: current browser versions (Tor
#                                                         Browser's Firefox ESR, Firefox, Chrome).
#                                                         Each run poses as one at random. An
#                                                         outdated version would give the watcher away
#   SUBADDRESSES=/etc/ccs-front/subaddresses.txt          the signed list (default). Its QR codes
#                                                         are in subaddresses.txt.qr/ beside it
#   WATCH_ALLOWED=888tNk...                               other addresses a page may show,
#                                                         space-separated (default: the General Fund)
#   WATCH_DESIGN_SUMS=/etc/ccs-front/design.sha256        sums of the design release's files
#                                                         (sha256sum lines, ./assets/...). Images
#                                                         under assets/ must match one
#   WATCH_PROPOSALS=/var/lib/ccs/proposals                the proposals checkout. A proposal's
#                                                         image (images/...) must match its file
#   FORGE_HOURS=6                                         optional: hours GitLab or Forgejo may be
#                                                         down before --run alerts (default 6)
#   ALERT_PREFIX=[CCS-watch]                              optional: how messages start
#   ALERT_PLAIN=1                                         optional: no IRC colours (for ntfy and the like)
# At most one alert per problem per hour. "unreachable" alerts after 3 failed runs in a row.
# Logs to stderr.
#
# ccs-watch --run RESULT [CONF]: ccs-bash-update reports how a whole run went: "ok", or the steps
# that failed ("ccs-bash", "the push", ...).
# The page check only runs after a good push, so it can't notice a backend that has stopped.
# This does: three failed runs in a row (about six minutes; one or two are a blip) alert,
# once an hour while it lasts. The first good run after that says so.
# A GitLab or Forgejo outage is not a failed run, since ccs-bash keeps the old data. But a long
# one alerts: no good pull of the proposals (/var/lib/ccs/pull-ok, touched by ccs-bash-update)
# or no answer from the API (ccs-bash's STATE_DIR/forge-ok) for FORGE_HOURS (default 6).
# Then new merged proposals and ideas aren't reaching the site. It alerts once an hour while it
# lasts, and says so when both answer again.
set -euo pipefail
# ccs-watch --test SITE_URL [CONF]: send one test message, to check ALERT_URL works
test_only=''
if [[ ${1:-} == --test ]]; then
    [[ ${2:-} == http* ]] || { echo "usage: ccs-watch --test SITE_URL [CONF]" >&2; exit 2; }
    test_only=1; set -- "$2" /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
run_result=''
if [[ ${1:-} == --run ]]; then
    [[ ${2:-} ]] || { echo "usage: ccs-watch --run ok|STEPS [CONF]" >&2; exit 2; }
    run_result=$2; set -- - /nonexistent "${3:-/etc/ccs/alert.conf}"
fi
site_url=${1:?SITE_URL} out=${2:?OUT} conf=${3:-/etc/ccs/alert.conf}
state=${CCS_WATCH_STATE:-/var/lib/ccs/state/watch}
ALERT_URL='' WATCH_PROXY='' WATCH_THEMES='' SUBADDRESSES='' ALERT_PREFIX='' ALERT_TARGET='' ALERT_PASSWORD='' ALERT_PLAIN='' FORGE_HOURS=''
WATCH_DESIGN_SUMS='' WATCH_PROPOSALS=''
WATCH_FIREFOX_ESR='' WATCH_FIREFOX='' WATCH_CHROME='' WATCH_ALLOWED='' WATCH_SAMPLE=${WATCH_SAMPLE:-}
keys='ALERT_URL|WATCH_PROXY|WATCH_THEMES|SUBADDRESSES|ALERT_PREFIX|ALERT_TARGET|ALERT_PASSWORD|ALERT_PLAIN|FORGE_HOURS|WATCH_FIREFOX_ESR|WATCH_FIREFOX|WATCH_CHROME|WATCH_ALLOWED|WATCH_SAMPLE|WATCH_DESIGN_SUMS|WATCH_PROPOSALS'
if [[ -f $conf ]]; then
    # Only these keys, as KEY=value lines. Nothing in the file is run.
    while IFS='=' read -r k v; do
        [[ $k =~ ^($keys)$ ]] && printf -v "$k" '%s' "$v"
    done < <(grep -E "^($keys)=" "$conf")
fi
# IRC colours like CptHook's GitLab messages: the [CCS-watch] tag light blue (12), a bad
# address red (04). None with ALERT_PLAIN.
if [[ $ALERT_PLAIN ]]; then blue='' red='' off=''; else blue=$'\x0312' red=$'\x0304' off=$'\x03'; fi
ALERT_PREFIX=${ALERT_PREFIX:-"[${blue}CCS-watch${off}]"}
[[ $test_only ]] || mkdir -p "$state"
log() { printf '%s ccs-watch: %s\n' "$(date -u '+%F %T')" "$*" | sed 's/\x03[0-9]*//g' >&2; }   # no IRC colours in the log

# alert KEY MESSAGE: post MESSAGE, at most once an hour per KEY. Always logs it.
alert() {
    local stamp=$state/alert-${1//[^A-Za-z0-9._-]/_}
    log "ALERT: $2"
    [[ -f $stamp && $(($(date +%s) - $(stat -c %Y "$stamp"))) -lt 3600 ]] && return 0
    touch "$stamp"
    [[ $ALERT_URL ]] || return 0
    send "$ALERT_PREFIX $2" || log "could not send the alert to ALERT_URL"
}

# cfg KEY VALUE: a line of curl config (curl -K), VALUE quoted as curl reads it. Secrets (ALERT_URL,
# a proxy's login) go to curl this way, on a pipe: on a command line, any user on the host could
# read them (ps, /proc).
cfg() { local v=${2//\\/\\\\}; v=${v//\"/\\\"}; printf '%s = "%s"\n' "$1" "$v"; }

# send MESSAGE: post to ALERT_URL. As wmb's JSON when ALERT_TARGET is set, else plain text.
# The password goes in the body, on stdin, never on a command line.
send() {
    if [[ $ALERT_TARGET ]]; then
        jq -n --arg t "$ALERT_TARGET" --arg m "$1" --arg p "$ALERT_PASSWORD" '{Target: $t, IncomingMessage: {Message: $m, Password: $p}}' \
            | curl -fsS --max-time 20 --data-binary @- -H 'Content-Type: application/json' -K <(cfg url "$ALERT_URL") > /dev/null
    else
        curl -fsS --max-time 20 --data-binary "$1" -H 'Content-Type: text/plain' -K <(cfg url "$ALERT_URL") > /dev/null
    fi
}

# fetch URL FILE: fetch URL into FILE. Only a complete answer counts: HTTP 200, not empty,
# within 60s. (curl also fails a body shorter than its Content-Length.)
# Returns 1 if nothing answered. Returns 3 if the server answered something else, with the
# status in $code and any redirect target in $location. A page that keeps doing that alerts
# below, like a server sending visitors elsewhere. It never counts as a wrong page.
#
# Requests look like a real visitor's. Each run picks one browser at random: Tor Browser (its
# Firefox ESR), Firefox or Chrome, with its user agent and headers. Pages are asked for as pages
# (Sec-Fetch-Dest: document...), stylesheets, fonts and images as those, with the browser's
# compression (as far as curl can decode it). Each fetch goes through a random proxy.
# So a server that serves the watcher good pages and visitors bad ones must first tell them
# apart. A rule that targets all but one browser gets seen too.
# Each page is reached a random way: typed in or bookmarked (Sec-Fetch-Site: none), a click on
# the site (same-origin), or a click on another site (cross-site, like getmonero.org's link).
# Never only one way, or a server could change the page for the others.
# No Referer: the site's Referrer-Policy (no-referrer) makes browsers send none either.
# The TLS handshake is still curl's, which a server can tell apart from a browser's.
read -ra proxies <<<"$WATCH_PROXY"
v() { [[ $1 =~ ^[1-9][0-9]{1,3}$ ]] && echo "$1" || echo "$2"; }
esr=$(v "$WATCH_FIREFOX_ESR" 140) firefox=$(v "$WATCH_FIREFOX" 144) chrome=$(v "$WATCH_CHROME" 141)
enc=$(curl -V 2> /dev/null | awk '/^Features:/ { f = " " $0 " " } END {
    e = "gzip, deflate"; if (f ~ / brotli /) e = e ", br"; if (f ~ / zstd /) e = e ", zstd"; print e }')
origin=$(sed -E 's#^([a-z]+://[^/]+).*#\1#' <<<"$site_url")
browser=$(shuf -n 1 -e tor firefox chrome)
case $browser in
    tor) ua="Mozilla/5.0 (Windows NT 10.0; rv:$esr.0) Gecko/20100101 Firefox/$esr.0" lang='en-US,en;q=0.5' ;;
    firefox) ua="Mozilla/5.0 (X11; Linux x86_64; rv:$firefox.0) Gecko/20100101 Firefox/$firefox.0" lang='en-US,en;q=0.5' ;;
    chrome) ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/$chrome.0.0.0 Safari/537.36" lang='en-US,en;q=0.9' ;;
esac
code='' location=''
fetch() {
    local proxy='' kind=() out rc=0
    ((${#proxies[@]})) && proxy=${proxies[RANDOM % ${#proxies[@]}]}
    if [[ $browser == chrome ]]; then
        kind=(-H "sec-ch-ua: \"Google Chrome\";v=\"$chrome\", \"Not?A_Brand\";v=\"8\", \"Chromium\";v=\"$chrome\"" -H 'sec-ch-ua-mobile: ?0' -H 'sec-ch-ua-platform: "Windows"')
        case ${1%%[?#]*} in
            *.css) kind+=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind+=(-H 'Accept: */*' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind+=(-H 'Accept: image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind+=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    else
        case ${1%%[?#]*} in
            *.css) kind=(-H 'Accept: text/css,*/*;q=0.1' -H 'Sec-Fetch-Dest: style' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.woff2) kind=(-H 'Accept: application/font-woff2;q=1.0,application/font-woff;q=0.9,*/*;q=0.8' -H "Origin: $origin" -H 'Sec-Fetch-Dest: font' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *.png | *.jpg | *.jpeg | *.gif) kind=(-H 'Accept: image/avif,image/webp,image/png,image/svg+xml,image/*;q=0.8,*/*;q=0.5' -H 'Sec-Fetch-Dest: image' -H 'Sec-Fetch-Mode: no-cors' -H 'Sec-Fetch-Site: same-origin') ;;
            *) local from=(none same-origin cross-site)
                kind=(-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' -H 'Upgrade-Insecure-Requests: 1'
                -H 'Sec-Fetch-Dest: document' -H 'Sec-Fetch-Mode: navigate' -H "Sec-Fetch-Site: ${from[RANDOM % 3]}" -H 'Sec-Fetch-User: ?1' -H 'Priority: u=0, i') ;;
        esac
    fi
    # 16 MB at most, received or decompressed. The site's largest file is a few hundred KB.
    # An endless or compressed answer would otherwise fill /tmp, which is memory.
    # A bigger answer returns 3, like a wrong status.
    out=$(curl -sS --max-time 60 --max-filesize "${WATCH_MAX_BYTES:-16777216}" -K <([[ -z $proxy ]] || cfg proxy "$proxy") --compressed -A "$ua" -H "Accept-Language: $lang" \
        -H "Accept-Encoding: $enc" "${kind[@]}" -o "$2" -w '%{http_code}\t%{redirect_url}' "$1" 2> /dev/null) || rc=$?
    if ((rc == 63)); then code='with more than 16 MB' location=''; : > "$2"; return 3; fi
    if ((rc)); then code=000 location=''; else code=${out%%$'\t'*} location=${out#*$'\t'}; fi
    [[ $code == 200 && -s $2 ]] && return 0
    [[ $code != 000 ]] && return 3
    return 1
}

# sighted FILE...: return 0 if any of these marks a problem seen in the last 24 hours (the second
# sighting, so alert). Otherwise mark it now and return 1.
# A run that sees no problem doesn't clear the mark. So a server that shows a bad page only on
# every other push is still seen twice.
sighted() {
    local f now
    now=$(date +%s)
    for f in "$@"; do
        [[ -f $f ]] && ((now - $(stat -c %Y "$f") < 86400)) && return 0
    done
    touch "$@"
    return 1
}

# forge: alert when the proposals' forge has been down for FORGE_HOURS (see above).
# A missing file (before the first good pull or answer) means nothing is known, not an outage.
forge() {
    local hours=6 f path what t down=''
    [[ $FORGE_HOURS =~ ^[1-9][0-9]*$ ]] && hours=$FORGE_HOURS
    for f in "${CCS_WATCH_PULL:-/var/lib/ccs/pull-ok}|the proposals repository (git pull)" \
        "${CCS_WATCH_FORGE:-/var/lib/ccs/state/forge-ok}|its API (Ideas, merge requests)"; do
        path=${f%%|*} what=${f#*|}
        t=$(stat -c %Y "$path" 2> /dev/null) || continue
        (($(date +%s) - t >= hours * 3600)) || continue
        down+="${down:+, }$what since $(date -u -d "@$t" '+%F %H:%M UTC')"
    done
    if [[ $down ]]; then
        touch "$state/forge-down"
        alert forge "GitLab/Forgejo hasn't answered for over ${hours}h: $down. New merged proposals and Ideas aren't on the site (the last ones stay)"
    elif [[ -f $state/forge-down ]]; then
        rm -f "$state/forge-down"
        alert forge-ok "GitLab/Forgejo answers again: the proposals and Ideas are up to date"
    fi
}

if [[ $run_result ]]; then
    forge
    n=$(cat "$state/failed-runs" 2> /dev/null || echo 0)
    if [[ $run_result == ok ]]; then
        ((n < 3)) || alert backend-ok "the backend runs again, after $n failed runs"
        rm -f "$state/failed-runs" "$state/failed-since"
        exit 0
    fi
    n=$((n + 1)); echo "$n" > "$state/failed-runs"
    [[ -f $state/failed-since ]] || date -u '+%F %H:%M UTC' > "$state/failed-since"
    log "this run failed ($run_result), $n in a row"
    ((n < 3)) || alert backend "the backend has failed $n runs in a row since $(cat "$state/failed-since"): $run_result (ccs log on the backend)"
    exit 0
fi

if [[ $test_only ]]; then
    [[ $ALERT_URL ]] || { echo "no ALERT_URL in $conf" >&2; exit 1; }
    if ! send "$ALERT_PREFIX test, please ignore @ $1"; then echo "could not send" >&2; exit 1; fi
    echo "sent"
    exit 0
fi

# What the pages are checked against: the signed list and its QR codes, the allowed addresses,
# and each proposal's own address (ccs-bash's projects.json).
list=${SUBADDRESSES:-/etc/ccs-front/subaddresses.txt}
[[ -r $list && -r $out/projects.json ]] || { log "no $list or $out/projects.json: nothing to check the pages against"; exit 1; }
WATCH_ALLOWED=${WATCH_ALLOWED:-888tNkZrPN6JsEgekjMnABU4TBzc2Dt29EPAvkRxbANsAnjyPbb3iQ1YBRk1UXcdRsiKc9dhwMVgN5S9cQUiyoogDavup3H}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/img"
# What the images are checked against, byte for byte: the design release's sums and the
# proposals checkout. If one is missing, those images go unchecked and the run logs it once.
sums=${WATCH_DESIGN_SUMS:-/etc/ccs-front/design.sha256} props=${WATCH_PROPOSALS:-/var/lib/ccs/proposals}
[[ -r $sums ]] || { log "no $sums (the design's sums): the pages' images under assets/ not checked"; sums=''; }
[[ -d $props/images ]] || props=''
{ awk 'NF >= 2 { print $2 }' "$list"; tr ' ' '\n' <<<"$WATCH_ALLOWED"; } | grep . | sort -u > "$tmp/ok"
# Each proposal page's name and its donation box address ("" unless Funding Required)
jq -r '.[] | select(.filename | type == "string") | [(.filename | sub("\\.md$"; "")), (if .state == "FUNDING-REQUIRED" then .address // "" else "" end)] | @tsv' \
    "$out/projects.json" > "$tmp/proposals" || { log "$out/projects.json can't be read"; exit 1; }

# The pages: the fixed ones, every Funding Required proposal, and WATCH_SAMPLE (10) other
# proposals at random, so each is seen within a few runs (a server could add a donation box to
# any page). Also /projects, the JSON others read. Each under a random theme prefix.
prefixes=('')
[[ $WATCH_THEMES ]] && prefixes+=(dark/ light/)
pre() { printf '%s' "${prefixes[RANDOM % ${#prefixes[@]}]}"; }
[[ $WATCH_SAMPLE =~ ^[0-9]+$ ]] || WATCH_SAMPLE=10
checks=()
for p in '' funding-required/ donate/ verify/; do checks+=("$(pre)$p"$'\t'"-"); done
while IFS=$'\t' read -r name a; do checks+=("$(pre)proposals/$name.html"$'\t'"$a"); done < <(awk -F '\t' '$2 != ""' "$tmp/proposals")
while IFS=$'\t' read -r name _; do checks+=("$(pre)proposals/$name.html"$'\t'"-"); done < <(awk -F '\t' '$2 == ""' "$tmp/proposals" | shuf -n "$WATCH_SAMPLE")
checks+=("projects"$'\t'"-")
pages=$(awk -F '\t' '$2 != ""' "$tmp/proposals" | grep -c . || true); pages=$((pages + 4))
fetches=${#checks[@]}
# Mixed in at random, so no request is always last (a server could switch after it):
# - a page that doesn't exist, named like the site's own, which must answer 404
# - with themes, the theme button (?theme=dark|light|system) on a page, which must redirect
#   to the same page under that prefix (or none), not elsewhere
checks+=(missing)
[[ $WATCH_THEMES ]] && checks+=("theme"$'\t'"$(shuf -n 1 -e '' funding-required/ donate/ verify/)")
mapfile -t checks < <(printf '%s\n' "${checks[@]}" | grep . | shuf)   # random order

bad=0 failed=0 answered=()
urlof() { printf '%s/%s' "$site_url" "$(jq -rn --arg p "$1" '$p | split("/") | map(@uri) | join("/")')"; }
short() { sed -E 's/^(.{6}).*(.{4})$/\1…\2/' | paste -sd ' '; }

# The gate's scanner: ccs-check from the ccs-bash image, another via CCS_CHECK, or none
scanner=${CCS_CHECK-$(command -v ccs-check || true)}

# norm PATH: print PATH without . and .. steps. Fails if it steps out of the site.
norm() {
    local s out=()
    IFS=/ read -ra parts <<<"$1"
    for s in "${parts[@]}"; do
        case $s in
            '' | .) ;;
            ..) ((${#out[@]})) || return 1; unset 'out[${#out[@]}-1]' ;;
            *) out+=("$s") ;;
        esac
    done
    (IFS=/; printf '%s' "${out[*]}")
}

# image_ok PATH FILE: print "" if the image PATH, fetched into FILE, matches a known file byte
# for byte. Otherwise print what is wrong. If it didn't answer, nothing is known: print "".
image_ok() {
    local p=$1 f=$2 a sum
    case $p in
        qr/*.png)
            a=${p#qr/} a=${a%.png}
            [[ $a =~ ^[1-9A-HJ-NP-Za-km-z]{95}$ && -f $list.qr/$a.png ]] || { echo "an image that isn't one of the signed list's QR codes ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            cmp -s "$f" "$list.qr/$a.png" || echo "a QR code that isn't the signed list's file of its address ($p)" ;;
        images/*)
            [[ $props ]] || return 0
            [[ -f $props/$p && ! -L $props/$p ]] || { echo "an image no proposal has ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            cmp -s "$f" "$props/$p" || echo "an image that isn't its proposal's, as the proposals repository has it ($p)" ;;
        *)
            [[ $sums ]] || return 0
            sum=$(awk -v p="./$p" '$2 == p { print $1; exit }' "$sums")
            [[ $sum ]] || { echo "an image that isn't the design's ($p)"; return; }
            fetch "$(urlof "$p")" "$f" || return 0
            [[ $(sha256sum < "$f" | cut -d' ' -f1) == "$sum" ]] || echo "an image that isn't the design's file ($p)" ;;
    esac
}

# images FILE PAGE: print "" if every image the page shows (<img> and <source> src and srcset) and every
# file its <link>s load (stylesheets, icons, fonts) is known, else what is wrong. PAGE is the
# page's path on the site.
# Known means byte for byte one of: a design file (by the release's sums), a QR code from the
# signed list, or a proposal's image from the proposals repository. A stylesheet must be the
# design's too, so none can draw another image (content: url(...)).
# Nothing reads what an image shows. A picture of another address's QR code, anywhere on a
# page, simply matches none of these files. Each image is fetched once per run.
# Tags are read across lines, with any quoting. A tag the design never has, that could show an
# image or hide one (svg, object, template, style, script...), fails the page. The design's own
# <picture> (the home page's art, in AVIF) is allowed: each of its <source>s is an image checked
# as above.
images() {
    local src p f why dir='' base flat
    [[ $2 == */* ]] && dir=${2%/*}
    flat=$(tr '\n\r\t\f' '    ' < "$1")
    if grep -qiE '<(svg|math|object|embed|video|audio|iframe|frame|frameset|image|template|style|script|canvas|applet|portal|noscript)([ />]|$)|<input [^>]*type *= *["'\'']?image' <<<"$flat"; then
        echo "a tag the design never has, which could show or hide an image (svg, object, template, style, script...)"; return
    fi
    # Honour <base href> as a browser does. The site's 404 page has <base href="&#47;">.
    base=$(grep -oiE '<base[^>]*href="[^"]*"' "$1" | head -n 1 | sed -E 's/.*href="//; s/"$//; s/&#0*47;|&#[xX]0*2[fF];/\//g' || true)
    case $base in
        "$origin"/*) dir=${base#"$origin"/} dir=${dir%/} ;;
        /*) dir=${base#/} dir=${dir%/} ;;
        '') ;;
        *) dir=${dir:+$dir/}${base%/} ;;
    esac
    while IFS= read -r src; do
        [[ $src ]] || continue
        case $src in
            "$origin"/*) p=${src#"$origin"/} ;;
            //* | *://* | data:*) echo "an image from elsewhere ($src)"; return ;;
            /*) p=${src#/} ;;
            *) p=${dir:+$dir/}$src ;;
        esac
        p=${p%%[?#]*}
        p=$(norm "$p") || { echo "an image out of the site ($src)"; return; }
        p=${p#dark/} p=${p#light/}
        f=$tmp/img/${p//\//_}
        [[ ! -e $f.ok ]] || continue
        [[ ! -e $f.bad ]] || { cat "$f.bad"; return; }
        why=$(image_ok "$p" "$f")
        if [[ $why ]]; then printf '%s\n' "$why" > "$f.bad"; printf '%s\n' "$why"; return; fi
        [[ ! -s $f ]] || : > "$f.ok"
    done < <({ grep -oiE '<(img|source)[ /][^>]*>' <<<"$flat" | grep -oiE '[ /](src|srcset) *= *("[^"]*"|'\''[^'\'']*'\''|[^ >"'\'']+)' || true
               grep -oiE '<link[ /][^>]*>' <<<"$flat" | grep -iE '[ /]rel *= *["'\'']?[^>]*(stylesheet|icon|preload|manifest)' \
                   | grep -oiE '[ /]href *= *("[^"]*"|'\''[^'\'']*'\''|[^ >"'\'']+)' || true
             } | sed -E 's/^[ /]*[A-Za-z]+ *= *//; s/^["'\'']//; s/["'\'']$//' | tr ',' '\n' | awk '{ print $1 }')
}

# wrong FILE WANT [PAGE]: print "" if the page FILE is right, else what is wrong.
# Right means: every address on it (text or link, found as the gate finds them) is on the list
# or allowed; every image is known byte for byte (see images; PAGE is its path on the site);
# and unless WANT is "-", the donation box is right (see boxed).
wrong() {
    local found foreign box region imgs lines why first='' mode=scan
    if [[ $scanner ]]; then
        IFS= read -r -n 1 first < "$1" || true
        case $first in '['|'{') mode=json ;; esac
        lines=$("$scanner" "$mode" "$1" 2> /dev/null) || { echo "the gate's scan (ccs-check) could not read the page"; return; }
        lines=$(cut -f2- <<<"$lines")
        found=$(grep -v '^[!?]' <<<"$lines" | sort -u || true)
        # Not a page: the gate's rule for what goes live, not an address problem.
        why=$(grep '^[!?]' <<<"$lines" | grep -v '^!not text that starts as a page' | head -n 1 || true)
        [[ $why != \?qr* ]] || why="!a data: image (a QR code that isn't the list's file)"
        [[ ! $why ]] || { echo "the page fails the gate's scan: ${why#!}"; return; }
    else
        found=$(grep -oE '(^|[^1-9A-HJ-NP-Za-km-z])([1-9A-HJ-NP-Za-km-z]{106}|[1-9A-HJ-NP-Za-km-z]{95})([^1-9A-HJ-NP-Za-km-z]|$)' "$1" \
            | grep -oE '[1-9A-HJ-NP-Za-km-z]{95,106}' | sort -u || true)
    fi
    foreign=$(comm -23 <(printf '%s\n' "$found" | grep .) "$tmp/ok" | head -n 3 || true)
    [[ ! $foreign ]] || { echo "donation address $red$(short <<<"$foreign")$off does not match the CCS wallet"; return; }
    why=$(boxed "$1" "$2")
    [[ ! $why ]] || { echo "$why"; return; }
    [[ ! ${3:-} ]] || images "$1" "$3"
}

# boxed FILE WANT: print "" if WANT is "-" or the page's donation box is right, else what is wrong.
# Right means: the box (a monero: link), if there is one, shows only WANT, and its only image
# is the QR code qr/WANT.png from the list.
boxed() {
    local box region imgs
    [[ $2 != - ]] || return 0
    box=$(grep -oE 'monero:[1-9A-HJ-NP-Za-km-z]{95}' "$1" | sort -u | grep -vxF "monero:${WATCH_ALLOWED// /$'\n'monero:}" || true)
    # No box at all (a funded proposal shows "Funded" instead): no address to be wrong.
    [[ $box ]] || return 0
    [[ $box == "monero:$2" ]] || { echo "the donation box isn't its proposal's address (${2:0:6}…${2: -4})"; return; }
    # The box is the design's ccs:donate part, once on the page. It must have one image,
    # qr/WANT.png, and no style that could draw another. No other list QR code may be anywhere on
    # the page: a decoy box elsewhere (hidden, in a <template>) can't hold the right one while the
    # one shown has another proposal's. (A box with the right link and text but another image
    # used to pass.) Tags are read across lines.
    region=$(tr '\n\r\t\f' '    ' < "$1")
    if [[ $(grep -o '<!-- ccs:donate -->' <<<"$region" | grep -c . || true) != 1 || $(grep -o '<!-- /ccs:donate -->' <<<"$region" | grep -c . || true) != 1 ]]; then
        echo "the page hasn't one donation box (the design's ccs:donate part, once)"; return
    fi
    if grep -oE 'qr/[1-9A-HJ-NP-Za-km-z]{95}\.png' <<<"$region" | grep -qvxF "qr/$2.png"; then
        echo "the page shows another list QR code than its address's (qr/${2:0:6}…${2: -4}.png)"; return
    fi
    region=${region#*<!-- ccs:donate -->} region=${region%%<!-- /ccs:donate -->*}
    imgs=$(grep -oiE '<img[ /][^>]*>' <<<"$region" || true)
    if [[ $(grep -c . <<<"$imgs" || true) != 1 || $imgs != *"qr/$2.png"* ]] || grep -qiE 'style|url\(|background|hidden|<picture|<source' <<<"$region"; then
        echo "the donation box shows another image than its address's QR code (qr/${2:0:6}…${2: -4}.png)"; return
    fi
    [[ -f $list.qr/$2.png ]] || return 0
    # The link as written on the page, relative to it: ../qr/<address>.png
    fetch "$(urlof "qr/$2.png")" "$tmp/qr" || return 0
    cmp -s "$tmp/qr" "$list.qr/$2.png" || echo "the donation box's QR code isn't the signed list's of its address"
}

# missing: fetch a path that doesn't exist, named like the site's own (a proposal's name with -2,
# two names joined, ...), in proposals/ or not, under a random theme prefix. It must answer 404.
# A server that serves its own page only where the watcher never asks must not know where that is.
missing() {
    local names=() a b name='' try
    mapfile -t names < <(cut -f1 "$tmp/proposals")
    for _ in 1 2 3 4 5 6; do
        try=$(printf '%04x%04x%04x' $RANDOM $RANDOM $RANDOM)
        if ((${#names[@]})); then
            a=${names[RANDOM % ${#names[@]}]} b=${names[RANDOM % ${#names[@]}]}
            case $((RANDOM % 4)) in
                0) try=$a-$((RANDOM % 8 + 2)) ;;
                1) try=${a%%-*}-${b#*-} ;;
                2) try=$b-${a%%-*} ;;
                3) try=${a%-*} ;;
            esac
        fi
        case $((RANDOM % 5)) in 0) try=$try.html ;; 1) try=$try/ ;; *) try=proposals/$try.html ;; esac
        grep -qxF -- "${try#proposals/}" <(sed 's/$/.html/' <(cut -f1 "$tmp/proposals")) || { name=$try; break; }
    done
    [[ $name ]] || name=proposals/$(printf '%04x%04x%04x' $RANDOM $RANDOM $RANDOM).html
    name=$(pre)$name
    rc=0; fetch "$(urlof "$name")" "$tmp/page" || rc=$?
    ((rc == 1)) && return   # no answer: nothing known
    local why=''
    if ((rc == 3)) && [[ $code == 404 ]]; then why=$(wrong "$tmp/page" - "$name"); [[ $why ]] || return 0; fi
    bad=$((bad + 1))
    if ! sighted "$state/differs-missing"; then
        log "$(urlof "$name") (no such page) answers HTTP $code${why:+: $why}, not a 404; alerting if it does again within a day"
    else
        alert missing "a page that doesn't exist answers HTTP $code${why:+ ($why)}, not a 404 @ $(urlof "$name")"
    fi
}

# theme PAGE: click the theme button on PAGE, under a random prefix. It must answer HTTP 302 to
# the same page under /dark/ or /light/, or no prefix for system (see docs/two-machines.md).
theme() {
    local page=$1 t want from rc
    t=$(shuf -n 1 -e dark light system) from=$(pre)
    if [[ $t == system ]]; then want=$(urlof "$page"); else want=$(urlof "$t/$page"); fi
    rc=0; fetch "$(urlof "$from$page")?theme=$t" "$tmp/page" || rc=$?
    ((rc == 1)) && return
    [[ $code == 302 && ($location == "$want" || $location == "${want#"$origin"}") ]] && return
    bad=$((bad + 1))
    if ! sighted "$state/differs-theme"; then
        log "the theme button on $(urlof "$from$page") (?theme=$t) answers HTTP $code ${location:+to $location}, not $want; alerting if it does again within a day"
    else
        alert theme "the theme button sends visitors to ${location:-nowhere} (HTTP $code), not to the page @ $(urlof "$from$page")?theme=$t"
    fi
}

for c in "${checks[@]}"; do
    case $c in
        missing) missing; continue ;;
        theme$'\t'*) theme "${c#*$'\t'}"; continue ;;
    esac
    remote=${c%%$'\t'*} want=${c#*$'\t'}
    url=$(urlof "$remote")
    # Marks of a problem seen: one per page ignoring the prefix (wrong under one prefix, then
    # another, still alerts), and one per exact address.
    p=${remote#dark/} p=${p#light/}
    seen=$state/differs-${p//[^A-Za-z0-9._-]/_} seen_at=$state/differs-at-${remote//[^A-Za-z0-9._-]/_}
    other=$state/answers-${p//[^A-Za-z0-9._-]/_}
    rc=0; fetch "$url" "$tmp/page" || rc=$?
    if ((rc)); then
        failed=$((failed + 1)); log "could not fetch $url${code:+ (HTTP $code)}"
        # The server answered, but not with the page. Count it; alert below if it lasts.
        if ((rc == 3)); then
            n=$(($(cat "$other" 2> /dev/null || echo 0) + 1)); echo "$n" > "$other"
            answered+=("$n"$'\t'"$code"$'\t'"$p"$'\t'"$url")
        fi
        continue
    fi
    rm -f "$other"
    why=$(wrong "$tmp/page" "$want" "$remote")
    [[ $why ]] || continue
    # Wrong: fetch twice more, 10s and 30s later, since a build may be landing.
    # A recheck that gets no answer keeps the first result: refusing the second fetch must not
    # hide what the first saw.
    for wait in ${CCS_WATCH_WAITS:-10 30}; do   # tests make them shorter
        sleep "$wait"
        fetch "$url" "$tmp/again" || continue
        rm -f "$tmp"/img/*   # fetch the images again too
        why=$(wrong "$tmp/again" "$want" "$remote")
        [[ $why ]] || break
    done
    [[ $why ]] || continue
    # Alert on the second run within a day that sees it, whatever runs saw in between.
    # A single moment (a build, a glitch) raises no alarm, and showing it only now and then
    # doesn't hide it.
    bad=$((bad + 1))
    if ! sighted "$seen" "$seen_at"; then
        log "$url: $why; alerting if it does again within a day"; continue
    fi
    # n1oc's style: "<what> @ <link>", addresses shortened to their first 6 and last 4
    alert "page-$p" "$why @ $url"
done
if ((failed == fetches)); then
    n=$(($(cat "$state/unreachable" 2> /dev/null || echo 0) + 1)); echo "$n" > "$state/unreachable"
    ((n < 3)) || alert unreachable "$site_url could not be fetched ($n checks in a row)"
else
    rm -f "$state/unreachable"
    # The site answers, but a page keeps answering something else (a redirect, an error,
    # nothing). Three checks in a row alert, as for a server sending visitors elsewhere.
    for a in "${answered[@]}"; do
        IFS=$'\t' read -r n c p url <<<"$a"
        [[ $c == 200 ]] && c='200 with nothing'
        ((n < 3)) || alert "page-$p" "the page answers HTTP $c, not the page ($n checks in a row) @ $url"
    done
fi
((bad == 0 && failed == 0)) && log "the $pages pages on $site_url, and the $((fetches - pages)) others: every address the wallet's, each donation box its proposal's (asked for as $browser)"
exit $((bad > 0))
