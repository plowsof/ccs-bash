#!/usr/bin/env bash
# step STAGE [ARG...]: run one stage of the backend's update loop, in its own container of the
# backend compose (contrib/docker/backend/compose.yml). Together the stages do what
# ccs-bash-update does in one host script (docs/handover.md, step 9), but each stage has only
# its own user, network and folders. Each run has a number N, and the stages take it in turn:
#
#   pull      git pull of the proposals (user ccs-git; network: the forge only). Starts run N+1
#             every CCS_EVERY seconds (120), or at once when a line is written to its "now" pipe
#             (the wallet's tx-notify, ccs proposal:process). Never before the last push is done.
#   ccs-bash  runs ccs-back.sh (user ccs; network: the wallet and the forge's API) once pull did N
#   backup    sends the state to the backup machine (user ccs; that machine only) once ccs-bash did N
#   push      sends site-data.json to the web server (user ccs; that machine only), which builds
#             the site from it, once backup did N. Then writes the run's result ("ok", or the
#             failed steps, as ccs-bash-update names them) to its "watch" pipe.
#   watch     runs ccs-watch (user ccs; network: the web server). After each run it checks the
#             live pages and the run's result (three failed runs alert). Between pushes it checks
#             the pages again at random times. ARG: the site's address.
#   init      as root, once: create the run folder and a folder per stage, owned by its user
#   health    STAGE: the compose's healthcheck. 0 if STAGE finished something recently.
#
# The run folder (CCS_RUN, /run/ccs) has a folder per stage with: "done" (the last N finished),
# "status" ("N ok" or "N failed[: why]"), "at" (when), and "wake" (a pipe; a waiting stage reads
# a line when another finishes).
# The pipes only make things faster. A waiting stage checks the others' "done" every 5 s anyway,
# so a missed line costs a few seconds, never a run.
# No stage starts or controls another (there is no Docker socket); each only waits for "done".
# Output goes to stdout: Docker's log, sent to journald by compose.yml (journalctl -t ccs;
# ccs log and ccs status read it).
set -uo pipefail
R=${CCS_RUN:-/run/ccs}
# The push and backup ports must be numbers: they go into an ssh command line.
for p in "${CCS_PUSH_PORT:-22}" "${CCS_BACKUP_PORT:-22}"; do [[ $p =~ ^[1-9][0-9]{0,4}$ ]] || { echo "step: a port that isn't one: $p" >&2; exit 2; }; done
EVERY=${CCS_EVERY:-120}
# Minimum time between two runs' starts (CCS_MIN_GAP, 30 s, never more than EVERY)
GAP=${CCS_MIN_GAP:-30}
((GAP <= EVERY)) || GAP=$EVERY
STAGES="pull ccs-bash backup push"
stage=${1:?STAGE: init $STAGES}
shift

say() { printf '%s\n' "$*"; }
# run CMD...: run CMD with output and errors to stdout (one log, in order). Returns its status.
run() { "$@" 2>&1; }
now() { printf '%(%s)T\n' -1; }   # bash's own: busybox's date has no %s here
num() { local v; v=$(cat "$1" 2> /dev/null) || v=0; [[ $v =~ ^[0-9]+$ ]] || v=0; printf '%s\n' "$v"; }
# put FILE TEXT: write FILE atomically, so a stage reading it never sees half of it
put() { printf '%s\n' "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"; }
# wake STAGE...: write a line to each stage's pipe, opened read-write so it never blocks
wake() { local s; for s; do [[ -p $R/$s/wake ]] && { printf 'go\n' 1<> "$R/$s/wake"; } 2> /dev/null; done; return 0; }
# wait_for STAGE N: wait until STAGE has done N
wait_for() { while (($(num "$R/$1/done") < $2)); do read -r -t 5 _ <> "$R/$stage/wake" || true; done; }
# finish N STATUS: mark run N done by this stage
finish() { put "$R/$stage/status" "$1 $2"; put "$R/$stage/at" "$(now)"; put "$R/$stage/done" "$1"; }
# failed STAGE N: print why STAGE failed run N ("" if it didn't)
failed() { local s; s=$(cat "$R/$1/status" 2> /dev/null) || s=''; [[ $s == "$2 failed"* ]] && printf '%s\n' "${s#"$2 failed"}" | sed 's/^: //'; return 0; }

case $stage in
init)
    # CCS_UIDS: "stage=uid:gid ...". The compose file passes the host's users.
    mkdir -p "$R" && chmod 755 "$R" || exit 1
    for pair in ${CCS_UIDS:?CCS_UIDS: stage=uid:gid ...}; do
        s=${pair%%=*} owner=${pair#*=}
        [[ " $STAGES watch " == *" $s "* && $owner =~ ^[0-9]+:[0-9]+$ ]] || { echo "init: bad CCS_UIDS entry $pair" >&2; exit 1; }
        mkdir -p "$R/$s" || exit 1
        # Pipes: "wake" for every stage, the pull's "now" (written by the wallet's tx-notify and
        # ccs proposal:process), and the push's "watch" (read by the watch stage).
        for p in wake $([[ $s == pull ]] && echo now) $([[ $s == push ]] && echo watch); do
            if [[ ! -p $R/$s/$p ]]; then rm -f "$R/$s/$p" && mkfifo -m 622 "$R/$s/$p" || exit 1; fi
        done
        chown -R "$owner" "$R/$s" && chmod 755 "$R/$s" || exit 1
    done
    # Two pipes carry meaning, so only their one writer may use them:
    # - "now" (a line starts a run): the wallet's tx-notify (CCS_NOW_GID, the wallet's group or
    #   uid:gid), and root for ccs proposal:process.
    # - "watch" (each run's result): read only by the watch stage (CCS_WATCH_GID, likewise).
    # A "wake" line only makes a stage check the others' "done" again, so any stage may write it.
    if [[ -p $R/pull/now ]]; then g=${CCS_NOW_GID:?CCS_NOW_GID, the gid of the wallet}; chown ":${g#*:}" "$R/pull/now" && chmod 660 "$R/pull/now" || exit 1; fi
    if [[ -p $R/push/watch ]]; then g=${CCS_WATCH_GID:?CCS_WATCH_GID, the gid of the watch}; chown ":${g#*:}" "$R/push/watch" && chmod 660 "$R/push/watch" || exit 1; fi
    echo "init: $R ready"
    ;;
pull)
    # Keep "now" open the whole time. A line written during a run (tx-notify can come at any
    # moment) then waits in the pipe for the next run, instead of being lost.
    exec 4<> "$R/pull/now" || exit 1
    # drain: empty "now" and remember that lines came (woke). A rescanning wallet notifies for
    # every transaction it ever had: tens of thousands of lines during one run, more than the
    # pipe holds (64 KB), which would block the wallet's ccs-notify. So the pipe is also read
    # while a run finishes, not only between runs. All those lines still make one run.
    woke=''
    drain() { local i; for ((i = 0; i < 100000; i++)); do read -r -t 0.1 _ <&4 || return 0; woke=1; done; }
    while :; do
        n=$(($(num "$R/pull/done") + 1))
        while (($(num "$R/push/done") < n - 1)); do read -r -t 5 _ <> "$R/pull/wake" || true; drain; done
        # Start EVERY seconds after the last run started, or GAP if that run left a donation
        # pending (so its confirmation shows sooner), or at once when woken through "now".
        # Never sooner than GAP after the last start, so a stream of transactions can't make
        # runs follow each other faster than that.
        last=$(num "$R/pull/started") every=$EVERY
        [[ $(cat "$R/ccs-bash/pending" 2> /dev/null) == 1 ]] && every=$GAP
        until [[ $woke ]] || (($(now) >= last + every)); do
            read -r -t $((last + every - $(now))) _ <&4 && break
        done
        while (($(now) < last + GAP)); do sleep $((last + GAP - $(now))); done
        # Lines that came with it, or while it waited: one run for all of them
        drain; woke=''
        put "$R/pull/started" "$(now)"
        say "== run $(date -u '+%F %T')"
        # Pull the proposals. If the forge is down, skip it: not a failed run, the last checkout
        # stays. Touch pull-ok on success (ccs-watch --run alerts if that's FORGE_HOURS old).
        if run timeout -k 5 40 git -C "${CCS_PROPOSALS:-/var/lib/ccs/proposals}" pull -q --ff-only; then
            touch "${CCS_PULL_OK:-/var/lib/ccs/pull-ok}" 2> /dev/null || true
            finish "$n" ok
        else
            finish "$n" "failed: the pull"
        fi
        wake ccs-bash
    done
    ;;
ccs-bash)
    while :; do
        n=$(($(num "$R/ccs-bash/done") + 1))
        wait_for pull "$n"
        if run "${CCS_BACK:-/opt/ccs-bash/ccs-back.sh}" "${CCS_CONFIG:-/etc/ccs/ccs.conf}"; then finish "$n" ok; else finish "$n" "failed: ccs-bash"; fi
        # A donation is pending (in the pool, or short of MIN_CONFIRMATIONS): start the next
        # run sooner (GAP, not EVERY).
        if jq -e '[.. | objects | ."amount-pending"? // 0] | any(. > 0)' "${CCS_OUT:-/var/lib/ccs/out}/proposals.json" > /dev/null 2>&1; then
            put "$R/ccs-bash/pending" 1
        else put "$R/ccs-bash/pending" 0; fi
        wake backup
    done
    ;;
backup)
    # CCS_BACKUP: user@host of the backup machine. CCS_BACKUP_PORT defaults to 22 (2224 for
    # the web server compose's). Its key and known_hosts are in CCS_BACKUP_KEYS.
    keys=${CCS_BACKUP_KEYS:-/etc/ccs/backup}
    while :; do
        n=$(($(num "$R/backup/done") + 1))
        wait_for ccs-bash "$n"
        why=''
        # Send proposals.csv, deposits.csv and each retired wallet's file when changed since
        # last sent. For deposits.csv only the deposits count, not the first line, whose
        # height changes every run.
        for f in "${STATE_DIR:-/var/lib/ccs/state}"/proposals.csv "${STATE_DIR:-/var/lib/ccs/state}"/deposits.csv "${STATE_DIR:-/var/lib/ccs/state}"/retired/*.csv; do
            [[ -f $f ]] || continue
            name=${f##*/}; [[ $f == */retired/* ]] && name=retired-$name
            sum=$(sed '/^# final /d' "$f" | sha256sum | cut -c1-64)
            [[ $sum == "$(cat "$R/backup/sent-$name" 2> /dev/null)" ]] && continue
            if run timeout -k 5 30 ssh -T -p "${CCS_BACKUP_PORT:-22}" -i "$keys/id_ed25519" -o UserKnownHostsFile="$keys/known_hosts" -o BatchMode=yes \
                -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o ConnectTimeout=15 "${CCS_BACKUP:?}" < "$f"; then
                put "$R/backup/sent-$name" "$sum"
            else
                why="${why:+$why, }the backup (${f##*/})"
            fi
        done
        if [[ $why ]]; then finish "$n" "failed: $why"; else finish "$n" ok; fi
        wake push
    done
    ;;
push)
    # CCS_PUSH: user@host of the web server's push account. CCS_PUSH_PORT defaults to 22
    # (2223 for the web server compose's gate). Its key and known_hosts are in CCS_PUSH_KEYS.
    data=${CCS_OUT:-/var/lib/ccs/out}/site-data.json pkeys=${CCS_PUSH_KEYS:-/etc/ccs/push}
    while :; do
        n=$(($(num "$R/push/done") + 1))
        wait_for backup "$n"
        # Send site-data.json when changed (contrib/ccs-push). The web server builds the site from it.
        rc=0
        run timeout -k 5 600 "${CCS_PUSH_SCRIPT:-/opt/ccs-bash/contrib/ccs-push}" "$data" "$R/push" \
            -T -p "${CCS_PUSH_PORT:-22}" -i "$pkeys/id_ed25519" -o UserKnownHostsFile="$pkeys/known_hosts" -o IdentitiesOnly=yes -o BatchMode=yes \
            -o StrictHostKeyChecking=yes -o ConnectTimeout=15 "${CCS_PUSH:?}" || rc=$?
        # The run's result, worded as ccs-bash-update does. A failed pull is not a failed run.
        result=''
        for s in ccs-bash backup; do w=$(failed "$s" "$n"); [[ $w ]] && result="${result:+$result, }$w"; done
        ((rc == 0)) || result="${result:+$result, }the push"
        if ((rc == 0)); then finish "$n" "pushed${result:+ failed: $result}"; else finish "$n" "failed: $result"; fi
        { printf '%s %s %s\n' "$n" "$( ((rc == 0)) && echo pushed || echo not-pushed)" "${result:-ok}" 1<> "$R/push/watch"; } 2> /dev/null
        wake pull
    done
    ;;
watch)
    # CCS_WATCH: ccs-watch. Between pushes it runs every CCS_WATCH_EVERY seconds (300) plus up
    # to 8 minutes at random (like ccs-watch.timer).
    # No run result for CCS_WATCH_STALL seconds (300, over two runs) counts as a failed run,
    # and again for each such period after. So a stopped or stuck stage alerts like a failing
    # one (after three).
    site=${1:?watch SITE_URL} w=${CCS_WATCH:-/opt/ccs-bash/contrib/ccs-watch}
    # check: the live pages' addresses against the signed list and ccs-bash's projects.json
    check() { run "$w" "$site" "${CCS_OUT:-/var/lib/ccs/out}"; return 0; }
    next=$(($(now) + ${CCS_WATCH_EVERY:-300} + RANDOM % ${CCS_WATCH_RANDOM:-480}))
    stall=${CCS_WATCH_STALL:-300} last=$(now)
    exec 3<> "$R/push/watch" || exit 1
    while :; do
        wake_at=$((next < last + stall ? next : last + stall))
        if IFS=' ' read -r -t $((wake_at > $(now) ? wake_at - $(now) : 1)) n pushed_or_not result <&3; then
            [[ $n =~ ^[0-9]+$ ]] || continue
            last=$(now)
            [[ $pushed_or_not == pushed ]] && check
            run "$w" --run "${result:-ok}"
            finish "$n" ok
            continue
        fi
        if (($(now) >= last + stall)); then
            run "$w" --run "no run finished for $((($(now) - last) / 60)) min (a stage stopped or stuck: ccs status)"
            last=$(now)
            put "$R/watch/at" "$(now)"
        fi
        if (($(now) >= next)); then
            check
            put "$R/watch/at" "$(now)"
            next=$(($(now) + ${CCS_WATCH_EVERY:-300} + RANDOM % ${CCS_WATCH_RANDOM:-480}))
        fi
    done
    ;;
health)
    # Healthy if STAGE finished a run (or the watch a check) within CCS_HEALTH seconds (5 runs,
    # at least 10 minutes), so the loop isn't stuck. A failed run still counts as finished:
    # ccs-watch alerts on those.
    s=${1:?health STAGE} limit=${CCS_HEALTH:-$((EVERY * 5 > 600 ? EVERY * 5 : 600))}
    at=$(num "$R/$s/at")
    (($(now) - at < limit)) || { echo "$s: nothing finished for $(($(now) - at)) s"; exit 1; }
    ;;
*) echo "step: no stage $stage ($STAGES, watch, init, health)" >&2; exit 2 ;;
esac
