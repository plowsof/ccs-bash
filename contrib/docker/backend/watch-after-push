#!/usr/bin/env bash
# watch-after-push [SITE_URL]: on the host, as ccs, while ccs-watch isn't in the compose: after
# each run, what ccs-bash-update did at its end. The push stage writes "N pushed|not-pushed
# RESULT" to its "watch" pipe; when pushed, the live pages are compared with what was (under
# ccs-watch's lock, as its timer does); then ccs-watch --run RESULT (three failed runs alert).
# Its unit: docs/docker.md.
set -uo pipefail
site=${1:-https://ccs.monerodevs.org}
R=${CCS_RUN_DIR:-/var/lib/ccs/run} L=${CCS_LOG:-/var/log/ccs-bash.log} W=${CCS_WATCH:-/opt/ccs-bash/contrib/ccs-watch}
exec 3<> "$R/push/watch" || exit 1
while IFS=' ' read -r n pushed result <&3; do
    [[ $n =~ ^[0-9]+$ ]] || continue
    if [[ $pushed == pushed ]]; then
        flock -s -w 600 /run/ccs-watch.lock "$W" "$site" "${CCS_PUSHED:-/var/lib/ccs/pushed}" >> "$L" 2>&1
    fi
    "$W" --run "${result:-ok}" >> "$L" 2>&1
done
