# .env for compose.yml (docs/docker.md). Copy it beside compose.yml as .env, owned by root, 600.
# The images, by ID. ccs-bash's must match its release and ccs-sigs (contrib/release/verify,
# then container/build.sh or docker load: same ID). The wallet's is the one built here.
CCS_BASH_IMAGE=sha256:<ccs-bash's attested image ID>
WALLET_IMAGE=sha256:<docker build -q wallet-rpc>
# The host's users (uid:gid), created by docs/setup.md and docs/docker.md: id -u ccs, id -g ccs, ...
CCS_UID=<ccs>
GIT_UID=<ccs-git>
WALLET_UID=<ccs-wallet>
PUSH_UID=<ccs-push>
SEND_UID=<ccs-send>
WATCH_UID=<ccs-watch>
# The wallet's RPC port, the same as wallet-rpc.conf's rpc-bind-port (for its healthcheck; default 18082)
#WALLET_PORT=18082
# Retiring a wallet (docs/handover.md): the old wallet's view-only copy, for retire-wallet --again
#RETIRED_WALLET_CONF=/etc/ccs-wallet/retired-wallet-rpc.conf
#RETIRED_WALLET_DIR=/var/lib/ccs/retired-wallet
#RETIRED_WALLET_PORT=18083
# Where the push and the backups go, and the site ccs-watch checks (the same as the
# web server's alert.conf SITE_URL)
CCS_PUSH=ccs-data@<the web server>
CCS_BACKUP=ccs-backup@<the backup machine>
CCS_SITE_URL=https://<the site>
# A monerod, proxy or bot on this machine should listen where containers reach it, as
# host.docker.internal (docs/handover.md, 1). If one must stay on 127.0.0.1, add
# compose.host.yml: it puts the wallet, ccs-bash and the watch on the host's network (docs/docker.md).
#COMPOSE_FILE=compose.yml:compose.host.yml
# optional
#CCS_EVERY=120
#CCS_PUSH_PORT=22                      # 2223 and 2224: a web server running its compose (contrib/docker/web)
#CCS_BACKUP_PORT=22
#CCS_BACKUP_KEYS=/etc/ccs/backup       # id_ed25519 and known_hosts, ccs-send's, 600
#CCS_ALERT_CONF=/etc/ccs/alert.conf    # ccs-watch's: root:ccs-watch 640
#CCS_UNATTESTED=1                     # testnet only, never mainnet: deploys its own unsigned releases, each rebuilt and checked against its release notes; ccs config:check then warns instead of failing on an unattested image
