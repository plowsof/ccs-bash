# .env for compose.yml (docs/docker.md): copy it beside compose.yml as .env, root's, 600.
# The images, by ID: ccs-bash's and ccs-front-bash's as their releases and ccs-sigs attest them
# (contrib/release/verify, then container/build.sh, or docker load: the same ID), the wallet's
# as built here.
CCS_BASH_IMAGE=sha256:<ccs-bash's attested image ID>
CCS_FRONT_IMAGE=sha256:<ccs-front-bash's attested image ID>
WALLET_IMAGE=sha256:<docker build -q wallet-rpc>
# the host's users (uid:gid), as docs/setup.md makes them: id -u ccs, id -g ccs, ...
CCS_UID=<ccs>
GIT_UID=<ccs-git>
FRONT_UID=<ccs-front>
WALLET_UID=<ccs-wallet>
# the wallet's RPC port, as wallet-rpc.conf's rpc-bind-port (its healthcheck; default 18182)
WALLET_PORT=<18082>
# where the push and the backups go; the site ccs-watch checks
CCS_PUSH=ccs-data@<the web server>
CCS_BACKUP=ccs-backup@<the backup machine>
CCS_SITE_URL=https://<the site>
# a host whose monerod (and alert.conf's proxy and bot) listen on its 127.0.0.1 only: the
# wallet, ccs-bash and the watch on its network (compose.host.yml)
#COMPOSE_FILE=compose.yml:compose.host.yml
# optional
#CCS_EVERY=120
#CCS_PUSH_PORT=22                      # 2223 and 2224: a web server running its compose (contrib/docker/web)
#CCS_BACKUP_PORT=22
#CCS_BASH_DIR=/opt/ccs-bash            # ccs-bash's checkout at its attested commit (the front's stage runner)
#CCS_DESIGN_DIR=/opt/ccs-front-hugo     # the design release, unpacked as its public/
#CCS_BACKUP_KEYS=/etc/ccs/backup       # id_ed25519 and known_hosts, the ccs user's, 600
#CCS_ALERT_CONF=/etc/ccs/alert.conf    # ccs-watch's, readable by ccs
