#!/bin/bash
# init: the web server compose's init service. Runs as root, once and after each upgrade.
# Writes into CCS_SSH_DIR (/etc/ccs-ssh/keys; on the host /etc/ccs-gate/ssh):
#   - sshd's host key, created the first time only (the backend's known_hosts has it);
#   - the passwd and group files both sshd read: the host's ccs-data and ccs-backup users by id
#     (CCS_DATA_UID, CCS_BACKUP_UID: uid:gid), and sshd's privilege separation user.
# Their shell is bash, since the forced command runs through it. Their home is /var/empty
# (root's, empty), not a folder they can write: bash, git and curl read config from home, and
# the live site used to be ccs-data's home.
set -euo pipefail
d=${CCS_SSH_DIR:-/etc/ccs-ssh/keys}
[[ ${CCS_DATA_UID:-} =~ ^[0-9]+:[0-9]+$ && ${CCS_BACKUP_UID:-} =~ ^[0-9]+:[0-9]+$ ]] \
    || { echo "init: CCS_DATA_UID and CCS_BACKUP_UID, uid:gid (id -u ccs-data, id -g ccs-data...)" >&2; exit 1; }
mkdir -p "$d"
data_u=${CCS_DATA_UID%:*} data_g=${CCS_DATA_UID#*:} backup_u=${CCS_BACKUP_UID%:*} backup_g=${CCS_BACKUP_UID#*:}
printf '%s\n' "root:x:0:0::/:/bin/false" "sshd:x:${CCS_SSHD_UID:-65533}:${CCS_SSHD_UID:-65533}::/var/empty:/bin/false" \
    "ccs-data:x:$data_u:$data_g::/var/empty:/bin/bash" "ccs-backup:x:$backup_u:$backup_g::/var/empty:/bin/bash" > "$d/passwd.new"
printf '%s\n' "root:x:0:" "sshd:x:${CCS_SSHD_UID:-65533}:" "ccs-data:x:$data_g:" "ccs-backup:x:$backup_g:" > "$d/group.new"
chmod 644 "$d/passwd.new" "$d/group.new" && mv -f "$d/passwd.new" "$d/passwd" && mv -f "$d/group.new" "$d/group"
# After passwd: ssh-keygen needs its own user in it
[[ -f $d/ssh_host_ed25519_key ]] || ssh-keygen -q -t ed25519 -N '' -C ccs-web -f "$d/ssh_host_ed25519_key"
chmod 600 "$d/ssh_host_ed25519_key" && chmod 644 "$d/ssh_host_ed25519_key.pub"
echo "init: $d ready; the host key, for the backend's known_hosts:"
cat "$d/ssh_host_ed25519_key.pub"
