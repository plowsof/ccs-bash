# .env for compose.yml (docs/docker.md, "The web server in Docker"): beside compose.yml, root's, 600.
# The gate's image by ID: as ccs-bash's release and ccs-sigs attest it (contrib/release/verify,
# then container/build.sh ccs-gate gate.Dockerfile, or docker load: the same ID).
CCS_GATE_IMAGE=sha256:<the attested ccs-gate image ID>
# the host's push and backup users (uid:gid): id -u ccs-data, id -g ccs-data, ...
CCS_DATA_UID=<ccs-data>
CCS_BACKUP_UID=<ccs-backup>
# the backup receiver (port 2224) runs only with the profile "backup": on the backup machine, its
# own (docs/docker.md). Both on one machine, a test setup only:
#COMPOSE_PROFILES=backup
# optional
#CCS_GATE_PORT=2223
#CCS_BACKUP_PORT=2224
#CCS_SSH_DIR=/etc/ccs-gate/ssh              # sshd's host key, passwd, group (init makes them; root's, 700)
#CCS_AUTHORIZED_KEYS=/etc/ssh/authorized_keys   # ccs-data's and ccs-backup's key files (root's)
#CCS_WEB_LOG=/var/log/ccs-web               # the gate's log, ccs-gate.log (ccs-data's, 755)
