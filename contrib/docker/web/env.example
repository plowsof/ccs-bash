# .env for compose.yml (docs/docker.md, "The web server in Docker"). Put it beside compose.yml,
# owned by root, 600.
# The gate's image by ID. It must match ccs-bash's release and ccs-sigs (contrib/release/verify,
# then container/build.sh ccs-gate gate.Dockerfile or docker load: same ID).
CCS_GATE_IMAGE=sha256:<the attested ccs-gate image ID>
# The host's push and backup users (uid:gid): id -u ccs-data, id -g ccs-data, ...
CCS_DATA_UID=<ccs-data>
CCS_BACKUP_UID=<ccs-backup>
# The site (www, tor): their users (uid:gid), the site's host name, its onion address (tor's
# hostname file), and the email Let's Encrypt may write to about the certificate
CCS_WWW_UID=<ccs-www>
CCS_TOR_UID=<ccs-tor>
CCS_SITE_HOST=ccs.getmonero.org
CCS_ONION=<56 characters>.onion
CCS_ACME_EMAIL=<an address>
# The backup receiver (port 2224) runs only with the "backup" profile, on its own backup machine
# (docs/docker.md). Both on one machine is for test setups only:
#COMPOSE_PROFILES=backup
# optional
#CCS_GATE_PORT=2223
#CCS_BACKUP_PORT=2224
#CCS_SSH_DIR=/etc/ccs-gate/ssh              # sshd's host key, passwd, group (made by init; root's, 700)
#CCS_AUTHORIZED_KEYS=/etc/ssh/authorized_keys   # ccs-data's and ccs-backup's key files (root's)
#CCS_WEB_LOG=/var/log/ccs-web               # the gate's log, ccs-gate.log (ccs-data's, 755)
#CCS_WWW_DIR=/var/lib/ccs-www               # data/ (certificates), onion/ (the socket), sites/; owned by ccs-www
#CCS_TOR_DIR=/var/lib/ccs-tor               # Tor's state and the onion's keys (ccs-tor's, 700)
