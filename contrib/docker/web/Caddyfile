# The site, served by the web server compose's www (docs/two-machines.md).
# Serves the files the gate let through (/srv, read-only) over HTTPS at CCS_SITE_HOST, with
# Caddy's own certificates (ACME, CCS_ACME_EMAIL), and to Tor through a socket only the two share.
# No admin API, and no server name in responses.
# Both give the same answers: security headers, cache rules, /projects, the theme's /dark/ and
# /light/ copies, and the 404 page.
{
	admin off
	email {$CCS_ACME_EMAIL}
	storage file_system /data
	# HTTP/1.1 only, headers capped, slow clients cut off (like nginx's defaults). A small static
	# site loses nothing, and Go's HTTP/2 server code is never reached. That code has most of its
	# known denial-of-service bugs (see govulncheck, the vulncheck workflow).
	servers {
		protocols h1
		max_header_size 16KB
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# Security headers on every answer, including the 404 page. No server name.
(ccs-headers) {
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), xr-spatial-tracking=()"
		X-XSS-Protection "0"
		Cache-Control {ccs_cache}
		-Server
	}
}

(ccs) {
	root * /srv
	# The page's path without /dark or /light, as the browser sent it. It stays percent-encoded
	# (a page with "(" in its name is requested as %28 and sent back that way). The theme button's
	# ?theme= redirects there. Never a path starting // or /\, which a browser reads as another site.
	map {http.request.orig_uri} {ccs_page} {
		~^/(?:dark|light)(?:\?|$) "/"
		~^/(?:dark|light)(/(?:[^/?\\][^?]*)?)(?:\?|$) "${1}"
		~^(/(?:[^/?\\][^?]*)?)(?:\?|$) "${1}"
		default "/"
	}
	map {http.request.orig_uri.path} {ccs_cache} {
		/projects "no-cache, must-revalidate"
		~\.[0-9a-f]{64}\.(css|png|avif|woff2)$ "public, max-age=31536000, immutable"
		/assets/general-fund-qr.png "public, max-age=86400"
		default "no-cache"
	}
	import ccs-headers
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/xml*
			header Content-Type application/xml*
			header Content-Type application/json*
		}
	}

	@light query theme=light
	@dark query theme=dark
	@system query theme=system
	redir @light /light{ccs_page} 302
	redir @dark /dark{ccs_page} 302
	redir @system {ccs_page} 302

	route {
		# No partial downloads: net/http's Range parsing (which had its own denial-of-service bug)
		# is never reached, and the site's files are small.
		request_header -Range
		rewrite /projects /projects.json
		rewrite /dark/assets/theme.css /assets/theme-dark.css
		rewrite /light/assets/theme.css /assets/theme-light.css
		uri /dark/* strip_prefix /dark
		uri /light/* strip_prefix /light
		file_server
	}

	# Nothing there, or a folder without its page: serve the 404 page, with the same headers
	handle_errors 403 404 {
		import ccs-headers
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

{$CCS_SITE_HOST} {
	import ccs
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Onion-Location "http://{$CCS_ONION}{uri}"
	}
}

# The onion: the compose's tor connects through this socket, in a volume only the two share
http:// {
	bind unix//run/ccs-www/onion.sock|0666
	import ccs
}

# This machine's other sites, if any (another host's ACME challenges, say): one file each
import /etc/ccs-www/sites/*.caddy
